<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💳 Paiement C-Pay"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1d4f92"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Montant -->
    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#12b6c7"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <!-- Référence -->
    <TextView
        android:id="@+id/tv_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#5a6677"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Séparateur -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#dce3ed"
        android:layout_marginBottom="16dp"/>

    <!-- Méthode de paiement -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Méthode de paiement *"
        android:textSize="13sp"
        android:textColor="#1e2d3d"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <Spinner
        android:id="@+id/spinner_method"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="16dp"/>

    <!-- Numéro téléphone -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Numéro Mobile Money *"
        android:textSize="13sp"
        android:textColor="#1e2d3d"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/et_phone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="+242060000001"
        android:inputType="phone"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="20dp"/>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- Bouton Payer -->
    <Button
        android:id="@+id/btn_pay"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="💳 Payer maintenant"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#12b6c7"
        android:layout_marginBottom="10dp"/>

    <!-- Bouton Annuler -->
    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Annuler"
        android:textColor="#5a6677"
        android:background="@android:color/transparent"/>

    <!-- Footer légal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sécurisé par Calculus Plus SAS · c-pay.global"
        android:textSize="10sp"
        android:textColor="#8a9ab0"
        android:gravity="center"
        android:layout_marginTop="8dp"/>
</LinearLayout>
