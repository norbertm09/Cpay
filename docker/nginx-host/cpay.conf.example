# ================================================================
# C-Pay — vhost du nginx HÔTE (reverse proxy de production), version de référence.
#   Serveur : /etc/nginx/sites-available/cpay (lien dans sites-enabled), posé par scripts/init-vps.sh s'il est absent.
#   Contexte http (zones, allowlist) : /etc/nginx/conf.d/cpay-zones.conf ; snippets : /etc/nginx/snippets/cpay-*.conf.
# Cibles (toutes sur 127.0.0.1, voir docker/docker-compose.yml) :
#   3001 routeur API (api-router -> api-blue | api-green)      3002 marchand  3003 porteur (app, card)
#   3004 admin  3005 partenaires (web-router -> <portail>-blue | -green)      vitrine servie en statique par l'hôte
# Validé en CI par nginx -t (certificats factices). Toute modification faite sur le serveur doit revenir ici.
# ================================================================

# ─── HTTP -> HTTPS, défi ACME ───────────────────────────────────
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name c-pay.global www.c-pay.global api.c-pay.global pay.c-pay.global admin.c-pay.global
              merchant.c-pay.global app.c-pay.global card.c-pay.global partners.c-pay.global;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

# ─── API : api.c-pay.global, pay.c-pay.global (pages de paiement hébergées) ───
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name api.c-pay.global pay.c-pay.global;
  include snippets/cpay-tls.conf;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'" always;

  limit_conn conn_limit 50;
  client_max_body_size 10m;

  # Jamais exposés publiquement : Prometheus et le cron de règlement passent par le réseau Docker (api:3000)
  location ^~ /internal/ { return 404; }
  location = /metrics    { return 404; }

  # Callbacks opérateurs : allowlist geo (snippets/cpay-webhook-allowlist.conf, inactive tant que « default 0 »),
  # pas de limitation par adresse (quelques IP opérateur partagées), délai long
  location ~ ^/(api/v1/webhooks|webhooks)/ {
    if ($cpay_webhook_denied) { return 403; }
    proxy_pass http://127.0.0.1:3001;
    include snippets/cpay-proxy.conf;
    proxy_read_timeout 60s;
  }

  # Connexions : limite stricte pour tous les acteurs
  location ~ ^/api/v1/(admin|merchant|cardholder|partners|bank|agency|agent)/auth {
    limit_req zone=api_auth burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:3001;
    include snippets/cpay-proxy.conf;
    proxy_read_timeout 30s;
  }

  # Paiements : Mobile Money peut répondre en 60 s
  location ~ ^/api/v1/(collect|payout|pay/|merchant/(collect|disburse|withdraw|transfer|cash/)|cardholder/(payment|topup|unload)) {
    limit_req zone=api_payment burst=10 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:3001;
    include snippets/cpay-proxy.conf;
    proxy_read_timeout 90s;
  }

  location / {
    limit_req zone=api_general burst=30 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:3001;
    include snippets/cpay-proxy.conf;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 60s;
  }
}

# ─── Vitrine : c-pay.global, www ─────────────────────────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name c-pay.global www.c-pay.global;
  include snippets/cpay-tls.conf;
  include snippets/cpay-security-landing.conf;

  root /opt/cplus/portal/landing;
  index index.html;
  gzip on; gzip_types text/css application/javascript application/json image/svg+xml text/plain;
  location /downloads/ { autoindex off; }
  location ~* \.(css|js|svg|png|woff2)$ { expires 7d; add_header Cache-Control "public"; include snippets/cpay-security-landing.conf; }
  location / { try_files $uri $uri/ $uri.html =404; }
  error_page 404 /404.html;
  # Variante : relayer vers le conteneur landing (127.0.0.1:3006) au lieu du dossier statique.
}

# ─── Portails SPA : un bloc par hôte, même modèle (snippet de sécurité + relais vers le routeur web) ───
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name merchant.c-pay.global;
  include snippets/cpay-tls.conf;
  include snippets/cpay-security-spa.conf;
  location / { proxy_pass http://127.0.0.1:3002; include snippets/cpay-proxy.conf; proxy_read_timeout 30s; }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name app.c-pay.global card.c-pay.global;
  include snippets/cpay-tls.conf;
  include snippets/cpay-security-spa.conf;
  location / { proxy_pass http://127.0.0.1:3003; include snippets/cpay-proxy.conf; proxy_read_timeout 30s; }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name admin.c-pay.global;
  include snippets/cpay-tls.conf;
  include snippets/cpay-security-spa.conf;
  # Back-office : restreindre aux adresses de l'équipe dès que le VPN est en place (allow/deny ou geo).
  location / { proxy_pass http://127.0.0.1:3004; include snippets/cpay-proxy.conf; proxy_read_timeout 30s; }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name partners.c-pay.global;
  include snippets/cpay-tls.conf;
  include snippets/cpay-security-spa.conf;
  location / { proxy_pass http://127.0.0.1:3005; include snippets/cpay-proxy.conf; proxy_read_timeout 30s; }
}
