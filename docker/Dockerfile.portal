# Lot 7 (audit 2026-11-02 infra P2-9) : Node 22 (Node 20 en fin de vie depuis le 30/04/2026)
FROM node:22-alpine AS builder
WORKDIR /app
ARG APP_DIR
ARG REACT_APP_API_BASE_URL=https://api.c-pay.global
# Vite (vite.config.js, envPrefix REACT_APP_) lit toujours REACT_APP_API_BASE_URL au build.
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL
# Sans effet avec Vite, conserve pour les scripts qui l'exportent encore.
ENV CI=false
# Tas Node borne pour les VPS modestes
ENV NODE_OPTIONS=--max-old-space-size=2048
COPY ${APP_DIR}/package*.json ./
RUN npm ci --no-audit --no-fund
COPY ${APP_DIR}/index.html ${APP_DIR}/vite.config.js ./
COPY ${APP_DIR}/public ./public
COPY ${APP_DIR}/src ./src
# Build Vite : sortie build/, pas de source map ni de <script> inline (CSP script-src 'self'),
# voir vite.config.js du portail.
RUN npm run build
# Lot 2 : l'origine de l'API entre dans la CSP (connect-src / form-action) — meme valeur que le bundle.
# Hotfix 2026-11-10 : la configuration nginx est preparee ICI (etape de build) ; l'image finale ne passe jamais en root.
COPY docker/nginx-spa.conf /tmp/nginx-spa.conf
RUN origin="$(printf '%s' "$REACT_APP_API_BASE_URL" | sed -E 's#^(https?://[^/]+).*#\1#')" \
 && sed "s#__API_ORIGIN__#${origin}#g" /tmp/nginx-spa.conf > /app/default.conf

# Lot 7 (infra P2-8/P2-9) : nginx NON privilegie (processus maitre sans root, ecoute 8080), version maintenue.
# Hotfix 2026-11-10 : AUCUN `USER root` ici. Un `nginx -t` lance en root au build creait /tmp/client_temp & co.
# en root:root ; au demarrage, l'utilisateur nginx ne pouvait plus les ouvrir -> conteneur en boucle de redemarrage
# (502 sur merchant/app/admin/partners). Tout est copie avec --chown et verifie en tant que nginx (uid 101).
FROM nginxinc/nginx-unprivileged:1.28-alpine
COPY --from=builder --chown=nginx:nginx /app/build /usr/share/nginx/html
COPY --from=builder --chown=nginx:nginx /app/default.conf /etc/nginx/conf.d/default.conf
RUN nginx -t
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s \
  CMD wget -qO- http://127.0.0.1:8080/ || exit 1
