{
  "name": "cpay-mobile",
  "version": "2.7.2",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build -p android",
    "build:ios": "eas build -p ios",
    "doctor": "npx expo-doctor",
    "check": "node -e \"const b=require('@babel/core');for(const f of ['App.js','src/core.js','src/auth-client.js']){b.transformFileSync(f,{presets:['babel-preset-expo'],filename:f,babelrc:false,configFile:false});console.log(f+' OK')}\"",
    "test": "node --test test/core.test.js test/auth-client.test.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.38",
    "expo-clipboard": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "babel-preset-expo": "~54.0.12"
  }
}
