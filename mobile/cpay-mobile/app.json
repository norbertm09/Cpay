{
  "expo": {
    "name": "C-Pay",
    "slug": "cpay-mobile",
    "version": "2.7.1",
    "orientation": "portrait",
    "scheme": "cpay",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "global.cpay.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "global.cpay.mobile",
      "versionCode": 271,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "apiBaseUrl": "https://api.c-pay.global"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    }
  }
}
