<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- WAVE-5 : theme Material 3 clair (pas de mode sombre). -->
    <style name="Theme.CPay" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>
        <item name="colorTertiary">@color/brand_cyan</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/cyan_container</item>
        <item name="colorOnTertiaryContainer">@color/on_cyan_container</item>
        <item name="colorError">@color/error_main</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/error_main</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface_dim</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="android:colorBackground">@color/surface_dim</item>
        <item name="android:windowBackground">@color/surface_dim</item>
        <item name="android:statusBarColor">@color/surface_dim</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CPay.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CPay.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CPay.Large</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.CPay.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.CPay.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.CPay.Large</item>

        <item name="materialButtonStyle">@style/Widget.CPay.Button</item>
        <item name="materialCardViewStyle">@style/Widget.CPay.Card</item>
        <item name="textInputStyle">@style/Widget.CPay.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.CPay.Chip</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.CPay.BottomSheet</item>
        <item name="bottomNavigationStyle">@style/Widget.CPay.BottomNavigation</item>
    </style>

    <style name="Theme.CPay.Splash" parent="Theme.CPay">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
    </style>
    <style name="Theme.CPay.NoActionBar" parent="Theme.CPay"/>

    <!-- ─── Formes (12 dp / 20 dp) ─────────────────────────────────── -->
    <style name="ShapeAppearance.CPay.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.CPay.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.CPay.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.CPay.Sheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ShapeAppearance.CPay.Circle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ─── Typographie ────────────────────────────────────────────── -->
    <style name="TextAppearance.CPay.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.CPay.Amount" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.CPay.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.CPay.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.CPay.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.CPay.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="TextAppearance.CPay.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="TextAppearance.CPay.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- ─── Boutons ────────────────────────────────────────────────── -->
    <style name="Widget.CPay.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CPay.Medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.CPay.Button.Primary" parent="Widget.CPay.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Widget.CPay.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CPay.Medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.CPay.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CPay.Medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.CPay.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
    </style>
    <style name="Widget.CPay.Button.Danger" parent="Widget.CPay.Button.Outlined">
        <item name="strokeColor">@color/error_main</item>
        <item name="android:textColor">@color/error_main</item>
        <item name="iconTint">@color/error_main</item>
    </style>
    <style name="Widget.CPay.Button.Key" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">60dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="iconTint">@color/on_surface</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CPay.Medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>
    <style name="Widget.CPay.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconTint">@color/on_surface_variant</item>
    </style>

    <!-- ─── Cartes, champs, puces ──────────────────────────────────── -->
    <style name="Widget.CPay.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPadding">0dp</item>
    </style>
    <style name="Widget.CPay.Card.Flat" parent="Widget.CPay.Card">
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surface_variant</item>
    </style>
    <style name="Widget.CPay.Card.Tile" parent="Widget.CPay.Card">
        <item name="cardCornerRadius">20dp</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>
    <style name="Widget.CPay.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="errorTextColor">@color/error_main</item>
    </style>
    <style name="Widget.CPay.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>
    <style name="Widget.CPay.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">14sp</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
    <style name="Widget.CPay.Chip.Amount" parent="Widget.CPay.Chip">
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">44dp</item>
    </style>
    <style name="Widget.CPay.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_color</item>
        <item name="itemTextColor">@color/nav_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CPay.BottomNavigation.Indicator</item>
        <item name="android:background">@color/surface</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
    </style>
    <style name="Widget.CPay.BottomNavigation.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_container</item>
    </style>

    <!-- ─── Feuilles inferieures ───────────────────────────────────── -->
    <style name="ThemeOverlay.CPay.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.CPay.BottomSheet</item>
    </style>
    <style name="Widget.CPay.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.CPay.Sheet</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:paddingTop">8dp</item>
    </style>
</resources>
