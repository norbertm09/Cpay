<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="16dp">
        <include android:id="@+id/header" layout="@layout/view_screen_header"/>
        <TextView android:id="@+id/tv_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CPay.Amount" android:textColor="@color/brand_navy" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/collect_card_subtitle"
            android:textAppearance="@style/TextAppearance.CPay.Secondary" android:gravity="center" android:layout_marginTop="6dp"/>

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
            <ImageView android:id="@+id/iv_qr" android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="center"
                android:background="@drawable/bg_qr_frame" android:padding="16dp" android:contentDescription="@string/cd_qr" android:visibility="invisible"/>
            <LinearLayout android:id="@+id/layout_loading" android:layout_width="match_parent" android:layout_height="280dp"
                android:orientation="vertical" android:gravity="center">
                <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/collect_card_creating"
                    android:textAppearance="@style/TextAppearance.CPay.Secondary" android:layout_marginTop="12dp"/>
            </LinearLayout>
        </FrameLayout>

        <TextView android:id="@+id/tv_url" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:textAppearance="@style/TextAppearance.CPay.Body" android:textColor="@color/brand_primary" android:textStyle="bold"
            android:fontFamily="monospace" android:layout_marginTop="16dp" android:textIsSelectable="true"/>
        <TextView android:id="@+id/tv_expiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:textAppearance="@style/TextAppearance.CPay.Secondary" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/tv_error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_error" android:padding="12dp" android:textColor="@color/error_main" android:textSize="13sp"
            android:layout_marginTop="12dp" android:visibility="gone"/>

        <LinearLayout android:id="@+id/layout_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_copy" style="@style/Widget.CPay.Button.Tonal"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/copy" app:icon="@drawable/ic_copy" app:iconGravity="textStart" android:layout_marginEnd="4dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_share" style="@style/Widget.CPay.Button.Tonal"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/share" app:icon="@drawable/ic_share" app:iconGravity="textStart" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_open" style="@style/Widget.CPay.Button.Tonal"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/open" app:icon="@drawable/ic_open_in_browser" app:iconGravity="textStart" android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/collect_card_follow"
            android:textAppearance="@style/TextAppearance.CPay.Secondary" android:gravity="center" android:layout_marginTop="16dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_done" style="@style/Widget.CPay.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/done" android:layout_marginTop="16dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
