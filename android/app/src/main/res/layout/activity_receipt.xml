<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:id="@+id/tv_back" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="← Retour"
            android:textColor="@color/primary" android:textSize="14sp"
            android:layout_marginTop="16dp" android:layout_marginBottom="20dp"
            android:clickable="true" android:focusable="true"/>

        <!-- Ticket -->
        <LinearLayout android:id="@+id/layout_ticket"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card"
            android:padding="24dp" android:layout_marginBottom="16dp">

            <!-- Header ticket -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginBottom="16dp">
                <ImageView android:layout_width="60dp" android:layout_height="60dp"
                    android:src="@mipmap/ic_launcher_round" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CALCULUS PLUS" android:textColor="@color/primary_dark"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Reçu de transaction" android:textColor="@color/text_secondary"
                    android:textSize="12sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Séparateur pointillé -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/border" android:layout_marginBottom="16dp"/>

            <!-- Statut -->
            <TextView android:id="@+id/tv_status_badge" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="✅ APPROUVÉ"
                android:textColor="#00c896" android:textSize="18sp" android:textStyle="bold"
                android:layout_gravity="center" android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tv_amount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 XAF"
                android:textColor="@color/primary_dark" android:textSize="32sp"
                android:textStyle="bold" android:layout_gravity="center"
                android:layout_marginBottom="20dp"/>

            <!-- Détails -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Référence"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_ref" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text"
                        android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Type"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_type" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Méthode"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_method" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Téléphone"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_phone" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Date"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_date" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Frais"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_fee" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Footer ticket -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/border" android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Merci de votre confiance\nc-pay.global"
                android:textColor="@color/text_secondary" android:textSize="11sp"
                android:gravity="center" android:layout_gravity="center"/>
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <TextView android:id="@+id/btn_print" android:layout_width="0dp"
                android:layout_height="52dp" android:layout_weight="1"
                android:text="🖨️ Imprimer" android:textColor="#FFFFFF"
                android:textSize="14sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn_sms" android:layout_width="0dp"
                android:layout_height="52dp" android:layout_weight="1"
                android:text="💬 Envoyer SMS" android:textColor="@color/primary"
                android:textSize="14sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_outline" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <TextView android:id="@+id/btn_share" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="📤 Partager le reçu"
            android:textColor="@color/text_secondary" android:textSize="14sp"
            android:background="@drawable/bg_card" android:gravity="center"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</ScrollView>
