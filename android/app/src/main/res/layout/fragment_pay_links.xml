<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Liens de paiement" android:textSize="20sp" android:textStyle="bold"
        android:textColor="@color/primary_dark" android:layout_marginBottom="12dp"/>
    <TextView android:id="@+id/btn_new_link" android:layout_width="match_parent"
        android:layout_height="46dp" android:text="+ Nouveau lien"
        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
        android:background="@drawable/bg_btn_primary" android:gravity="center"
        android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"/>
    <TextView android:id="@+id/tv_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Aucun lien de paiement"
        android:textColor="@color/text_secondary" android:textSize="14sp"
        android:gravity="center" android:padding="40dp" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pay_links" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
