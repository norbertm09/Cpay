<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:id="@+id/tv_welcome" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Bonjour 🏪"
            android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text"
            android:layout_marginBottom="16dp"/>

        <!-- KPI Cards -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/bg_balance_card" android:padding="16dp"
                android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Volume aujourd'hui" android:textColor="#B3FFFFFF" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_volume_today" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="— XAF"
                    android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_txns_today" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0 txns"
                    android:textColor="#B3FFFFFF" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/bg_card" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Volume ce mois" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                <TextView android:id="@+id/tv_volume_month" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="— XAF"
                    android:textColor="@color/primary_dark" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_txns_month" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0 txns"
                    android:textColor="@color/text_secondary" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Acces rapides -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <TextView android:id="@+id/btn_settlements" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="💰 Règlements" android:textColor="@color/primary"
                android:textSize="13sp" android:textStyle="bold"
                android:background="@drawable/bg_card" android:gravity="center"
                android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn_terminals" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="🖥️ Terminaux" android:textColor="@color/primary"
                android:textSize="13sp" android:textStyle="bold"
                android:background="@drawable/bg_card" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <TextView android:id="@+id/btn_transfers" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="💸 Retraits" android:textColor="@color/primary"
                android:textSize="13sp" android:textStyle="bold"
                android:background="@drawable/bg_card" android:gravity="center"
                android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn_pay_links" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="🔗 Liens" android:textColor="@color/primary"
                android:textSize="13sp" android:textStyle="bold"
                android:background="@drawable/bg_card" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Dernières transactions -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Dernières transactions"
                android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text"/>
            <TextView android:id="@+id/tv_see_all" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Voir tout"
                android:textColor="@color/primary" android:textSize="13sp"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_transactions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</ScrollView>
