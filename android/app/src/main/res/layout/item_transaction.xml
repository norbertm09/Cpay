<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="14dp"
    android:background="@drawable/bg_card" android:layout_marginBottom="6dp"
    android:gravity="center_vertical">

    <!-- Icône type -->
    <TextView android:id="@+id/tv_icon" android:layout_width="40dp"
        android:layout_height="40dp" android:textSize="22sp"
        android:gravity="center" android:layout_marginEnd="12dp"
        android:background="@drawable/bg_input" android:text="💳"/>

    <!-- Info -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_txn_type" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/text"/>
        <TextView android:id="@+id/tv_txn_method" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/tv_txn_date" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Montant + statut -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/tv_txn_amount" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textStyle="bold" android:textColor="@color/primary_dark"/>
        <TextView android:id="@+id/tv_txn_status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:layout_marginTop="3dp" android:paddingStart="6dp"
            android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
        <TextView android:id="@+id/tv_settlement" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="10sp"
            android:layout_marginTop="3dp" android:paddingStart="6dp"
            android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
