<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:id="@+id/tv_back" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="← Retour"
            android:textColor="@color/primary" android:textSize="14sp"
            android:layout_marginTop="16dp" android:layout_marginBottom="24dp"
            android:clickable="true" android:focusable="true"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_balance_card"
            android:padding="24dp" android:layout_marginBottom="28dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔐 Mot de passe oublié" android:textSize="22sp"
                android:textStyle="bold" android:textColor="#FFFFFF"/>
            <TextView android:id="@+id/tv_step_desc" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrez votre email pour recevoir un code"
                android:textColor="#CCF0F4F8" android:textSize="13sp" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Step 1: Email -->
        <LinearLayout android:id="@+id/layout_step_email"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email *" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_email" android:layout_width="match_parent"
                android:layout_height="52dp" android:inputType="textEmailAddress"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:hint="email@exemple.com" android:textColor="@color/text"
                android:textColorHint="@color/text_secondary" android:layout_marginBottom="20dp"/>
            <TextView android:id="@+id/btn_send_code" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="📧 Envoyer le code"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Step 2: Code -->
        <LinearLayout android:id="@+id/layout_step_code"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/tv_code_sent" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code envoyé à votre email"
                android:textColor="@color/text_secondary" android:textSize="13sp"
                android:layout_marginBottom="16dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Code reçu *" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_code" android:layout_width="match_parent"
                android:layout_height="60dp" android:inputType="numberDecimal"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:hint="123456" android:textColor="@color/text" android:textSize="24sp"
                android:gravity="center" android:textColorHint="@color/text_secondary"
                android:layout_marginBottom="20dp" android:maxLength="6"/>
            <TextView android:id="@+id/btn_verify_code" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Vérifier →"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Step 3: New Password -->
        <LinearLayout android:id="@+id/layout_step_password"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Nouveau mot de passe *" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_new_password" android:layout_width="match_parent"
                android:layout_height="52dp" android:inputType="textPassword"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:hint="Min 8 caractères" android:textColor="@color/text"
                android:textColorHint="@color/text_secondary" android:layout_marginBottom="12dp"/>
            <EditText android:id="@+id/et_confirm_password" android:layout_width="match_parent"
                android:layout_height="52dp" android:inputType="textPassword"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:hint="Confirmer le mot de passe" android:textColor="@color/text"
                android:textColorHint="@color/text_secondary" android:layout_marginBottom="20dp"/>
            <TextView android:id="@+id/btn_reset" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="🔐 Réinitialiser"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Error -->
        <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#CC0000"
            android:textSize="13sp" android:visibility="gone" android:layout_marginTop="12dp"
            android:gravity="center"/>

        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:visibility="gone" android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
