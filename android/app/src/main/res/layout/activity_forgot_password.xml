<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_dim" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/tv_back" style="@style/Widget.CPay.Button.Text"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/forgot_back_login" app:icon="@drawable/ic_back" android:layout_marginStart="-12dp"/>
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:padding="16dp" android:background="@drawable/bg_circle"
            android:src="@drawable/ic_lock" app:tint="@color/brand_primary" android:layout_marginTop="8dp" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/forgot_title"
            android:textAppearance="@style/TextAppearance.CPay.Title" android:layout_marginTop="16dp"/>
        <TextView android:id="@+id/tv_step_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/forgot_subtitle"
            android:textAppearance="@style/TextAppearance.CPay.Secondary" android:layout_marginTop="4dp" android:layout_marginBottom="20dp" android:lineSpacingExtra="3dp"/>

        <TextView android:id="@+id/tv_error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_error" android:padding="12dp" android:textColor="@color/error_main" android:textSize="13sp"
            android:layout_marginBottom="12dp" android:visibility="gone"/>
        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" android:layout_marginBottom="8dp"/>

        <!-- Etape 1 : e-mail -->
        <LinearLayout android:id="@+id/layout_step_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/forgot_email" app:startIconDrawable="@drawable/ic_mail" app:boxBackgroundColor="@color/surface">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_email" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" android:maxLines="1" android:minHeight="56dp" android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_send_code" style="@style/Widget.CPay.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/forgot_send" android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- Etape 2 : confirmation (le lien est envoye par e-mail) -->
        <LinearLayout android:id="@+id/layout_step_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/tv_code_sent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_success" android:padding="14dp" android:textAppearance="@style/TextAppearance.CPay.Body" android:textColor="@color/success_main" android:textStyle="bold"/>
            <EditText android:id="@+id/et_code" android:layout_width="match_parent" android:layout_height="56dp" android:visibility="gone" android:importantForAutofill="no" android:inputType="text"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_verify_code" style="@style/Widget.CPay.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/forgot_open_mail" app:icon="@drawable/ic_mail" app:iconGravity="textStart" android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- Etape 3 (non utilisee : le mot de passe est choisi sur la page web) -->
        <LinearLayout android:id="@+id/layout_step_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <EditText android:id="@+id/et_new_password" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textPassword" android:hint="@string/pwd_new" android:importantForAutofill="no"/>
            <EditText android:id="@+id/et_confirm_password" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textPassword" android:hint="@string/pwd_confirm" android:importantForAutofill="no"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset" style="@style/Widget.CPay.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/forgot_back_login" android:layout_marginTop="16dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
