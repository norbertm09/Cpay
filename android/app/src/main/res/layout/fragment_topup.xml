<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/bg_card"
            android:padding="4dp" android:layout_marginBottom="16dp">
            <TextView android:id="@+id/tab_topup" android:layout_width="0dp"
                android:layout_height="44dp" android:layout_weight="1"
                android:text="📥 Charger" android:textColor="@color/primary"
                android:textSize="14sp" android:textStyle="bold" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/tab_unload" android:layout_width="0dp"
                android:layout_height="44dp" android:layout_weight="1"
                android:text="📤 Décharger" android:textColor="@color/text_secondary"
                android:textSize="14sp" android:textStyle="bold" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_no_card" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune carte active. Créez une carte dans l'onglet Cartes."
            android:textColor="@color/text_secondary" android:textSize="14sp"
            android:gravity="center" android:padding="24dp" android:visibility="gone"
            android:background="@drawable/bg_card"/>

        <LinearLayout android:id="@+id/layout_topup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Carte à charger *" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spinner_card_topup" android:layout_width="match_parent"
                android:layout_height="52dp" android:background="@drawable/bg_spinner"
                android:popupBackground="#FFFFFF" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tv_balance_topup" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/accent"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Montant (XAF) *" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_topup_amount" android:layout_width="match_parent"
                android:layout_height="60dp" android:inputType="numberDecimal"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary"
                android:textColorHint="@color/text_secondary" android:hint="10 000"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Depuis (Mobile Money) *" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_topup_phone" android:layout_width="match_parent"
                android:layout_height="52dp" android:inputType="phone"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                android:hint="+242 06 000 00 01" android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Opérateur *" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/btn_topup_airtel" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1"
                    android:text="🔴 Airtel" android:textColor="@color/primary"
                    android:textSize="13sp" android:textStyle="bold"
                    android:background="@drawable/bg_card" android:gravity="center"
                    android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/btn_topup_mtn" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1"
                    android:text="🟡 MTN" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:textStyle="bold"
                    android:background="@drawable/bg_card" android:gravity="center"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Frais: 1%" android:textColor="@color/text_secondary"
                android:textSize="12sp" android:layout_marginBottom="16dp"/>

            <TextView android:id="@+id/tv_topup_error" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/danger"
                android:textSize="13sp" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <ProgressBar android:id="@+id/progress_topup" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:visibility="gone" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/btn_topup" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="📥 Charger la carte"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/layout_unload" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:visibility="gone">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Carte à décharger *" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spinner_card_unload" android:layout_width="match_parent"
                android:layout_height="52dp" android:background="@drawable/bg_spinner"
                android:popupBackground="#FFFFFF" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tv_balance_unload" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/accent"
                android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="14dp"/>

            <EditText android:id="@+id/et_unload_amount" android:layout_width="match_parent"
                android:layout_height="60dp" android:inputType="numberDecimal"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:textSize="24sp" android:textStyle="bold" android:textColor="@color/warning"
                android:textColorHint="@color/text_secondary" android:hint="Montant XAF"
                android:layout_marginBottom="12dp"/>

            <EditText android:id="@+id/et_unload_phone" android:layout_width="match_parent"
                android:layout_height="52dp" android:inputType="phone"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                android:hint="Vers numéro Mobile Money" android:layout_marginBottom="12dp"/>

            <EditText android:id="@+id/et_unload_pin" android:layout_width="match_parent"
                android:layout_height="52dp" android:inputType="numberPassword" android:maxLength="4"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                android:textSize="20sp" android:gravity="center"
                android:hint="PIN carte (4 chiffres)" android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/btn_unload_airtel" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1"
                    android:text="🔴 Airtel" android:textColor="@color/primary"
                    android:textSize="13sp" android:textStyle="bold"
                    android:background="@drawable/bg_card" android:gravity="center"
                    android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/btn_unload_mtn" android:layout_width="0dp"
                    android:layout_height="48dp" android:layout_weight="1"
                    android:text="🟡 MTN" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:textStyle="bold"
                    android:background="@drawable/bg_card" android:gravity="center"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Frais: 1.5%" android:textColor="@color/text_secondary"
                android:textSize="12sp" android:layout_marginBottom="16dp"/>

            <TextView android:id="@+id/tv_unload_error" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/danger"
                android:textSize="13sp" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <ProgressBar android:id="@+id/progress_unload" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:visibility="gone" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/btn_unload" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="📤 Décharger vers Mobile Money"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
