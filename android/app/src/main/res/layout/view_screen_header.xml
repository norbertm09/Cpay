<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back" style="@style/Widget.CPay.Button.Icon"
        android:layout_width="48dp" android:layout_height="48dp"
        app:icon="@drawable/ic_back" app:iconTint="@color/on_surface"
        android:contentDescription="@string/cd_back"/>
    <TextView android:id="@+id/tv_screen_title"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.CPay.Title" android:layout_marginStart="4dp"
        android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
