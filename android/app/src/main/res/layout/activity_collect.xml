<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_cyan"
        app:title="💳 Encaissement" app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_back"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Montant (XAF) *" android:textSize="13sp" android:textColor="@color/muted"
                android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_amount" android:layout_width="match_parent"
                android:layout_height="56dp" android:inputType="numberDecimal"
                android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary_cyan"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="5000" android:layout_marginBottom="20dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Numéro Mobile Money *" android:textSize="13sp" android:textColor="@color/muted"
                android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_phone" android:layout_width="match_parent"
                android:layout_height="48dp" android:inputType="phone"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="+242060000001" android:layout_marginBottom="20dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Opérateur *" android:textSize="13sp" android:textColor="@color/muted"
                android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">
                <RadioButton android:id="@+id/rb_airtel" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="🔴 Airtel Money" android:checked="true"/>
                <RadioButton android:id="@+id/rb_mtn" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="🟡 MTN MoMo"/>
            </LinearLayout>
            <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FF3B30"
                android:visibility="gone" android:layout_marginBottom="8dp"/>
            <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:visibility="gone" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btn_collect" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="💳 Encaisser maintenant"
                android:backgroundTint="@color/primary_cyan" android:textColor="#FFFFFF"
                android:textStyle="bold" android:textSize="16sp"/>
            <LinearLayout android:id="@+id/layout_result" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_success" android:padding="20dp"
                android:layout_marginTop="16dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅ Paiement effectué !" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="#00C896"/>
                <TextView android:id="@+id/tv_result_ref" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/muted"
                    android:textSize="13sp" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_result_amount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="22sp"
                    android:textStyle="bold" android:textColor="@color/primary_blue"
                    android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tv_result_status" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="#00C896" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
