<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="24dp">
        <include android:id="@+id/header" layout="@layout/view_screen_header"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/transfers_subtitle"
            android:textAppearance="@style/TextAppearance.CPay.Secondary"/>
        <TextView android:id="@+id/tv_available" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CPay.Subtitle" android:layout_marginTop="8dp"/>

        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggle_direction"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@+id/tab_to_bank">
            <com.google.android.material.button.MaterialButton android:id="@+id/tab_to_bank" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/transfers_to_bank"
                app:icon="@drawable/ic_bank" android:textAllCaps="false"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/tab_to_wallet" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/transfers_to_wallet"
                app:icon="@drawable/ic_wallet" android:textAllCaps="false"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Wallet → banque -->
        <LinearLayout android:id="@+id/layout_to_bank" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <TextView android:id="@+id/tv_no_account" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/transfers_no_account" android:background="@drawable/bg_banner_info" android:padding="12dp"
                android:textAppearance="@style/TextAppearance.CPay.Secondary" android:visibility="gone"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_account" style="@style/Widget.CPay.TextInputLayout.Dropdown"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/transfers_account">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/ac_account"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_manage_accounts" style="@style/Widget.CPay.Button.Text"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/transfers_manage_accounts"
                app:icon="@drawable/ic_bank"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_amount_bank" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="@string/transfers_amount" android:layout_marginTop="8dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_amount_bank" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="number" android:textSize="22sp" android:textStyle="bold" android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/transfers_description" android:layout_marginTop="10dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_desc_bank" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_transfer_bank" style="@style/Widget.CPay.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transfers_button_bank"
                app:icon="@drawable/ic_bank" app:iconGravity="textStart" android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- Banque → wallet -->
        <LinearLayout android:id="@+id/layout_to_wallet" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transfers_fund_hint"
                android:background="@drawable/bg_banner_info" android:padding="12dp" android:textAppearance="@style/TextAppearance.CPay.Secondary" android:lineSpacingExtra="3dp"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_amount_fund" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="@string/transfers_amount" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_amount_fund" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="number" android:textSize="22sp" android:textStyle="bold" android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/transfers_description" android:layout_marginTop="10dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_desc_fund" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLines="1"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_fund" style="@style/Widget.CPay.Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transfers_button_fund"
                app:icon="@drawable/ic_wallet" app:iconGravity="textStart" android:layout_marginTop="16dp"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_error" android:padding="12dp" android:textColor="@color/error_main" android:textSize="13sp"
            android:layout_marginTop="12dp" android:visibility="gone"/>
        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:visibility="gone" android:layout_marginTop="8dp"/>

        <!-- Liste -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/transfers_list"
                android:textAppearance="@style/TextAppearance.CPay.Subtitle"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_refresh_list" style="@style/Widget.CPay.Button.Icon"
                android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_refresh" android:contentDescription="@string/cd_refresh"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_transfers" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:overScrollMode="never"/>
                <TextView android:id="@+id/tv_no_transfers" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/transfers_empty" android:textAppearance="@style/TextAppearance.CPay.Secondary" android:padding="20dp"
                    android:gravity="center" android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
