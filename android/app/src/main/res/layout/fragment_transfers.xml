<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_balance_card"
            android:padding="18dp" android:layout_marginBottom="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏦 Transférer" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/transfers_subtitle" android:textColor="#CCF0F4F8" android:textSize="13sp"
                android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tv_available" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Disponible : —"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- Direction -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card" android:padding="4dp">
            <TextView android:id="@+id/tab_to_bank" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="@string/transfers_to_bank"
                android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold"
                android:gravity="center" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/tab_to_wallet" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="@string/transfers_to_wallet"
                android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold"
                android:gravity="center" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:visibility="gone" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#CC0000" android:textSize="13sp"
            android:visibility="gone" android:layout_marginBottom="8dp"/>

        <!-- Instructions d'approvisionnement -->
        <LinearLayout android:id="@+id/layout_instructions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_success_card" android:padding="16dp"
            android:layout_marginBottom="14dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/transfers_instructions" android:textSize="16sp" android:textStyle="bold"
                android:textColor="#007a5a" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tv_instr_amount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/primary_dark" android:layout_marginBottom="10dp"/>

            <LinearLayout android:id="@+id/row_bank" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Banque" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <TextView android:id="@+id/tv_instr_bank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_copy_bank" android:layout_width="36dp" android:layout_height="36dp" android:text="📋" android:gravity="center" android:background="@drawable/bg_btn_outline" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Titulaire" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <TextView android:id="@+id/tv_instr_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_copy_name" android:layout_width="36dp" android:layout_height="36dp" android:text="📋" android:gravity="center" android:background="@drawable/bg_btn_outline" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row_number" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Numéro de compte" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <TextView android:id="@+id/tv_instr_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_copy_number" android:layout_width="36dp" android:layout_height="36dp" android:text="📋" android:gravity="center" android:background="@drawable/bg_btn_outline" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row_iban" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IBAN" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <TextView android:id="@+id/tv_instr_iban" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_copy_iban" android:layout_width="36dp" android:layout_height="36dp" android:text="📋" android:gravity="center" android:background="@drawable/bg_btn_outline" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row_swift" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SWIFT / BIC" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <TextView android:id="@+id/tv_instr_swift" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_copy_swift" android:layout_width="36dp" android:layout_height="36dp" android:text="📋" android:gravity="center" android:background="@drawable/bg_btn_outline" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row_ref" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Référence à indiquer sur le virement" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                    <TextView android:id="@+id/tv_instr_ref" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/primary" android:textSize="18sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_copy_ref" android:layout_width="36dp" android:layout_height="36dp" android:text="📋" android:gravity="center" android:background="@drawable/bg_btn_outline" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <TextView android:id="@+id/tv_instr_expiry" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp"
                android:layout_marginBottom="10dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btn_copy_all" android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="@string/transfers_copy_all"
                    android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold"
                    android:background="@drawable/bg_btn_outline" android:gravity="center"
                    android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/btn_close_instr" android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:text="@string/close"
                    android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary" android:gravity="center"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Wallet -> Banque -->
        <LinearLayout android:id="@+id/layout_to_bank" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/transfers_account" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spinner_account" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/bg_spinner"
                android:popupBackground="#FFFFFF" android:layout_marginBottom="10dp"/>
            <TextView android:id="@+id/tv_no_account" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/transfers_no_account"
                android:textColor="#8a5a00" android:textSize="13sp" android:background="#FFF8E8"
                android:padding="12dp" android:layout_marginBottom="8dp" android:visibility="gone"/>
            <TextView android:id="@+id/btn_manage_accounts" android:layout_width="match_parent"
                android:layout_height="40dp" android:text="@string/transfers_manage_accounts"
                android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_outline" android:gravity="center"
                android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"/>
            <EditText android:id="@+id/et_amount_bank" android:layout_width="match_parent"
                android:layout_height="60dp" android:inputType="number" android:background="@drawable/bg_card"
                android:padding="14dp" android:textSize="24sp" android:textStyle="bold"
                android:textColor="@color/primary" android:textColorHint="@color/text_secondary"
                android:hint="@string/transfers_amount" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/et_desc_bank" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/bg_card" android:padding="12dp"
                android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                android:hint="@string/transfers_description" android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/btn_transfer_bank" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="@string/transfers_button_bank"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Banque -> Wallet -->
        <LinearLayout android:id="@+id/layout_to_wallet" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/transfers_fund_hint" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/et_amount_fund" android:layout_width="match_parent"
                android:layout_height="60dp" android:inputType="number" android:background="@drawable/bg_card"
                android:padding="14dp" android:textSize="24sp" android:textStyle="bold"
                android:textColor="@color/primary" android:textColorHint="@color/text_secondary"
                android:hint="@string/transfers_amount" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/et_desc_fund" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/bg_card" android:padding="12dp"
                android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                android:hint="@string/transfers_description" android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/btn_fund" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="@string/transfers_button_fund"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Liste -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="20dp" android:layout_marginBottom="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/transfers_list" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/text"/>
            <TextView android:id="@+id/btn_refresh_list" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="↻ Actualiser" android:textColor="@color/primary"
                android:textSize="13sp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_no_transfers" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/transfers_empty"
            android:textColor="@color/text_secondary" android:textSize="13sp" android:visibility="gone"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_transfers"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</ScrollView>
