<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="24dp">
        <include android:id="@+id/header" layout="@layout/view_screen_header"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/info_container" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/support_intro"
                    android:textAppearance="@style/TextAppearance.CPay.Body" android:lineSpacingExtra="3dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_email" style="@style/Widget.CPay.Button.Outlined"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/support_email"
                    app:icon="@drawable/ic_mail" app:iconGravity="textStart" android:layout_marginTop="12dp" android:textAllCaps="false"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_new_ticket" style="@style/Widget.CPay.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/support_new_ticket"
            app:icon="@drawable/ic_add" app:iconGravity="textStart" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/support_my_tickets"
            android:textAppearance="@style/TextAppearance.CPay.Subtitle" android:layout_marginTop="24dp"/>
        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="12dp" android:visibility="gone"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_tickets" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" android:overScrollMode="never"/>
                <TextView android:id="@+id/tv_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/support_empty"
                    android:textAppearance="@style/TextAppearance.CPay.Secondary" android:padding="20dp" android:gravity="center" android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
