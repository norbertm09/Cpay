<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="14dp"
    android:background="@drawable/bg_card" android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <TextView android:id="@+id/tv_icon" android:layout_width="42dp"
        android:layout_height="42dp" android:textSize="22sp" android:gravity="center"
        android:background="@drawable/bg_input" android:layout_marginEnd="12dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_number" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text"
                android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_default_badge" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="  ★ Défaut"
                android:textColor="@color/accent" android:textSize="11sp"
                android:textStyle="bold" android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_info" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
            android:textSize="11sp" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/btn_set_default" android:layout_width="wrap_content"
        android:layout_height="32dp" android:text="★" android:textSize="16sp"
        android:textColor="@color/primary" android:gravity="center"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:clickable="true" android:focusable="true"
        android:background="?android:selectableItemBackground"/>

    <TextView android:id="@+id/btn_remove" android:layout_width="wrap_content"
        android:layout_height="32dp" android:text="✕" android:textSize="16sp"
        android:textColor="@color/danger" android:gravity="center"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:clickable="true" android:focusable="true"
        android:background="?android:selectableItemBackground"/>
</LinearLayout>
