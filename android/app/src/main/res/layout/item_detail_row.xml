<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:gravity="center_vertical">
    <TextView android:id="@+id/tv_row_label" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CPay.Secondary"/>
    <TextView android:id="@+id/tv_row_value" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CPay.Body"
        android:textStyle="bold" android:gravity="end" android:maxWidth="220dp"
        android:textIsSelectable="true"/>
</LinearLayout>
