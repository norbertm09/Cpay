<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="24dp">
        <include android:id="@+id/header" layout="@layout/view_screen_header"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/withdraw_subtitle"
            android:textAppearance="@style/TextAppearance.CPay.Secondary"/>

        <!-- Solde -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_balance_card" android:padding="16dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/withdraw_available" android:textColor="#CCFFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/tv_available" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_daily_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#D9FFFFFF" android:textSize="13sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_feature" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/feature_disabled" android:background="@drawable/bg_banner_warn" android:padding="12dp"
            android:textColor="@color/warn_main" android:textSize="13sp" android:layout_marginTop="12dp" android:visibility="gone"/>

        <!-- Wallet -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/withdraw_wallet"
            android:textAppearance="@style/TextAppearance.CPay.Overline" android:layout_marginTop="20dp" android:layout_marginBottom="6dp"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="14dp">
                <TextView android:id="@+id/tv_wallet_initials" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_circle" android:gravity="center" android:textSize="13sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:id="@+id/tv_wallet_operator" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CPay.Body" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_wallet_phone" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CPay.Secondary"/>
                    <TextView android:id="@+id/tv_wallet_verified" android:layout_width="wrap_content" android:layout_height="22dp"
                        android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="11sp" android:textStyle="bold"
                        android:background="@drawable/bg_chip" android:layout_marginTop="4dp"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_edit_wallet" style="@style/Widget.CPay.Button.Text"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Formulaire wallet -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/layout_wallet_form" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" app:cardBackgroundColor="@color/info_container" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_operator" style="@style/Widget.CPay.TextInputLayout.Dropdown"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/withdraw_wallet_operator"
                    app:boxBackgroundColor="@color/surface">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/ac_operator"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_wallet_phone" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="@string/withdraw_wallet_phone" android:layout_marginTop="10dp"
                    app:boxBackgroundColor="@color/surface" app:startIconDrawable="@drawable/ic_phone">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_wallet_phone"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:id="@+id/tv_wallet_detect" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CPay.Secondary" android:layout_marginTop="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_cancel_wallet" style="@style/Widget.CPay.Button.Text"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/cancel"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_save_wallet" style="@style/Widget.CPay.Button"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/save"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Montant -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/withdraw_amount"
            android:textAppearance="@style/TextAppearance.CPay.Overline" android:layout_marginTop="20dp" android:layout_marginBottom="6dp"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_amount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/amount" app:helperTextEnabled="true">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_amount" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="number" android:textSize="24sp" android:textStyle="bold" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.chip.Chip android:id="@+id/chip_all" style="@style/Widget.CPay.Chip.Amount" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/withdraw_all" android:checkable="false" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/tv_fee_estimate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CPay.Secondary" android:layout_marginTop="6dp"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_description" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/withdraw_description" android:layout_marginTop="10dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_description" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:id="@+id/tv_error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_error" android:padding="12dp" android:textColor="@color/error_main" android:textSize="13sp"
            android:layout_marginTop="12dp" android:visibility="gone"/>
        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:visibility="gone" android:layout_marginTop="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_withdraw" style="@style/Widget.CPay.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/withdraw_button"
            app:icon="@drawable/ic_withdraw" app:iconGravity="textStart" android:layout_marginTop="16dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
