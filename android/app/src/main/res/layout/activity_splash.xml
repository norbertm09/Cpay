<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="@color/surface" android:padding="32dp">
    <ImageView android:layout_width="240dp" android:layout_height="wrap_content" android:adjustViewBounds="true"
        android:src="@drawable/logo_cpay" android:contentDescription="@string/cd_logo"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.CPay.Title" android:textColor="@color/brand_navy" android:letterSpacing="0.1" android:layout_marginTop="24dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/splash_tagline"
        android:textAppearance="@style/TextAppearance.CPay.Secondary" android:layout_marginTop="6dp" android:layout_marginBottom="48dp"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:indeterminate="true"/>
    <TextView android:id="@+id/tv_version" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.CPay.Secondary" android:textSize="11sp" android:layout_marginTop="48dp"/>
</LinearLayout>
