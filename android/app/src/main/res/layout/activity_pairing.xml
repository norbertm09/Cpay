<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_dim" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:padding="20dp" android:background="@drawable/bg_circle"
            android:src="@drawable/ic_terminal" app:tint="@color/brand_primary" android:layout_marginBottom="16dp" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pairing_title"
            android:textAppearance="@style/TextAppearance.CPay.Title" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/tv_merchant" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CPay.Subtitle" android:textColor="@color/brand_primary" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pairing_desc"
            android:textAppearance="@style/TextAppearance.CPay.Secondary" android:gravity="center" android:layout_marginBottom="28dp" android:lineSpacingExtra="3dp"/>
        <EditText android:id="@+id/et_code" android:layout_width="match_parent" android:layout_height="76dp" android:inputType="number" android:maxLength="6"
            android:gravity="center" android:textSize="36sp" android:textStyle="bold" android:letterSpacing="0.4" android:textColor="@color/brand_navy"
            android:textColorHint="@color/on_surface_disabled" android:hint="000000" android:background="@drawable/bg_card" android:layout_marginBottom="10dp"
            android:importantForAutofill="no" android:contentDescription="@string/pairing_code"/>
        <TextView android:id="@+id/tv_error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_error" android:padding="12dp" android:textColor="@color/error_main" android:textSize="13sp" android:gravity="center"
            android:visibility="gone" android:layout_marginBottom="10dp"/>
        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="10dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_pair" style="@style/Widget.CPay.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pairing_button" app:icon="@drawable/ic_link" app:iconGravity="textStart"
            android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_skip" style="@style/Widget.CPay.Button.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pairing_skip"/>
    </LinearLayout>
</ScrollView>
