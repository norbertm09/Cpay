<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
    <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" android:layout_marginBottom="20dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
            android:background="@drawable/bg_circle" android:src="@drawable/ic_shield"
            app:tint="@color/brand_primary" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/tv_stepup_title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CPay.Subtitle"/>
            <TextView android:id="@+id/tv_stepup_operation" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CPay.Secondary"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/tv_stepup_body" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CPay.Body"
        android:layout_marginTop="16dp" android:lineSpacingExtra="3dp"/>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_stepup"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        app:errorEnabled="true">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_stepup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:imeOptions="actionDone" android:maxLines="1"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_stepup_confirm"
        style="@style/Widget.CPay.Button.Primary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/stepup_confirm" android:layout_marginTop="4dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_stepup_cancel"
        style="@style/Widget.CPay.Button.Text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/cancel" android:layout_marginTop="4dp"/>
</LinearLayout>
