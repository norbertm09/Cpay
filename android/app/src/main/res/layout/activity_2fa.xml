<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_dim" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/tv_back" style="@style/Widget.CPay.Button.Text"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" app:icon="@drawable/ic_back" android:layout_marginStart="-12dp"/>
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:padding="16dp" android:background="@drawable/bg_circle"
            android:src="@drawable/ic_shield" app:tint="@color/brand_primary" android:layout_marginTop="8dp" android:contentDescription="@null"/>
        <TextView android:id="@+id/tv_2fa_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/twofa_title"
            android:textAppearance="@style/TextAppearance.CPay.Title" android:layout_marginTop="16dp"/>
        <TextView android:id="@+id/tv_2fa_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/twofa_subtitle"
            android:textAppearance="@style/TextAppearance.CPay.Secondary" android:layout_marginTop="4dp" android:layout_marginBottom="20dp"/>

        <TextView android:id="@+id/tv_2fa_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_info" android:padding="14dp" android:textAppearance="@style/TextAppearance.CPay.Body" android:textStyle="bold" android:layout_marginBottom="16dp"/>
        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" android:layout_marginBottom="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_setup_2fa" style="@style/Widget.CPay.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/twofa_setup_button" android:layout_marginBottom="16dp"/>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/layout_setup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="16dp" android:visibility="gone" android:gravity="center">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/twofa_setup_steps"
                    android:textAppearance="@style/TextAppearance.CPay.Body" android:layout_marginBottom="16dp" android:lineSpacingExtra="3dp"/>
                <ImageView android:id="@+id/iv_qr_2fa" android:layout_width="220dp" android:layout_height="220dp" android:background="@drawable/bg_qr_frame"
                    android:padding="10dp" android:layout_marginBottom="12dp" android:contentDescription="@string/cd_qr"/>
                <TextView android:id="@+id/tv_secret" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CPay.Secondary" android:fontFamily="monospace" android:textIsSelectable="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:id="@+id/layout_verify" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <TextView android:id="@+id/tv_verify_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/twofa_verify_label"
                    android:textAppearance="@style/TextAppearance.CPay.Label" android:layout_marginBottom="12dp"/>
                <EditText android:id="@+id/et_2fa_code" android:layout_width="match_parent" android:layout_height="68dp" android:inputType="number"
                    android:background="@drawable/bg_input" android:padding="12dp" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.35"
                    android:textColor="@color/brand_navy" android:gravity="center" android:textColorHint="@color/on_surface_disabled" android:hint="000000"
                    android:maxLength="6" android:layout_marginBottom="12dp" android:importantForAutofill="no"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_verify_2fa" style="@style/Widget.CPay.Button.Primary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/twofa_verify_button"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
