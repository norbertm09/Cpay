<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_balance_card"
            android:padding="18dp" android:layout_marginBottom="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📥 Encaisser" android:textSize="22sp"
                android:textStyle="bold" android:textColor="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/collect_subtitle"
                android:textColor="#CCF0F4F8" android:textSize="13sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Onglets -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card" android:padding="4dp">
            <TextView android:id="@+id/tab_momo" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="@string/collect_tab_momo"
                android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold"
                android:gravity="center" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/tab_card" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="@string/collect_tab_card"
                android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold"
                android:gravity="center" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/tab_nfc" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="@string/collect_tab_nfc"
                android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold"
                android:gravity="center" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Resultat (succes / attente / echec) -->
        <LinearLayout android:id="@+id/layout_result"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_success_card"
            android:padding="20dp" android:layout_marginBottom="16dp"
            android:gravity="center" android:visibility="gone">
            <TextView android:id="@+id/tv_result_icon" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="✅" android:textSize="48sp"
                android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tv_result_title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/collect_success"
                android:textSize="18sp" android:textStyle="bold" android:textColor="#007a5a"/>
            <TextView android:id="@+id/tv_result_amount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="24sp"
                android:textStyle="bold" android:textColor="@color/primary_dark" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tv_result_ref" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                android:textSize="12sp" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tv_result_msg" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:gravity="center" android:layout_marginTop="8dp"
                android:visibility="gone"/>
            <TextView android:id="@+id/btn_receipt" android:layout_width="match_parent"
                android:layout_height="44dp" android:text="@string/collect_receipt"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:layout_marginTop="16dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/btn_new_collect" android:layout_width="match_parent"
                android:layout_height="44dp" android:text="@string/collect_new"
                android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_outline" android:gravity="center"
                android:layout_marginTop="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- ── Mobile Money ── -->
        <LinearLayout android:id="@+id/layout_momo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/collect_amount" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <TextView android:id="@+id/tv_amount_display" android:layout_width="match_parent"
                android:layout_height="64dp" android:background="@drawable/bg_card"
                android:gravity="center_vertical|end" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:text="0 XAF" android:textSize="30sp" android:textStyle="bold"
                android:textColor="@color/primary" android:layout_marginBottom="8dp"/>

            <!-- Clavier montant -->
            <LinearLayout android:id="@+id/layout_keypad" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/key_1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="1" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/key_2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="2" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/key_3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="3" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/key_4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="4" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/key_5" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="5" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/key_6" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="6" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/key_7" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="7" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/key_8" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="8" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/key_9" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="9" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/key_000" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="000" android:textSize="18sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/key_0" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="0" android:textSize="22sp" android:textColor="@color/text" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/key_del" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="⌫" android:textSize="22sp" android:textColor="@color/danger" android:gravity="center" android:background="@drawable/bg_card" android:layout_margin="3dp" android:clickable="true" android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/collect_phone" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_phone" android:layout_width="match_parent"
                android:layout_height="52dp" android:inputType="phone"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:textColor="@color/text" android:textColorHint="@color/text_secondary"
                android:hint="+237 6 70 00 00 00" android:layout_marginBottom="8dp"/>

            <!-- Detection operateur -->
            <LinearLayout android:id="@+id/layout_detection" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:layout_marginBottom="12dp" android:visibility="gone">
                <TextView android:id="@+id/tv_detect_main" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_detect_sub" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                    android:textSize="12sp" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/tv_alternatives_label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/collect_alternatives"
                    android:textColor="@color/text_secondary" android:textSize="12sp"
                    android:layout_marginTop="8dp" android:visibility="gone"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout android:id="@+id/layout_alternatives" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:layout_marginTop="6dp"/>
                </HorizontalScrollView>
            </LinearLayout>

            <EditText android:id="@+id/et_description" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/bg_card"
                android:padding="12dp" android:textColor="@color/text"
                android:textColorHint="@color/text_secondary" android:hint="@string/collect_description"
                android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/et_reference" android:layout_width="match_parent"
                android:layout_height="44dp" android:background="@drawable/bg_card"
                android:padding="12dp" android:textColor="@color/text_secondary" android:textSize="13sp"
                android:focusable="false" android:clickable="false" android:hint="@string/collect_reference"
                android:layout_marginBottom="12dp"/>

            <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#CC0000"
                android:textSize="13sp" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:visibility="gone" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/btn_collect" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="@string/collect_button"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- ── Carte (lien de paiement + QR) ── -->
        <LinearLayout android:id="@+id/layout_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/collect_card_hint" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/et_amount_card" android:layout_width="match_parent"
                android:layout_height="60dp" android:inputType="number"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary"
                android:textColorHint="@color/text_secondary" android:hint="Montant"
                android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/et_description_card" android:layout_width="match_parent"
                android:layout_height="48dp" android:background="@drawable/bg_card"
                android:padding="12dp" android:textColor="@color/text"
                android:textColorHint="@color/text_secondary" android:hint="@string/collect_description"
                android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/tv_card_error" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#CC0000"
                android:textSize="13sp" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <ProgressBar android:id="@+id/progress_card" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:visibility="gone" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/btn_gen_card" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="@string/collect_card_button"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
            <LinearLayout android:id="@+id/layout_card_result" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone" android:gravity="center" android:layout_marginTop="16dp"
                android:background="@drawable/bg_card" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📱 Présentez ce QR au client ou envoyez-lui le lien"
                    android:textColor="@color/text_secondary" android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>
                <ImageView android:id="@+id/iv_qr_code" android:layout_width="220dp"
                    android:layout_height="220dp" android:scaleType="fitCenter"
                    android:contentDescription="QR code"/>
                <TextView android:id="@+id/tv_card_amount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="@color/primary_dark" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_card_url" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp" android:gravity="center"
                    android:textColor="@color/primary_dark" android:layout_marginTop="6dp"/>
                <TextView android:id="@+id/tv_card_expiry" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="4dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <TextView android:id="@+id/btn_copy_link" android:layout_width="0dp"
                        android:layout_height="44dp" android:layout_weight="1" android:text="@string/collect_copy"
                        android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold"
                        android:background="@drawable/bg_btn_outline" android:gravity="center"
                        android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/btn_open_link" android:layout_width="0dp"
                        android:layout_height="44dp" android:layout_weight="1" android:text="@string/collect_open"
                        android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold"
                        android:background="@drawable/bg_btn_outline" android:gravity="center"
                        android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/btn_share_link" android:layout_width="0dp"
                        android:layout_height="44dp" android:layout_weight="1" android:text="@string/collect_share"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                        android:background="@drawable/bg_btn_primary" android:gravity="center"
                        android:clickable="true" android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── NFC (sans contact, desactive cote backend) ── -->
        <LinearLayout android:id="@+id/layout_nfc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" android:gravity="center">
            <EditText android:id="@+id/et_amount_nfc" android:layout_width="match_parent"
                android:layout_height="60dp" android:inputType="number"
                android:background="@drawable/bg_card" android:padding="14dp"
                android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary"
                android:textColorHint="@color/text_secondary" android:hint="Montant"
                android:layout_marginBottom="16dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📡" android:textSize="80sp" android:layout_marginBottom="16dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/collect_nfc_hint" android:textColor="@color/text"
                android:textSize="15sp" android:gravity="center" android:layout_marginBottom="20dp"/>
            <TextView android:id="@+id/btn_nfc_collect" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="@string/collect_nfc_button"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:gravity="center"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
