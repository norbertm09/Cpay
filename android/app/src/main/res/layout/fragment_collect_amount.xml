<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/collect_title" android:textAppearance="@style/TextAppearance.CPay.Title"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/collect_amount_hint" android:textAppearance="@style/TextAppearance.CPay.Secondary"/>

    <!-- Montant -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center" android:minHeight="96dp">
        <TextView android:id="@+id/tv_amount_display" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CPay.Display" android:textSize="44sp" android:textColor="@color/brand_navy"
            android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="28sp" app:autoSizeMaxTextSize="44sp"/>
        <TextView android:id="@+id/tv_currency" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CPay.Label" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/tv_error" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/error_main" android:textSize="13sp" android:layout_marginTop="6dp" android:visibility="gone"/>
    </LinearLayout>

    <!-- Montants rapides -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:layout_marginBottom="8dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chips_quick" android:layout_width="wrap_content"
            android:layout_height="wrap_content" app:singleLine="true" app:chipSpacingHorizontal="8dp" app:singleSelection="false"/>
    </HorizontalScrollView>

    <!-- Clavier -->
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:columnCount="3" android:rowCount="4" android:background="@color/keypad_bg">
        <com.google.android.material.button.MaterialButton android:id="@+id/key1" style="@style/Widget.CPay.Button.Key" android:text="1" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key2" style="@style/Widget.CPay.Button.Key" android:text="2" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key3" style="@style/Widget.CPay.Button.Key" android:text="3" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key4" style="@style/Widget.CPay.Button.Key" android:text="4" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key5" style="@style/Widget.CPay.Button.Key" android:text="5" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key6" style="@style/Widget.CPay.Button.Key" android:text="6" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key7" style="@style/Widget.CPay.Button.Key" android:text="7" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key8" style="@style/Widget.CPay.Button.Key" android:text="8" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key9" style="@style/Widget.CPay.Button.Key" android:text="9" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key000" style="@style/Widget.CPay.Button.Key" android:text="000" android:textSize="20sp" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key0" style="@style/Widget.CPay.Button.Key" android:text="0" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/key_del" style="@style/Widget.CPay.Button.Key" app:icon="@drawable/ic_backspace"
            android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:contentDescription="@string/cd_backspace"/>
    </GridLayout>

    <!-- Methodes -->
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_momo" style="@style/Widget.CPay.Button.Primary"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/collect_momo_button" app:icon="@drawable/ic_phone" app:iconGravity="textStart"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_card" style="@style/Widget.CPay.Button.Tonal"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp"
            android:text="@string/collect_card_button" app:icon="@drawable/ic_qr" app:iconGravity="textStart" android:textSize="13sp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_nfc" style="@style/Widget.CPay.Button.Tonal"
            android:layout_width="0dp" android:layout_weight="0.7" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:text="@string/collect_nfc_button" app:icon="@drawable/ic_nfc" app:iconGravity="textStart" android:textSize="13sp"
            android:alpha="0.75"/>
    </LinearLayout>
</LinearLayout>
