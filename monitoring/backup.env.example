# /etc/cplus/backup.env — sauvegardes PostgreSQL C-Pay (lot 3). Fichier root 0600. Jamais dans backend/.env.
# Destination hors serveur (remote rclone configuré avec `rclone config`, ex. Object Storage OVH S3 ou SFTP) :
BACKUP_REMOTE=ovh-s3:cpay-backups
# Chiffrement (OBLIGATOIRE dès qu'une copie quitte le serveur) — au choix :
#   1) age : clé publique ops (la clé PRIVÉE reste hors du serveur ; pour restore-test.sh sur le serveur de dev,
#      renseigner BACKUP_AGE_IDENTITY_FILE avec la clé privée protégée 0400)
BACKUP_AGE_RECIPIENT=age1...........................................................
# BACKUP_AGE_IDENTITY_FILE=/etc/cplus/backup-age.key
#   2) ou openssl AES-256 avec passphrase dans un fichier 0400 :
# BACKUP_PASSPHRASE_FILE=/etc/cplus/backup.passphrase
BACKUP_RETENTION_DAYS=30
# En production la copie distante est exigée (échec sinon) ; mettre false sur un serveur de dev sans remote.
BACKUP_REMOTE_REQUIRED=true
# Battement de cœur (healthchecks.io ou équivalent) : pingé en fin de sauvegarde, <url>/fail en échec.
# OPS_HEARTBEAT_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Test de restauration mensuel (serveur de dev) : base dédiée, jamais la base applicative.
# RESTORE_TEST_DB=cplus_restore_test
# OPS_RESTORE_HEARTBEAT_URL=https://hc-ping.com/yyyyyyyy-...
# Alertmanager local (défaut) et répertoire des métriques textfile (défaut)
# OPS_ALERTMANAGER_URL=http://127.0.0.1:9093
# OPS_TEXTFILE_DIR=/var/lib/node_exporter/textfile
