# Variables de supervision uniquement. Ne pas charger backend/.env.
ALERT_SMTP_HOST=REQUIRED_STARTTLS_HOST
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=REQUIRED_SMTP_USER
ALERT_SMTP_FROM=alerts@example.test
ALERT_SMTP_TO=ops@example.test
ALERT_SMTP_PASSWORD_FILE=REQUIRED_PRIVATE_PASSWORD_FILE
MONITORING_METRICS_TOKEN_FILE=REQUIRED_PRIVATE_METRICS_FILE
# Optionnel : CA privée (certificat PEM), jamais insecure_skip_verify.
# ALERT_SMTP_CA_FILE=/private/monitoring-ca.crt
