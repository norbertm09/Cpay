# Variables de supervision uniquement. Ne pas charger backend/.env.
ALERT_SMTP_HOST=REQUIRED_STARTTLS_HOST
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=REQUIRED_SMTP_USER
ALERT_SMTP_FROM=alerts@example.test
ALERT_SMTP_TO=ops@example.test
ALERT_SMTP_PASSWORD_FILE=REQUIRED_PRIVATE_PASSWORD_FILE
MONITORING_METRICS_TOKEN_FILE=REQUIRED_PRIVATE_METRICS_FILE
# Grafana (lot hygiene 2026-11) : fichier prive du mot de passe admin, cree par setup-monitoring.sh depuis
# GRAFANA_PASSWORD de backend/.env (ne rien saisir ici).
# Optionnel : CA privée (certificat PEM), jamais insecure_skip_verify.
# ALERT_SMTP_CA_FILE=/private/monitoring-ca.crt
# Exporter PostgreSQL : role dedie en lecture seule (pg_monitor, aucun acces aux tables applicatives), cree et
# renseigne ici par `sudo bash scripts/create-monitoring-role.sh` ; sans ces deux lignes l'exporter utilise DB_USER.
# PG_EXPORTER_USER=cplus_monitor
# PG_EXPORTER_PASSWORD=
