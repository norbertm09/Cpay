const useLang = () => {
  const [lang, setLang] = useState(localStorage.getItem('ch_lang') || 'fr');
  const toggle = () => { const n = lang === 'fr' ? 'en' : 'fr'; localStorage.setItem('ch_lang', n); setLang(n); };
  return { lang, toggle };
};

// ─── Styles ───────────────────────────────────────────────────────
const P = '#12b6c7', BG = '#f0f4f8', CARD = '#fff', BORDER = '#dce3ed', TEXT = '#1e2d3d', MUTED = '#5a6677';
const FONT = "'Century Gothic','CenturyGothic','AppleGothic','Gill Sans MT',Tahoma,Arial,sans-serif";
const DANGER = '#ff3b30', SUCCESS = '#00c896', WARNING = '#ff9500', BLUE = '#1d4f92';
const sc = s => ({ active:SUCCESS, frozen:WARNING, cancelled:DANGER, completed:SUCCESS, failed:DANGER, pending:WARNING, payment:DANGER, topup:SUCCESS, unload:WARNING, fee:MUTED }[s] || MUTED);

// ─── Composants ───────────────────────────────────────────────────
const Box = ({ children, style }) => <div style={{ background:CARD, border:`1px solid ${BORDER}`, borderRadius:14, padding:20, marginBottom:14, fontFamily:FONT, ...style }}>{children}</div>;
const Badge = ({ label, color=MUTED }) => <span style={{ display:'inline-block', padding:'2px 10px', borderRadius:20, fontSize:11, fontWeight:700, background:`${color}22`, color }}>{label}</span>;
const Spin  = () => <div style={{ textAlign:'center', padding:40, color:MUTED }}>⏳</div>;
const Btn   = ({ children, onClick, color=P, outline, small, disabled, style:s }) => (
  <button onClick={onClick} disabled={disabled} style={{ background:outline?'transparent':color, color:outline?color:'#fff', border:`2px solid ${color}`, borderRadius:10, padding:small?'6px 14px':'11px 20px', fontSize:small?12:14, fontWeight:700, cursor:disabled?'not-allowed':'pointer', opacity:disabled?0.55:1, fontFamily:FONT, ...s }}>{children}</button>
);
const Inp   = ({ label, value, onChange, type='text', placeholder, maxLength, pattern }) => (
  <div style={{ marginBottom:14 }}>
    {label && <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{label}</label>}
    <input type={type} value={value||''} onChange={e=>onChange(e.target.value)} placeholder={placeholder} maxLength={maxLength} pattern={pattern}
      style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', color:TEXT, fontSize:14, boxSizing:'border-box', fontFamily:FONT, outline:'none' }} />
  </div>
);
const Sel   = ({ label, value, onChange, options }) => (
  <div style={{ marginBottom:14 }}>
    {label && <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{label}</label>}
    <select value={value} onChange={e=>onChange(e.target.value)} style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', color:TEXT, fontSize:14, boxSizing:'border-box', fontFamily:FONT }}>
      {options.map(o => <option key={o.v} value={o.v}>{o.l}</option>)}
    </select>
  </div>
);
const Modal = ({ title, onClose, children }) => (
  <div style={{ position:'fixed', inset:0, background:'rgba(0,0,0,0.45)', display:'flex', alignItems:'center', justifyContent:'center', zIndex:1000 }}>
    <Box style={{ width:440, maxHeight:'90vh', overflowY:'auto', margin:0 }}>
      <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:18 }}>
        <span style={{ fontSize:17, fontWeight:700, fontFamily:FONT }}>{title}</span>
        <button onClick={onClose} style={{ background:'none', border:'none', fontSize:22, cursor:'pointer', color:MUTED }}>✕</button>
      </div>
      {children}
    </Box>
  </div>
);
const PinInput = ({ value, onChange, placeholder }) => (
  <input type="password" inputMode="numeric" maxLength={4} value={value} onChange={e=>onChange(e.target.value.replace(/\D/g,'').slice(0,4))} placeholder={placeholder||'••••'}
    style={{ width:'100%', background:BG, border:`2px solid ${BORDER}`, borderRadius:8, padding:'12px', fontSize:22, letterSpacing:8, textAlign:'center', color:TEXT, fontFamily:'monospace', boxSizing:'border-box' }} />
);
const fmtDate = (d, lang) => d ? new Date(d).toLocaleString(lang==='fr'?'fr-FR':'en-US') : '—';
const fmtNum  = n => parseFloat(n||0).toLocaleString('fr-FR');

const OPERATORS = [
  { v:'mtn',    l:'MTN Mobile Money (Congo)', prefix:'242', regex:/^242(06|07|05)/ },
  { v:'airtel', l:'Airtel Money (Congo)',     prefix:'242', regex:/^242(07|04)/ },
  { v:'orange', l:'Orange Money',             prefix:'242', regex:/^242/ },
  { v:'vodacom',l:'Vodacom M-Pesa',           prefix:'243', regex:/^243/ },
];
const getOperatorForPhone = (phone) => {
  const clean = phone.replace(/\D/g,'');
  if (/^(06|07|05)/.test(clean.slice(3)) && clean.startsWith('242')) return 'mtn';
  if (/^(04)/.test(clean.slice(3)) && clean.startsWith('242')) return 'airtel';
  return null;
};

// ─── LAYOUT ───────────────────────────────────────────────────────
const Layout = ({ children, lang, toggleLang }) => {
  const { user } = useAuth();
  const navigate = useNavigate();
  const { pathname } = window.location;
  const nav = [
    { path:'/', icon:'💳', key:'dashboard' },
    { path:'/payment', icon:'💸', key:'payment' },
    { path:'/topup', icon:'⬆️', key:'topup' },
    { path:'/unload', icon:'⬇️', key:'unload' },
    { path:'/transactions', icon:'📋', key:'transactions' },
    { path:'/mes-cartes', icon:'💳', key:'mesCartes' },
    { path:'/profile', icon:'👤', key:'profile' },
  ];
  const t = k => T[lang][k] || k;
  return (
    <div style={{ display:'flex', minHeight:'100vh', background:BG, fontFamily:FONT }}>
      {/* Sidebar */}
      <aside style={{ width:220, background:CARD, borderRight:`1px solid ${BORDER}`, display:'flex', flexDirection:'column', position:'fixed', top:0, bottom:0, left:0, zIndex:100 }}>
        <div style={{ padding:'16px 16px 12px', borderBottom:`1px solid ${BORDER}` }}>
          <img src="/logo-calculus.png" alt="Calculus Plus" style={{ width:'100%', maxWidth:175, height:'auto', objectFit:'contain' }} />
          <div style={{ fontSize:10, color:MUTED, marginTop:4, fontFamily:FONT }}>Espace Cardholder</div>
        </div>
        <nav style={{ flex:1, padding:'10px 0', overflowY:'auto' }}>
          {nav.map(n => (
            <Link key={n.path} to={n.path} style={{ display:'flex', alignItems:'center', gap:10, padding:'11px 18px', color:pathname===n.path?P:MUTED, textDecoration:'none', fontSize:13, fontWeight:pathname===n.path?700:400, background:pathname===n.path?`${P}12`:'transparent', borderLeft:`3px solid ${pathname===n.path?P:'transparent'}` }}>
              <span>{n.icon}</span><span>{t(n.key)}</span>
            </Link>
          ))}
        </nav>
        <div style={{ padding:'12px 16px', borderTop:`1px solid ${BORDER}` }}>
          <button onClick={toggleLang} style={{ background:'none', border:`1px solid ${BORDER}`, color:TEXT, padding:'6px 10px', borderRadius:6, cursor:'pointer', fontSize:12, marginBottom:8, width:'100%', fontFamily:FONT }}>🌐 {t('language')}</button>
          <button onClick={() => { localStorage.removeItem('ch_token'); navigate('/login'); }} style={{ background:'none', border:`1px solid ${BORDER}`, color:MUTED, padding:'6px 10px', borderRadius:6, cursor:'pointer', fontSize:12, width:'100%', fontFamily:FONT }}>{t('logout')}</button>
        </div>
      </aside>
      <main style={{ marginLeft:220, flex:1, padding:28 }}>{children}</main>
    </div>
  );
};


// ─── REGISTER CARDHOLDER ─────────────────────────────────────────
const RegisterCardholder = ({ lang, toggleLang }) => {
  const t = k => T[lang][k] || k;
  const navigate = useNavigate();
  const { isAuth } = useAuth();
  useEffect(() => { if (isAuth) navigate('/'); }, [isAuth, navigate]);

  const [form, setForm] = useState({ firstName:'', lastName:'', phone:'', email:'', dob:'', idType:'national_id', idNumber:'', country:'CM', password:'', confirmPassword:'' });
  const [errors, setErrors] = useState({});
  const [loading, setLoading] = useState(false);
  const [step, setStep] = useState(1); // 1=identité, 2=sécurité
  const f = k => v => { setForm(p=>({...p,[k]:v})); if (errors[k]) setErrors(e=>({...e,[k]:''})); };

  const CEMAC = [
    { v:'CM', l:'🇨🇲 Cameroun' }, { v:'CG', l:'🇨🇬 Congo' }, { v:'GA', l:'🇬🇦 Gabon' },
    { v:'CF', l:'🇨🇫 RCA' }, { v:'TD', l:'🇹🇩 Tchad' }, { v:'GQ', l:'🇬🇶 Guinée Éq.' },
  ];

  const pwdOk = p => p.length >= 8 && /[A-Z]/.test(p) && /[a-z]/.test(p) && /[0-9]/.test(p);
  const pwdStrength = p => {
    let s = 0;
    if (p.length >= 8) s++; if (/[A-Z]/.test(p)) s++; if (/[a-z]/.test(p)) s++;
    if (/[0-9]/.test(p)) s++; if (/[^A-Za-z0-9]/.test(p)) s++;
    return s;
  };
  const strengthColors = ['','#ff3b30','#ff3b30','#ff9500','#ff9500','#00c896'];

  const validateStep1 = () => {
    const e = {};
    if (!form.firstName.trim()) e.firstName = lang==='fr'?'Requis':'Required';
    if (!form.lastName.trim())  e.lastName  = lang==='fr'?'Requis':'Required';
    if (!form.phone.trim())     e.phone     = lang==='fr'?'Requis':'Required';
    if (!form.email.trim())     e.email     = lang==='fr'?'Requis':'Required';
    setErrors(e);
    return Object.keys(e).length === 0;
  };

  const validateStep2 = () => {
    const e = {};
    if (!pwdOk(form.password)) e.password = t('regErrorWeak');
    if (form.password !== form.confirmPassword) e.confirmPassword = t('regErrorPwd');
    setErrors(e);
    return Object.keys(e).length === 0;
  };

  const submit = async () => {
    if (!validateStep2()) return;
    setLoading(true);
    try {
      // Créer le compte cardholder via l'API
      const payload = {
        firstName: form.firstName.trim(), lastName: form.lastName.trim(),
        phone: form.phone.trim(), email: form.email.trim(),
        dateOfBirth: form.dob || undefined,
        idType: form.idType || undefined, idNumber: form.idNumber || undefined,
        country: form.country, password: form.password,
      };
      const { data } = await api.post('/auth/register', payload);
      localStorage.setItem('ch_token', data.access_token);
      toast.success(t('registerSuccess'));
      setTimeout(() => navigate('/'), 800);
    } catch (err) {
      const msg = err.response?.data?.error || '';
      if (msg.includes('email') || msg.includes('23505')) toast.error(lang==='fr'?'Email déjà utilisé':'Email already in use');
      else if (msg.includes('phone')) toast.error(t('regErrorPhone'));
      else toast.error(msg || lang==='fr'?'Erreur création compte':'Account creation error');
    } finally { setLoading(false); }
  };

  const inp = { width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', fontSize:14, color:TEXT, fontFamily:FONT, boxSizing:'border-box' };
  const sel = { ...inp };

  return (
    <div style={{ minHeight:'100vh', background:BG, display:'flex', alignItems:'center', justifyContent:'center', fontFamily:FONT, padding:20 }}>
      <div style={{ width:'100%', maxWidth:480 }}>
        <div style={{ textAlign:'right', marginBottom:12 }}>
          <button onClick={toggleLang} style={{ background:'none', border:`1px solid ${BORDER}`, color:TEXT, padding:'5px 12px', borderRadius:20, cursor:'pointer', fontSize:12, fontFamily:FONT }}>🌐 {t('language')}</button>
        </div>
        <div style={{ textAlign:'center', marginBottom:20 }}>
          <img src="/logo-calculus.png" alt="Calculus Plus" style={{ height:48, width:'auto', objectFit:'contain', display:'block', margin:'0 auto 10px' }} />
          <div style={{ fontSize:18, fontWeight:700, color:TEXT, fontFamily:FONT }}>{t('registerTitle')}</div>
          <div style={{ fontSize:13, color:MUTED, marginTop:4 }}>{t('registerSubtitle')}</div>
        </div>

        {/* Indicateur étapes */}
        <div style={{ display:'flex', gap:8, marginBottom:20 }}>
          {[1,2].map(s => (
            <div key={s} style={{ flex:1, height:4, borderRadius:2, background: s <= step ? P : BORDER, transition:'background .3s' }} />
          ))}
        </div>
        <div style={{ fontSize:11, color:MUTED, marginBottom:16, textAlign:'center', fontFamily:FONT }}>
          {lang==='fr'?`Étape ${step} sur 2`:`Step ${step} of 2`} — {step===1?(lang==='fr'?'Informations personnelles':'Personal information'):(lang==='fr'?'Sécurité':'Security')}
        </div>

        <Box>
          {step === 1 ? (
            <>
              {/* Étape 1 — Identité */}
              <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:12, marginBottom:12 }}>
                <div>
                  <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('firstName')} *</label>
                  <input value={form.firstName} onChange={e=>f('firstName')(e.target.value)} placeholder="Jean" style={{ ...inp, borderColor: errors.firstName ? DANGER : BORDER }} />
                  {errors.firstName && <div style={{ fontSize:11, color:DANGER, marginTop:3 }}>{errors.firstName}</div>}
                </div>
                <div>
                  <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('lastName')} *</label>
                  <input value={form.lastName} onChange={e=>f('lastName')(e.target.value)} placeholder="Dupont" style={{ ...inp, borderColor: errors.lastName ? DANGER : BORDER }} />
                  {errors.lastName && <div style={{ fontSize:11, color:DANGER, marginTop:3 }}>{errors.lastName}</div>}
                </div>
              </div>
              <div style={{ marginBottom:12 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('phone')} *</label>
                <input value={form.phone} onChange={e=>f('phone')(e.target.value)} placeholder="+237XXXXXXXXX" type="tel" style={{ ...inp, borderColor: errors.phone ? DANGER : BORDER }} />
                {errors.phone && <div style={{ fontSize:11, color:DANGER, marginTop:3 }}>{errors.phone}</div>}
              </div>
              <div style={{ marginBottom:12 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('email')} *</label>
                <input value={form.email} onChange={e=>f('email')(e.target.value)} placeholder="email@example.com" type="email" style={{ ...inp, borderColor: errors.email ? DANGER : BORDER }} />
                {errors.email && <div style={{ fontSize:11, color:DANGER, marginTop:3 }}>{errors.email}</div>}
              </div>
              <div style={{ marginBottom:12 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('dob')}</label>
                <input value={form.dob} onChange={e=>f('dob')(e.target.value)} type="date" style={inp} />
              </div>
              <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:12, marginBottom:12 }}>
                <div>
                  <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('idType')}</label>
                  <select value={form.idType} onChange={e=>f('idType')(e.target.value)} style={sel}>
                    <option value="national_id">{lang==='fr'?'CNI':'National ID'}</option>
                    <option value="passport">{lang==='fr'?'Passeport':'Passport'}</option>
                    <option value="drivers_license">{lang==='fr'?'Permis':'Driver license'}</option>
                  </select>
                </div>
                <div>
                  <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('idNumber')}</label>
                  <input value={form.idNumber} onChange={e=>f('idNumber')(e.target.value)} placeholder="123456789" style={inp} />
                </div>
              </div>
              <div style={{ marginBottom:20 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('country')}</label>
                <select value={form.country} onChange={e=>f('country')(e.target.value)} style={sel}>
                  {CEMAC.map(c => <option key={c.v} value={c.v}>{c.l}</option>)}
                </select>
              </div>
              <Btn onClick={() => { if (validateStep1()) setStep(2); }} color={P} style={{ width:'100%' }}>
                {lang==='fr'?'Continuer →':'Continue →'}
              </Btn>
            </>
          ) : (
            <>
              {/* Étape 2 — Sécurité */}
              <div style={{ marginBottom:14 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('password2')} *</label>
                <input value={form.password} onChange={e=>f('password')(e.target.value)} type="password" placeholder="••••••••" style={{ ...inp, borderColor: errors.password ? DANGER : BORDER }} />
                {form.password && (
                  <div style={{ marginTop:6 }}>
                    <div style={{ display:'flex', gap:4, marginBottom:4 }}>
                      {[1,2,3,4,5].map(i => (
                        <div key={i} style={{ flex:1, height:3, borderRadius:2, background: i <= pwdStrength(form.password) ? strengthColors[pwdStrength(form.password)] : BORDER }} />
                      ))}
                    </div>
                    <div style={{ display:'flex', gap:8, flexWrap:'wrap' }}>
                      {[
                        [form.password.length>=8, lang==='fr'?'8 car.':'8 chars'],
                        [/[A-Z]/.test(form.password), lang==='fr'?'Majuscule':'Uppercase'],
                        [/[a-z]/.test(form.password), lang==='fr'?'Minuscule':'Lowercase'],
                        [/[0-9]/.test(form.password), lang==='fr'?'Chiffre':'Number'],
                      ].map(([ok, label]) => (
                        <span key={label} style={{ fontSize:10, color: ok ? SUCCESS : MUTED, fontFamily:FONT }}>
                          {ok?'✓':'○'} {label}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
                {errors.password && <div style={{ fontSize:11, color:DANGER, marginTop:4 }}>{errors.password}</div>}
              </div>
              <div style={{ marginBottom:16 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('confirmPwd2')} *</label>
                <input value={form.confirmPassword} onChange={e=>f('confirmPassword')(e.target.value)} type="password" placeholder="••••••••" style={{ ...inp, borderColor: errors.confirmPassword ? DANGER : BORDER }} />
                {errors.confirmPassword && <div style={{ fontSize:11, color:DANGER, marginTop:4 }}>{errors.confirmPassword}</div>}
              </div>
              <div style={{ background:`${BLUE}08`, border:`1px solid ${BLUE}20`, borderRadius:8, padding:12, marginBottom:16, fontSize:11, color:MUTED, fontFamily:FONT }}>
                🌍 {lang==='fr'?'Votre carte virtuelle GIMAC sera émise automatiquement après création de votre compte.':'Your GIMAC virtual card will be issued automatically after account creation.'}
              </div>
              <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:10 }}>
                <Btn onClick={()=>setStep(1)} outline color={MUTED} style={{ margin:0 }}>← {lang==='fr'?'Retour':'Back'}</Btn>
                <Btn onClick={submit} disabled={loading} color={P} style={{ margin:0 }}>
                  {loading ? t('registering') : `✓ ${t('createAccount')}`}
                </Btn>
              </div>
            </>
          )}
          <div style={{ textAlign:'center', marginTop:16, fontSize:13, fontFamily:FONT }}>
            <span style={{ color:MUTED }}>{t('alreadyAccount')} </span>
            <Link to="/login" style={{ color:P, fontWeight:700, textDecoration:'none' }}>{t('login')}</Link>
          </div>
        </Box>
      </div>
    </div>
  );
};

// ─── LOGIN ────────────────────────────────────────────────────────
const Login = ({ lang, toggleLang }) => {
  const t = k => T[lang][k] || k;
  const [creds, setCreds] = useState({ emailOrPhone:'', password:'' });
  const [loading, setLoading] = useState(false);
  const navigate = useNavigate();
  const { isAuth } = useAuth();
  useEffect(() => { if (isAuth) navigate('/'); }, [isAuth, navigate]);

  const submit = async () => {
    setLoading(true);
    try {
      const { data } = await api.post('/auth/login', creds);
      localStorage.setItem('ch_token', data.access_token);
      navigate('/');
    } catch { toast.error(t('loginError')); }
    finally { setLoading(false); }
  };

  return (
    <div style={{ minHeight:'100vh', background:BG, display:'flex', alignItems:'center', justifyContent:'center', fontFamily:FONT }}>
      <div style={{ width:400 }}>
        <div style={{ textAlign:'right', marginBottom:12 }}>
          <button onClick={toggleLang} style={{ background:'none', border:`1px solid ${BORDER}`, color:TEXT, padding:'5px 12px', borderRadius:20, cursor:'pointer', fontSize:12, fontFamily:FONT }}>🌐 {t('language')}</button>
        </div>
        <div style={{ textAlign:'center', marginBottom:24 }}>
          <img src="/logo-calculus.png" alt="Calculus Plus" style={{ width:220, height:'auto', display:'block', margin:'0 auto 10px', objectFit:'contain', mixBlendMode:'multiply' }} />
          <div style={{ color:MUTED, fontSize:13 }}>Espace Porteur de Carte</div>
        </div>
        <Box>
          <Inp label={t('emailOrPhone')} value={creds.emailOrPhone} onChange={v=>setCreds(c=>({...c,emailOrPhone:v}))} placeholder="email@example.com" />
          <Inp label={t('password')} value={creds.password} onChange={v=>setCreds(c=>({...c,password:v}))} type="password" placeholder="••••••••" />
          <div style={{ fontSize:11, color:MUTED, marginBottom:12, fontFamily:FONT }}>
            🔒 {lang==='fr'?"Votre session sera verrouillée après 5 tentatives échouées":'Your account will be locked after 5 failed attempts'}
          </div>
          <Btn onClick={submit} disabled={loading} style={{ width:'100%', marginTop:4 }}>{loading?t('loggingIn'):t('login')}</Btn>
          <div style={{ textAlign:'center', marginTop:16, fontSize:13, fontFamily:FONT }}>
            <span style={{ color:MUTED }}>{t('noAccount')} </span>
            <Link to="/register" style={{ color:P, fontWeight:700, textDecoration:'none' }}>{t('createAccount')}</Link>
          </div>
        </Box>
      </div>
    </div>
  );
};

// ─── DASHBOARD / MA CARTE ─────────────────────────────────────────
const Dashboard = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [dash, setDash]   = useState(null);
  const [loading, setLoading] = useState(true);
  const [freezing, setFreezing] = useState(false);

  const load = useCallback(() => {
    setLoading(true);
    api.get('/dashboard').then(r=>setDash(r.data)).catch(()=>toast.error(t('error'))).finally(()=>setLoading(false));
  }, []);
  useEffect(()=>{ load(); }, [load]);

  const toggleCard = async () => {
    const action = dash.card.status === 'active' ? 'freeze' : 'unfreeze';
    const confirm = window.confirm(t(action === 'freeze' ? 'freezeConfirm' : 'unfreezeConfirm'));
    if (!confirm) return;
    setFreezing(true);
    try {
      await api.patch('/card/status', { action });
      toast.success(action === 'freeze' ? '❄️ Carte gelée' : '✅ Carte activée');
      load();
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setFreezing(false); }
  };

  if (loading) return <Spin />;
  if (!dash) return <div style={{ color:MUTED, padding:40, textAlign:'center' }}>{t('error')}</div>;

  const { card, stats, recentTransactions } = dash;
  const isFrozen = card.status === 'frozen';

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>{t('dashboard')}</h1>

      {/* Carte virtuelle */}
      {/* Carte ISO ID-1 : ratio 85.6mm × 53.98mm = 1.585 */}
      <div style={{ background:isFrozen ? `linear-gradient(135deg, ${MUTED}, #8a9ab0)` : `linear-gradient(135deg, ${BLUE}, ${P})`, borderRadius:16, padding:0, marginBottom:20, color:'#fff', position:'relative', overflow:'hidden', boxShadow:'0 8px 32px rgba(29,79,146,0.25)', aspectRatio:'85.6/54', width:'100%', maxWidth:480, display:'flex', flexDirection:'column', justifyContent:'space-between' }}>
        {/* Cercles déco */}
        <div style={{ position:'absolute', top:-40, right:-40, width:180, height:180, borderRadius:'50%', background:'rgba(255,255,255,0.07)', pointerEvents:'none' }} />
        <div style={{ position:'absolute', bottom:-50, left:-30, width:220, height:220, borderRadius:'50%', background:'rgba(255,255,255,0.05)', pointerEvents:'none' }} />
        {/* Puce EMV simulée */}
        <div style={{ position:'absolute', top:'30%', left:24, width:40, height:30, borderRadius:6, background:'linear-gradient(135deg,#d4a843,#f0c85a)', border:'1px solid rgba(255,255,255,0.3)', boxShadow:'inset 0 1px 2px rgba(0,0,0,0.2)' }} />
        {/* Contenu */}
        <div style={{ padding:'18px 22px 0', display:'flex', justifyContent:'space-between', alignItems:'flex-start' }}>
          <div>
            <div style={{ fontSize:10, opacity:0.75, letterSpacing:2, textTransform:'uppercase', fontFamily:FONT, fontWeight:700 }}>Calculus Plus</div>
            <div style={{ fontSize:10, opacity:0.7, marginTop:2, fontFamily:FONT, letterSpacing:1 }}>{card.network?.toUpperCase() || 'VISA'}</div>
          </div>
          <div style={{ display:'flex', flexDirection:'column', alignItems:'flex-end', gap:4 }}>
            <div style={{ background:'rgba(255,255,255,0.15)', borderRadius:6, padding:'3px 10px', fontSize:10, fontWeight:700, fontFamily:FONT }}>{isFrozen ? t('cardFrozen') : t('cardActive')}</div>
            {/* Wifi contactless */}
            <div style={{ fontSize:16, opacity:0.8 }}>📶</div>
          </div>
        </div>
        <div style={{ padding:'0 22px', marginTop:8 }}>
          <div style={{ fontSize:17, letterSpacing:4, fontFamily:'monospace', fontWeight:600 }}>{card.card_masked || '4242 **** **** 1234'}</div>
        </div>
        <div style={{ padding:'0 22px 18px', display:'flex', justifyContent:'space-between', alignItems:'flex-end' }}>
          <div>
            <div style={{ fontSize:8, opacity:0.65, fontFamily:FONT, letterSpacing:1, textTransform:'uppercase', marginBottom:2 }}>{t('cardBalance')}</div>
            <div style={{ fontSize:22, fontWeight:800, fontFamily:FONT, lineHeight:1 }}>{fmtNum(card.balance)} <span style={{ fontSize:12, opacity:0.85 }}>{card.currency}</span></div>
          </div>
          <div style={{ textAlign:'right' }}>
            <div style={{ fontSize:8, opacity:0.65, fontFamily:FONT, letterSpacing:1, textTransform:'uppercase', marginBottom:2 }}>TITULAIRE</div>
            <div style={{ fontSize:10, fontFamily:FONT, letterSpacing:1, fontWeight:600 }}>{card.cardholder_name}</div>
            <div style={{ fontSize:9, opacity:0.8, fontFamily:'monospace', marginTop:2 }}>VALIDE {card.expiry_month ? String(card.expiry_month).padStart(2,'0')+'/'+(card.expiry_year||'') : ''}</div>
          </div>
        </div>
      </div>

      {/* Boutons actions rapides */}
      <div style={{ display:'grid', gridTemplateColumns:'repeat(2,1fr)', gap:10, marginBottom:20 }}>
        <Btn onClick={toggleCard} disabled={freezing} color={isFrozen ? SUCCESS : WARNING} style={{ margin:0 }}>
          {isFrozen ? `✅ ${t('unfreeze')}` : `❄️ ${t('freeze')}`}
        </Btn>
        <Link to="/payment" style={{ display:'flex', alignItems:'center', justifyContent:'center', gap:6, background:P, color:'#fff', borderRadius:10, padding:'11px', textAlign:'center', textDecoration:'none', fontSize:14, fontWeight:700, fontFamily:FONT }}>
          💸 {t('payment')}
        </Link>
        <Link to="/topup" style={{ display:'flex', alignItems:'center', justifyContent:'center', gap:6, background:SUCCESS, color:'#fff', borderRadius:10, padding:'11px', textAlign:'center', textDecoration:'none', fontSize:14, fontWeight:700, fontFamily:FONT }}>
          ⬆️ {t('topup')}
        </Link>
        <Link to="/unload" style={{ display:'flex', alignItems:'center', justifyContent:'center', gap:6, background:WARNING, color:'#fff', borderRadius:10, padding:'11px', textAlign:'center', textDecoration:'none', fontSize:14, fontWeight:700, fontFamily:FONT }}>
          ⬇️ {t('unload')}
        </Link>
      </div>

      {/* Stats du mois — enrichies */}
      <div style={{ display:'grid', gridTemplateColumns:'repeat(3,1fr)', gap:12, marginBottom:20 }}>
        {[
          [t('monthSpent'),  fmtNum(stats.monthSpent),  DANGER,   '💸', lang==='fr'?"Dépenses 30j":'Spent 30d'],
          [t('monthTopup'),  fmtNum(stats.monthTopup),  SUCCESS,  '⬆️', lang==='fr'?"Rechargements":'Top-ups'],
          [t('monthCount'),  stats.monthCount,           P,        '📊', lang==='fr'?"Transactions":'Transactions'],
        ].map(([l,v,c,icon]) => (
          <Box key={l} style={{ padding:14, marginBottom:0, textAlign:'center' }}>
            <div style={{ fontSize:20, marginBottom:4 }}>{icon}</div>
            <div style={{ fontSize:11, color:MUTED, marginBottom:4, fontFamily:FONT }}>{l}</div>
            <div style={{ fontSize:18, fontWeight:700, color:c, fontFamily:FONT }}>{v}</div>
          </Box>
        ))}
      </div>

      {/* Camembert succès / échec */}
      <Box style={{ marginBottom:20 }}>
        <div style={{ fontSize:14, fontWeight:700, marginBottom:14, fontFamily:FONT }}>
          {lang==='fr'?"Taux de réussite transactions":'Transaction success rate'}
        </div>
        <DashboardPieChart stats={stats} lang={lang} />
      </Box>

      {/* Historique 7 jours — mini barres SVG */}
      <Box style={{ marginBottom:20 }}>
        <div style={{ fontSize:14, fontWeight:700, marginBottom:14, fontFamily:FONT }}>
          {lang==='fr'?"Volume 7 derniers jours":'Volume last 7 days'}
        </div>
        <DashboardBarChart recentTransactions={recentTransactions} lang={lang} />
      </Box>

      {/* Transactions récentes */}
      <Box>
        <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:14 }}>
          <span style={{ fontSize:15, fontWeight:700 }}>{t('recentTxn')}</span>
          <Link to="/transactions" style={{ color:P, fontSize:12, textDecoration:'none', fontWeight:600 }}>Tout voir →</Link>
        </div>
        {recentTransactions.length === 0
          ? <div style={{ color:MUTED, fontSize:13, textAlign:'center', padding:'16px 0' }}>{t('noTxn')}</div>
          : recentTransactions.map(txn => <TxnRow key={txn.txn_id} txn={txn} t={t} lang={lang} />)}
      </Box>
    </div>
  );
};

// ─── PAIEMENT MERCHANT ────────────────────────────────────────────
const Payment = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [form, setForm]     = useState({ merchantId:'', amount:'', description:'', pin:'' });
  const [useToken, setUseToken] = useState(false);
  const [cards, setCards]     = useState([]);
  const [selectedToken, setToken] = useState('');
  useEffect(() => {
    api.get('/cards').then(r => {
      const active = r.data.data || [];
      setCards(active);
      if (active.length > 0) {
        setUseToken(true);
        const def = active.find(c => c.isDefault) || active[0];
        setToken(def.tokenId);
      }
    }).catch(() => {});
  }, []);
  const [loading, setLoading] = useState(false);
  const [result, setResult]   = useState(null);
  const f = k => v => setForm(p=>({...p,[k]:v}));

  const submit = async () => {
    if (!form.amount || parseFloat(form.amount) <= 0) return toast.error(t('amount'));
    if (!form.pin || form.pin.length !== 4) return toast.error(t('pinInvalid'));
    setLoading(true);
    try {
      const endpoint = useToken && selectedToken ? '/payment/tokenized' : '/payment';
      const payload  = useToken && selectedToken
        ? { tokenId: selectedToken, merchantId: form.merchantId||undefined, amount: parseFloat(form.amount), description: form.description||undefined, pin: form.pin }
        : { merchantId: form.merchantId||undefined, amount: parseFloat(form.amount), description: form.description||undefined, pin: form.pin };
      const { data } = await api.post(endpoint, payload);
      setResult(data);
      toast.success(t('paySuccess'));
    } catch (err) { toast.error(err.response?.data?.error || t('payFailed')); }
    finally { setLoading(false); }
  };

  const reset = () => { setResult(null); setForm({ merchantId:'', amount:'', description:'', pin:'' }); };

  const [scanMode, setScanMode] = useState(false);
  const [qrResult, setQrResult] = useState(null);
  const videoRef = React.useRef(null);
  const scannerRef = React.useRef(null);

  // Démarrer le scan QR
  const startScan = async () => {
    setScanMode(true);
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
        videoRef.current.play();
        // Simuler lecture QR après 2s en sandbox
        setTimeout(() => {
          // Format QR CPlus: cpay://pay?mid=MID123&amount=5000&mode=card
          const mockQr = 'cpay://pay?mid=MERCHANT001&amount=5000&mode=card&desc=Achat+magasin';
          handleQrResult(mockQr);
        }, 2000);
      }
    } catch {
      toast.error(lang==='fr' ? 'Caméra non disponible' : 'Camera not available');
      setScanMode(false);
    }
  };

  const stopScan = () => {
    if (videoRef.current?.srcObject) {
      videoRef.current.srcObject.getTracks().forEach(t => t.stop());
    }
    setScanMode(false);
  };

  const handleQrResult = (qrData) => {
    stopScan();
    try {
      // Parser le QR CPlus: cpay://pay?mid=X&amount=Y&mode=card|momo
      const url = new URL(qrData.replace('cpay://', 'https://cpay.app/'));
      const mid    = url.searchParams.get('mid')    || '';
      const amount = url.searchParams.get('amount') || '';
      const mode   = url.searchParams.get('mode')   || 'card'; // card|momo
      const desc   = url.searchParams.get('desc')   || '';
      setQrResult({ mid, amount, mode, desc, raw: qrData });
      setForm(p => ({ ...p, merchantId: mid, amount, description: desc }));
      toast.success(lang==='fr' ? `QR scanné — ${mode==='momo'?'Paiement Mobile Money':'Paiement carte'}` : `QR scanned — ${mode==='momo'?'Mobile Money':'Card payment'}`);
    } catch {
      toast.error(lang==='fr' ? 'QR Code invalide' : 'Invalid QR Code');
    }
  };

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>💸 {t('payment')}</h1>

      {/* Mode Scan QR */}
      {scanMode ? (
        <Box style={{ maxWidth:480, textAlign:'center' }}>
          <div style={{ fontSize:16, fontWeight:700, color:TEXT, marginBottom:12, fontFamily:FONT }}>
            📷 {lang==='fr' ? 'Pointez vers le QR Code du marchand' : 'Point at the merchant QR Code'}
          </div>
          <div style={{ position:'relative', borderRadius:16, overflow:'hidden', background:'#000', marginBottom:16 }}>
            <video ref={videoRef} style={{ width:'100%', height:280, objectFit:'cover' }} playsInline muted />
            {/* Cadre de scan */}
            <div style={{ position:'absolute', top:'50%', left:'50%', transform:'translate(-50%,-50%)', width:180, height:180, border:'3px solid #12b6c7', borderRadius:12, boxShadow:'0 0 0 9999px rgba(0,0,0,0.4)' }} />
            <div style={{ position:'absolute', top:'50%', left:'50%', transform:'translate(-50%,-50%)', width:180, height:3, background:'#12b6c7', opacity:0.8, animation:'scan 2s linear infinite' }} />
          </div>
          <Btn onClick={stopScan} outline color={MUTED}>{lang==='fr' ? 'Annuler' : 'Cancel'}</Btn>
        </Box>
      ) : !result ? (
        <Box style={{ maxWidth:480 }}>
          {/* Boutons mode paiement */}
          <div style={{ display:'flex', gap:8, marginBottom:20 }}>
            <button onClick={startScan}
              style={{ flex:1, display:'flex', alignItems:'center', justifyContent:'center', gap:8, padding:'12px', borderRadius:12, border:`2px solid ${P}`, background:`${P}10`, color:P, cursor:'pointer', fontSize:13, fontWeight:700, fontFamily:FONT }}>
              📷 {lang==='fr' ? 'Scanner QR' : 'Scan QR'}
            </button>
            <button style={{ flex:1, display:'flex', alignItems:'center', justifyContent:'center', gap:8, padding:'12px', borderRadius:12, border:`2px solid ${BORDER}`, background:CARD, color:TEXT, cursor:'default', fontSize:13, fontWeight:700, fontFamily:FONT }}>
              ⌨️ {lang==='fr' ? 'Saisie manuelle' : 'Manual entry'}
            </button>
          </div>
          {qrResult && (
            <div style={{ background:`${SUCCESS}10`, border:`1px solid ${SUCCESS}40`, borderRadius:10, padding:12, marginBottom:16, fontSize:12, fontFamily:FONT }}>
              ✅ QR scanné : <strong>{qrResult.mid}</strong> — {fmtNum(parseFloat(qrResult.amount))} XAF
              {qrResult.mode === 'momo' && <span style={{ color:WARNING, marginLeft:8 }}>📱 Mobile Money</span>}
              {qrResult.mode === 'card' && <span style={{ color:P, marginLeft:8 }}>💳 Carte</span>}
            </div>
          )}
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>{t('payMerchant')}</h3>
          <Inp label={t('merchantId')} value={form.merchantId} onChange={f('merchantId')} placeholder="ID du marchand" />
          <Inp label={`${t('amount')} *`} value={form.amount} onChange={f('amount')} type="number" placeholder="5000" />
          <Inp label={t('description')} value={form.description} onChange={f('description')} placeholder="Ex: Achat en magasin" />
          <div style={{ marginBottom:14 }}>
            {/* Sélecteur de carte enrollée */}
            {cards.length > 0 && (
              <div style={{ marginBottom:16 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>
                  {lang==='fr'?'Payer avec':'Pay with'}
                </label>
                <div style={{ display:'flex', gap:8, marginBottom:10 }}>
                  <button onClick={()=>setUseToken(true)}  style={{ flex:1, padding:'9px', borderRadius:8, border:`2px solid ${useToken?P:BORDER}`, background:useToken?`${P}12`:CARD, color:useToken?P:MUTED, cursor:'pointer', fontSize:12, fontWeight:useToken?700:400, fontFamily:FONT }}>💳 Carte enregistrée</button>
                  <button onClick={()=>setUseToken(false)} style={{ flex:1, padding:'9px', borderRadius:8, border:`2px solid ${!useToken?P:BORDER}`, background:!useToken?`${P}12`:CARD, color:!useToken?P:MUTED, cursor:'pointer', fontSize:12, fontWeight:!useToken?700:400, fontFamily:FONT }}>💸 Carte virtuelle</button>
                </div>
                {useToken && (
                  <select value={selectedToken} onChange={e=>setToken(e.target.value)}
                    style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', fontSize:13, color:TEXT, fontFamily:FONT }}>
                    {cards.map(c => <option key={c.tokenId} value={c.tokenId}>{NETWORK_ICONS[c.network]||'💳'} {c.cardMasked} {c.isDefault?'★':''}</option>)}
                  </select>
                )}
              </div>
            )}
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('pin')} *</label>
            <PinInput value={form.pin} onChange={v=>setForm(p=>({...p,pin:v}))} />
          </div>
          <div style={{ background:`${WARNING}12`, border:`1px solid ${WARNING}40`, borderRadius:8, padding:12, marginBottom:16, fontSize:12, color:TEXT }}>
            ⚠️ {lang==='fr' ? 'Frais de transaction : 0.5% du montant' : 'Transaction fee: 0.5% of amount'}
          </div>
          <Btn onClick={submit} disabled={loading} style={{ width:'100%' }}>{loading ? t('paying') : t('confirmPay')}</Btn>
        </Box>
      ) : (
        <Box style={{ maxWidth:480, textAlign:'center' }}>
          <div style={{ fontSize:56, marginBottom:12 }}>✅</div>
          <div style={{ fontSize:20, fontWeight:700, color:SUCCESS, marginBottom:8, fontFamily:FONT }}>{t('paySuccess')}</div>
          <div style={{ fontSize:32, fontWeight:800, color:TEXT, marginBottom:4, fontFamily:FONT }}>{fmtNum(result.txn?.amount)} {result.txn?.currency}</div>
          {result.txn?.merchant_name && <div style={{ fontSize:13, color:MUTED, marginBottom:4 }}>→ {result.txn.merchant_name}</div>}
          {result.authCode && <div style={{ fontSize:12, color:MUTED, fontFamily:'monospace', marginBottom:4 }}>Auth: {result.authCode}</div>}
          <div style={{ fontSize:14, color:P, fontWeight:700, marginBottom:20 }}>{t('newBalance')} : {fmtNum(result.newBalance)} XAF</div>
          <Btn onClick={reset} color={P}>{t('payment')} +</Btn>
        </Box>
      )}
    </div>
  );
};

// ─── TOP-UP ───────────────────────────────────────────────────────
const TopUp = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [form, setForm]   = useState({ amount:'', operator:'mtn', phone:'' });
  const [loading, setLoading] = useState(false);
  const [result, setResult]   = useState(null);
  const f = k => v => setForm(p=>({...p,[k]:v}));
  // Cartes disponibles (virtuelles CPlus)
  const [cards, setCards]       = useState([]);
  const [selectedCard, setSelectedCard] = useState(null);
  const [polling, setPolling]     = useState(false);
  const [phoneCheck, setPhoneCheck] = useState(null);
  const [phoneTimer, setPhoneTimer] = useState(null);

  useEffect(() => {
    api.get('/card').then(r => {
      // Carte virtuelle principale
      const main = { cardId: r.data.cardId, label: `Carte CPlus ${r.data.cardMasked}`, balance: r.data.balance, currency: r.data.currency, type: 'cplus' };
      setCards([main]);
      setSelectedCard(main.cardId);
    }).catch(() => {});
    // Cartes GTP si disponibles
    api.get('/gtp/cards').then(r => {
      if (r.data.data?.length > 0) {
        setCards(prev => [...prev, ...r.data.data.map(c => ({
          cardId: c.gtp_card_id,
          label: `C-Pay Card ${c.pan_masked}`,
          balance: null,
          currency: 'XAF',
          type: 'gtp'
        }))]);
      }
    }).catch(() => {});
  }, []);

  // Vérification automatique numéro MTN après 800ms de saisie
  const onPhoneChange = (val) => {
    setForm(p => ({...p, phone: val}));
    setPhoneCheck(null);
    if (phoneTimer) clearTimeout(phoneTimer);
    const clean = val.replace(/\D/g,'');
    if (clean.length >= 9) {
      setPhoneCheck('checking');
      const timer = setTimeout(async () => {
        try {
          const BASE = process.env.REACT_APP_API_BASE_URL || '';
          const { data } = await axios.get(`${BASE}/api/v1/momo/validate/${clean}`,
            { headers: { Authorization: `Bearer ${localStorage.getItem('ch_token')}` } }
          );
          setPhoneCheck(data.active ? 'valid' : 'invalid');
        } catch { setPhoneCheck('invalid'); }
      }, 800);
      setPhoneTimer(timer);
    }
  };

  const submit = async () => {
    if (!form.amount || parseFloat(form.amount) < 500) return toast.error('Montant minimum 500');
    if (!form.phone) return toast.error(t('mmPhone'));
    setLoading(true);
    try {
      const BASE = process.env.REACT_APP_API_BASE_URL || '';
      const { data } = await axios.post(`${BASE}/api/v1/momo/topup`,
        { amount: parseFloat(form.amount), phone: form.phone },
        { headers: { Authorization: `Bearer ${localStorage.getItem('ch_token')}` } }
      );
      setResult({ ...data, status: 'PENDING' });
      const opName = OPERATORS.find(o=>o.v===form.operator)?.l || 'MTN';
      toast.success(lang==='fr' ? `Notification envoyée sur votre téléphone ${opName}` : `Notification sent to your ${opName} phone`);
      setPolling(true);
      let attempts = 0;
      const poll = setInterval(async () => {
        attempts++;
        try {
          const { data: s } = await axios.get(`${BASE}/api/v1/momo/status/${data.referenceId}`,
            { headers: { Authorization: `Bearer ${localStorage.getItem('ch_token')}` } }
          );
          if (s.status === 'SUCCESSFUL') {
            clearInterval(poll); setPolling(false);
            setResult(r => ({ ...r, status: 'SUCCESSFUL' }));
            toast.success(t('topupSuccess'));
          } else if (s.status === 'FAILED' || attempts >= 20) {
            clearInterval(poll); setPolling(false);
            setResult(r => ({ ...r, status: s.status === 'FAILED' ? 'FAILED' : 'TIMEOUT' }));
            if (s.status === 'FAILED') toast.error(lang==='fr' ? 'Paiement refusé par MTN' : 'Payment declined by MTN');
          }
        } catch { if (attempts >= 20) { clearInterval(poll); setPolling(false); } }
      }, 5000);
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setLoading(false); }
  };

  const reset = () => { setResult(null); setForm({ amount:'', operator:'mtn', phone:'' }); setPolling(false); };

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>⬆️ {t('topup')}</h1>
      {!result ? (
        <Box style={{ maxWidth:480 }}>
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>{t('topupTitle')}</h3>
          {/* Sélecteur carte destination */}
          {cards.length > 0 && (
            <div style={{ marginBottom:14 }}>
              <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>
                {lang==='fr' ? '💳 Carte à recharger' : '💳 Card to top-up'} *
              </label>
              {cards.map(c => (
                <button key={c.cardId} onClick={()=>setSelectedCard(c.cardId)}
                  style={{ display:'flex', alignItems:'center', gap:12, padding:'10px 14px', borderRadius:10, border:`2px solid ${selectedCard===c.cardId?P:BORDER}`, background:selectedCard===c.cardId?`${P}10`:CARD, cursor:'pointer', textAlign:'left', width:'100%', marginBottom:6 }}>
                  <span style={{ fontSize:18 }}>{c.type==='gtp'?'🌍':'💳'}</span>
                  <div style={{ flex:1 }}>
                    <div style={{ fontSize:13, fontWeight:600, color:TEXT, fontFamily:FONT }}>{c.label}</div>
                    {c.balance !== null && <div style={{ fontSize:11, color:MUTED, fontFamily:FONT }}>{fmtNum(c.balance)} {c.currency}</div>}
                  </div>
                  {selectedCard===c.cardId && <span style={{ color:P, fontWeight:700 }}>✓</span>}
                </button>
              ))}
            </div>
          )}
          <Inp label={`${t('amount')} * (min. 500 XAF)`} value={form.amount} onChange={f('amount')} type="number" placeholder="10000" />
          <Sel label={t('operator')} value={form.operator} onChange={v=>{
            setForm(p=>({...p,operator:v,phone:''}));
            setPhoneCheck(null);
          }} options={OPERATORS.map(o=>({v:o.v,l:o.l}))} />
          <div style={{ marginBottom:14 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('mmPhone')} *</label>
            <div style={{ position:'relative' }}>
              <input value={form.phone} onChange={e=>onPhoneChange(e.target.value)}
                placeholder={form.operator==='mtn'?'+242 06X XXX XXX':form.operator==='airtel'?'+242 04X XXX XXX':'+242XXXXXXXXX'}
                type="tel"
                style={{ width:'100%', background:BG, border:`2px solid ${phoneCheck==='valid'?SUCCESS:phoneCheck==='invalid'?DANGER:BORDER}`, borderRadius:8, padding:'10px 44px 10px 12px', fontSize:14, color:TEXT, fontFamily:FONT, boxSizing:'border-box', outline:'none', transition:'border-color 0.2s' }} />
              <span style={{ position:'absolute', right:12, top:'50%', transform:'translateY(-50%)', fontSize:16 }}>
                {phoneCheck==='checking' && '⏳'}
                {phoneCheck==='valid'    && '✅'}
                {phoneCheck==='invalid'  && '❌'}
              </span>
            </div>
            {phoneCheck==='valid'   && <div style={{ fontSize:11, color:SUCCESS, marginTop:4, fontFamily:FONT }}>✓ Numéro {OPERATORS.find(o=>o.v===form.operator)?.l} actif</div>}
            {phoneCheck==='invalid' && <div style={{ fontSize:11, color:DANGER,  marginTop:4, fontFamily:FONT }}>✗ Numéro non reconnu ou incompatible avec {OPERATORS.find(o=>o.v===form.operator)?.l}</div>}
            {phoneCheck==='checking'&& <div style={{ fontSize:11, color:MUTED,   marginTop:4, fontFamily:FONT }}>Vérification en cours…</div>}
            {form.phone && phoneCheck===null && form.operator && (() => {
              const detected = getOperatorForPhone(form.phone);
              if (detected && detected !== form.operator) return (
                <div style={{ fontSize:11, color:WARNING, marginTop:4, fontFamily:FONT }}>
                  ⚠️ Ce numéro semble être {OPERATORS.find(o=>o.v===detected)?.l}
                </div>
              );
              return null;
            })()}
          </div>
          {form.amount && parseFloat(form.amount) >= 500 && (
            <div style={{ background:`${SUCCESS}10`, border:`1px solid ${SUCCESS}40`, borderRadius:8, padding:12, marginBottom:16, fontSize:12, color:TEXT }}>
              💰 {lang==='fr' ? 'Vous recevrez' : 'You will receive'} : <strong>{fmtNum(Math.round(parseFloat(form.amount) * 0.99))} XAF</strong>
              {' '}({t('fee')} : {fmtNum(Math.round(parseFloat(form.amount) * 0.01))} XAF, 1%)
            </div>
          )}
          <Btn onClick={submit} disabled={loading} color={SUCCESS} style={{ width:'100%' }}>{loading ? t('toppingUp') : t('topupBtn')}</Btn>
        </Box>
      ) : (
        <Box style={{ maxWidth:480, textAlign:'center' }}>
          {result.status === 'PENDING' && (
            <>
              <div style={{ fontSize:56, marginBottom:12 }}>📱</div>
              <div style={{ fontSize:18, fontWeight:700, color:WARNING, marginBottom:8, fontFamily:FONT }}>
                {lang==='fr' ? 'En attente de confirmation MTN' : 'Waiting for MTN confirmation'}
              </div>
              <div style={{ fontSize:13, color:MUTED, marginBottom:12, fontFamily:FONT }}>
                {lang==='fr' ? 'Validez le paiement sur votre téléphone MTN Mobile Money' : 'Confirm on your MTN Mobile Money phone'}
              </div>
              {polling && <div style={{ fontSize:12, color:P, marginBottom:12, fontFamily:FONT }}>⏳ {lang==='fr' ? 'Vérification en cours…' : 'Checking status…'}</div>}
              <div style={{ fontSize:11, color:MUTED, fontFamily:'monospace', marginBottom:20 }}>Réf: {result.referenceId}</div>
              <Btn onClick={reset} outline color={MUTED}>{lang==='fr' ? 'Annuler' : 'Cancel'}</Btn>
            </>
          )}
          {result.status === 'SUCCESSFUL' && (
            <>
              <div style={{ fontSize:56, marginBottom:12 }}>✅</div>
              <div style={{ fontSize:20, fontWeight:700, color:SUCCESS, marginBottom:8, fontFamily:FONT }}>{t('topupSuccess')}</div>
              <div style={{ fontSize:32, fontWeight:800, color:TEXT, marginBottom:4, fontFamily:FONT }}>+{fmtNum(result.credited)} XAF</div>
              <div style={{ fontSize:11, color:MUTED, fontFamily:'monospace', marginBottom:20 }}>Réf: {result.referenceId}</div>
              <Btn onClick={reset} color={SUCCESS}>{t('topup')} +</Btn>
            </>
          )}
          {(result.status === 'FAILED' || result.status === 'TIMEOUT') && (
            <>
              <div style={{ fontSize:56, marginBottom:12 }}>❌</div>
              <div style={{ fontSize:18, fontWeight:700, color:DANGER, marginBottom:8, fontFamily:FONT }}>
                {result.status === 'TIMEOUT' ? (lang==='fr' ? 'Délai expiré' : 'Timeout') : (lang==='fr' ? 'Paiement refusé' : 'Declined')}
              </div>
              <Btn onClick={reset} color={P} style={{ marginTop:16 }}>{lang==='fr' ? 'Réessayer' : 'Retry'}</Btn>
            </>
          )}
        </Box>
      )}
    </div>
  );
};

// ─── UNLOAD ───────────────────────────────────────────────────────
const Unload = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [form, setForm]   = useState({ amount:'', operator:'mtn', phone:'', pin:'' });
  const [loading, setLoading] = useState(false);
  const [result, setResult]   = useState(null);
  const f = k => v => setForm(p=>({...p,[k]:v}));
  // Cartes disponibles
  const [cards, setCards]         = useState([]);
  const [selectedCard, setSelectedCard] = useState(null);
  const [phoneCheckU, setPhoneCheckU] = useState(null);
  const [phoneTimerU, setPhoneTimerU] = useState(null);

  useEffect(() => {
    api.get('/card').then(r => {
      const main = { cardId: r.data.cardId, label: `Carte CPlus ${r.data.cardMasked}`, balance: r.data.balance, currency: r.data.currency, type: 'cplus' };
      setCards([main]);
      setSelectedCard(main.cardId);
    }).catch(() => {});
    api.get('/gtp/cards').then(r => {
      if (r.data.data?.length > 0) {
        setCards(prev => [...prev, ...r.data.data.map(c => ({
          cardId: c.gtp_card_id,
          label: `C-Pay Card ${c.pan_masked}`,
          balance: null, currency: 'XAF', type: 'gtp'
        }))]);
      }
    }).catch(() => {});
  }, []);

  const onPhoneChangeU = (val) => {
    setForm(p => ({...p, phone: val}));
    setPhoneCheckU(null);
    if (phoneTimerU) clearTimeout(phoneTimerU);
    const clean = val.replace(/\D/g,'');
    if (clean.length >= 9) {
      setPhoneCheckU('checking');
      const timer = setTimeout(async () => {
        try {
          const BASE = process.env.REACT_APP_API_BASE_URL || '';
          const { data } = await axios.get(`${BASE}/api/v1/momo/validate/${clean}`,
            { headers: { Authorization: `Bearer ${localStorage.getItem('ch_token')}` } }
          );
          setPhoneCheckU(data.active ? 'valid' : 'invalid');
        } catch { setPhoneCheckU('invalid'); }
      }, 800);
      setPhoneTimerU(timer);
    }
  };

  const submit = async () => {
    if (!form.amount || parseFloat(form.amount) < 500) return toast.error('Montant minimum 500');
    if (!form.phone) return toast.error(t('mmPhone'));
    if (!form.pin || form.pin.length !== 4) return toast.error(t('pinInvalid'));
    setLoading(true);
    try {
      const BASE = process.env.REACT_APP_API_BASE_URL || '';
      const { data } = await axios.post(`${BASE}/api/v1/momo/payout`,
        { amount: parseFloat(form.amount), phone: form.phone, pin: form.pin },
        { headers: { Authorization: `Bearer ${localStorage.getItem('ch_token')}` } }
      );
      setResult({ ...data, status: 'PENDING' });
      toast.success(lang==='fr' ? 'Virement en cours vers MTN' : 'Transfer in progress');
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setLoading(false); }
  };

  const reset = () => { setResult(null); setForm({ amount:'', operator:'mtn', phone:'', pin:'' }); };

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>⬇️ {t('unload')}</h1>
      {!result ? (
        <Box style={{ maxWidth:480 }}>
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>{t('unloadTitle')}</h3>
          {/* Sélecteur carte source */}
          {cards.length > 0 && (
            <div style={{ marginBottom:14 }}>
              <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>
                {lang==='fr' ? '💳 Carte à décharger' : '💳 Card to unload'} *
              </label>
              {cards.map(c => (
                <button key={c.cardId} onClick={()=>setSelectedCard(c.cardId)}
                  style={{ display:'flex', alignItems:'center', gap:12, padding:'10px 14px', borderRadius:10, border:`2px solid ${selectedCard===c.cardId?WARNING:BORDER}`, background:selectedCard===c.cardId?`${WARNING}10`:CARD, cursor:'pointer', textAlign:'left', width:'100%', marginBottom:6 }}>
                  <span style={{ fontSize:18 }}>{c.type==='gtp'?'🌍':'💳'}</span>
                  <div style={{ flex:1 }}>
                    <div style={{ fontSize:13, fontWeight:600, color:TEXT, fontFamily:FONT }}>{c.label}</div>
                    {c.balance !== null && <div style={{ fontSize:11, color:MUTED, fontFamily:FONT }}>{fmtNum(c.balance)} {c.currency}</div>}
                  </div>
                  {selectedCard===c.cardId && <span style={{ color:WARNING, fontWeight:700 }}>✓</span>}
                </button>
              ))}
            </div>
          )}
          <Inp label={`${t('amount')} * (min. 500 XAF)`} value={form.amount} onChange={f('amount')} type="number" placeholder="10000" />
          <Sel label={t('operator')} value={form.operator} onChange={v=>{
            setForm(p=>({...p,operator:v,phone:''}));
            setPhoneCheckU(null);
          }} options={OPERATORS.map(o=>({v:o.v,l:o.l}))} />
          <div style={{ marginBottom:14 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('mmPhone')} *</label>
            <div style={{ position:'relative' }}>
              <input value={form.phone} onChange={e=>onPhoneChangeU(e.target.value)}
                placeholder={form.operator==='mtn'?'+242 06X XXX XXX':form.operator==='airtel'?'+242 04X XXX XXX':'+242XXXXXXXXX'}
                type="tel"
                style={{ width:'100%', background:BG, border:`2px solid ${phoneCheckU==='valid'?SUCCESS:phoneCheckU==='invalid'?DANGER:BORDER}`, borderRadius:8, padding:'10px 44px 10px 12px', fontSize:14, color:TEXT, fontFamily:FONT, boxSizing:'border-box', outline:'none' }} />
              <span style={{ position:'absolute', right:12, top:'50%', transform:'translateY(-50%)', fontSize:16 }}>
                {phoneCheckU==='checking' && '⏳'}
                {phoneCheckU==='valid'    && '✅'}
                {phoneCheckU==='invalid'  && '❌'}
              </span>
            </div>
            {phoneCheckU==='valid'    && <div style={{ fontSize:11, color:SUCCESS, marginTop:4, fontFamily:FONT }}>✓ Numéro {OPERATORS.find(o=>o.v===form.operator)?.l} actif</div>}
            {phoneCheckU==='invalid'  && <div style={{ fontSize:11, color:DANGER,  marginTop:4, fontFamily:FONT }}>✗ Numéro non reconnu ou incompatible avec {OPERATORS.find(o=>o.v===form.operator)?.l}</div>}
            {phoneCheckU==='checking' && <div style={{ fontSize:11, color:MUTED,   marginTop:4, fontFamily:FONT }}>Vérification en cours…</div>}
            {form.phone && phoneCheckU===null && form.operator && (() => {
              const detected = getOperatorForPhone(form.phone);
              if (detected && detected !== form.operator) return (
                <div style={{ fontSize:11, color:WARNING, marginTop:4, fontFamily:FONT }}>
                  ⚠️ Ce numéro semble être {OPERATORS.find(o=>o.v===detected)?.l} — vérifiez votre opérateur
                </div>
              );
              return null;
            })()}
          </div>
          <div style={{ marginBottom:14 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4 }}>{t('pin')} *</label>
            <PinInput value={form.pin} onChange={v=>setForm(p=>({...p,pin:v}))} />
          </div>
          {form.amount && parseFloat(form.amount) >= 500 && (
            <div style={{ background:`${WARNING}10`, border:`1px solid ${WARNING}40`, borderRadius:8, padding:12, marginBottom:16, fontSize:12, color:TEXT }}>
              ⚠️ {t('unloadFeeNote')} · {lang==='fr'?"Vous recevrez":'You will receive'} : <strong>{fmtNum(Math.round(parseFloat(form.amount) * 0.985))} XAF</strong>
            </div>
          )}
          <Btn onClick={submit} disabled={loading} color={WARNING} style={{ width:'100%' }}>{loading ? t('unloading') : t('unloadBtn')}</Btn>
        </Box>
      ) : (
        <Box style={{ maxWidth:480, textAlign:'center' }}>
          <div style={{ fontSize:56, marginBottom:12 }}>📲</div>
          <div style={{ fontSize:20, fontWeight:700, color:SUCCESS, marginBottom:8 }}>{t('unloadSuccess')}</div>
          <div style={{ fontSize:32, fontWeight:800, color:TEXT, marginBottom:4 }}>{fmtNum(result.sent)} XAF</div>
          <div style={{ fontSize:13, color:MUTED, marginBottom:4 }}>{t('fee')} : {fmtNum(result.fee)} XAF · Réf: {result.mmReference}</div>
          <div style={{ fontSize:14, color:P, fontWeight:700, marginBottom:20 }}>{t('newBalance')} : {fmtNum(result.newBalance)} XAF</div>
          <Btn onClick={reset} color={WARNING}>{t('unload')} +</Btn>
        </Box>
      )}
    </div>
  );
};

// ─── TRANSACTIONS ─────────────────────────────────────────────────
const TxnRow = ({ txn, t, lang }) => {
  const icons = { payment:'💸', topup:'⬆️', unload:'⬇️', fee:'⚙️', refund:'↩️' };
  const sign  = { payment:'-', unload:'-', fee:'-', topup:'+', refund:'+' };
  return (
    <div style={{ display:'flex', alignItems:'center', gap:12, padding:'10px 0', borderBottom:`1px solid ${BORDER}` }}>
      <div style={{ width:40, height:40, borderRadius:12, background:`${sc(txn.type)}18`, display:'flex', alignItems:'center', justifyContent:'center', fontSize:18 }}>{icons[txn.type]||'💳'}</div>
      <div style={{ flex:1 }}>
        <div style={{ fontSize:13, fontWeight:600, color:TEXT }}>{txn.merchant_name || t(`txn${txn.type.charAt(0).toUpperCase()+txn.type.slice(1)}`)||txn.type}</div>
        <div style={{ fontSize:11, color:MUTED }}>{fmtDate(txn.initiated_at, lang)}</div>
      </div>
      <div style={{ textAlign:'right' }}>
        <div style={{ fontSize:15, fontWeight:700, color:sc(txn.type) }}>{sign[txn.type]||''}{fmtNum(txn.amount)} {txn.currency}</div>
        <Badge label={txn.status} color={sc(txn.status)} />
      </div>
    </div>
  );
};

const Transactions = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [txns, setTxns]   = useState([]);
  const [total, setTotal] = useState(0);
  const [page, setPage]   = useState(1);
  const [typeF, setTypeF] = useState('');
  const [loading, setLoading] = useState(true);

  const load = useCallback(() => {
    setLoading(true);
    api.get('/transactions', { params:{ page, limit:20, type:typeF||undefined } })
      .then(r=>{ setTxns(r.data.data||[]); setTotal(r.data.total||0); })
      .finally(()=>setLoading(false));
  }, [page, typeF]);
  useEffect(()=>{ load(); }, [load]);

  const sel = { background:CARD, border:`1px solid ${BORDER}`, borderRadius:8, padding:'8px 12px', fontSize:13, color:TEXT, fontFamily:FONT };

  return (
    <div>
      <h1 style={{ margin:'0 0 16px', fontSize:22, fontWeight:700 }}>📋 {t('transactions')} <span style={{ fontSize:14, color:MUTED }}>({total})</span></h1>
      <div style={{ display:'flex', gap:10, marginBottom:14 }}>
        <select value={typeF} onChange={e=>{ setTypeF(e.target.value); setPage(1); }} style={sel}>
          <option value="">Tous les types</option>
          <option value="payment">{t('txnPayment')}</option>
          <option value="topup">{t('txnTopup')}</option>
          <option value="unload">{t('txnUnload')}</option>
          <option value="refund">{t('txnRefund')}</option>
        </select>
      </div>
      {loading ? <Spin /> : (
        <Box>
          {txns.length === 0
            ? <div style={{ textAlign:'center', padding:32, color:MUTED }}>{t('noTxn')}</div>
            : txns.map(txn => <TxnRow key={txn.txn_id} txn={txn} t={t} lang={lang} />)}
          <div style={{ display:'flex', gap:8, justifyContent:'flex-end', marginTop:12 }}>
            <Btn small outline color={P} onClick={()=>setPage(p=>Math.max(1,p-1))} disabled={page===1}>←</Btn>
            <span style={{ padding:'6px 12px', fontSize:13, color:MUTED }}>Page {page}</span>
            <Btn small outline color={P} onClick={()=>setPage(p=>p+1)} disabled={txns.length<20}>→</Btn>
          </div>
        </Box>
      )}
    </div>
  );
};

// ─── PROFIL + PARAMÈTRES ─────────────────────────────────────────
const Profile = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [card, setCard]   = useState(null);
  const [loading, setLoading] = useState(true);
  const [form, setForm]   = useState({});
  const [pwdForm, setPwdForm] = useState({ currentPassword:'', newPassword:'' });
  const [pinForm, setPinForm] = useState({ currentPin:'', newPin:'', confirmPin:'' });
  const [saving, setSaving] = useState(false);
  const [savingPwd, setSavingPwd] = useState(false);
  const [savingPin, setSavingPin] = useState(false);
  const [activeTab, setActiveTab] = useState('info');
  const f = k => v => setForm(p=>({...p,[k]:v}));

  useEffect(() => {
    api.get('/card').then(r => {
      setCard(r.data);
      setForm({ email: r.data.cardholder?.email||'', phone: r.data.cardholder?.phone||'', address: r.data.cardholder?.address||'', city: r.data.cardholder?.city||'' });
    }).finally(() => setLoading(false));
  }, []);

  const saveProfile = async () => {
    setSaving(true);
    try { await api.patch('/profile', form); toast.success(t('profileSaved')); }
    catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setSaving(false); }
  };

  const changePwd = async () => {
    setSavingPwd(true);
    try { await api.post('/profile/change-password', { currentPassword: pwdForm.currentPassword, newPassword: pwdForm.newPassword }); toast.success(t('pwdChanged')); setPwdForm({ currentPassword:'', newPassword:'' }); }
    catch (err) { toast.error(err.response?.data?.error === 'Mot de passe actuel incorrect' ? t('pwdError') : t('error')); }
    finally { setSavingPwd(false); }
  };

  const changePin = async () => {
    if (!/^\d{4}$/.test(pinForm.newPin)) return toast.error(t('pinInvalid'));
    if (pinForm.newPin !== pinForm.confirmPin) return toast.error(t('pinMismatch'));
    setSavingPin(true);
    try { await api.post('/card/pin', { currentPin: pinForm.currentPin||undefined, newPin: pinForm.newPin }); toast.success(t('pinChanged')); setPinForm({ currentPin:'', newPin:'', confirmPin:'' }); }
    catch (err) { toast.error(err.response?.data?.error || t('pinError')); }
    finally { setSavingPin(false); }
  };

  if (loading) return <Spin />;

  const tabs = [['info',t('profileTitle')],['pin',t('pinTitle')],['pwd',t('changePwd')],['security','🔐 Sécurité']];

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>👤 {t('profile')}</h1>
      <div style={{ display:'flex', gap:2, marginBottom:20, background:BG, borderRadius:10, padding:4, width:'fit-content', border:`1px solid ${BORDER}` }}>
        {tabs.map(([v,l]) => (
          <button key={v} onClick={()=>setActiveTab(v)} style={{ padding:'7px 20px', borderRadius:8, border:'none', background:activeTab===v?CARD:'transparent', fontWeight:activeTab===v?700:400, color:activeTab===v?P:MUTED, cursor:'pointer', fontSize:13, fontFamily:FONT }}>{l}</button>
        ))}
      </div>

      {activeTab === 'info' && (
        <Box style={{ maxWidth:500 }}>
          <Inp label={t('emailLabel')} value={form.email} onChange={f('email')} type="email" placeholder="email@example.com" />
          <Inp label={t('phoneLabel')} value={form.phone} onChange={f('phone')} placeholder="+237XXXXXXXXX" />
          <Inp label={t('addressLabel')} value={form.address} onChange={f('address')} placeholder="Rue, Quartier" />
          <Inp label={t('cityLabel')} value={form.city} onChange={f('city')} placeholder="Douala" />
          <div style={{ background:`${WARNING}10`, border:`1px solid ${WARNING}30`, borderRadius:8, padding:10, marginBottom:14, fontSize:12, color:TEXT }}>
            🔒 {lang==='fr'?"La modification de votre email ou téléphone nécessite une validation.":'Changing your email or phone requires verification.'}
          </div>
          <Btn onClick={saveProfile} disabled={saving} style={{ width:'100%' }}>{saving ? t('saving') : t('save')}</Btn>
        </Box>
      )}

      {activeTab === 'pin' && (
        <Box style={{ maxWidth:400 }}>
          <div style={{ marginBottom:16, background:`${P}10`, border:`1px solid ${P}30`, borderRadius:8, padding:12, fontSize:12, color:TEXT }}>
            🔐 {lang==='fr'?"Le PIN est requis pour les paiements et les déchargements.":'PIN is required for payments and unloads.'}
          </div>
          <div style={{ marginBottom:14 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6 }}>{t('currentPin')}</label>
            <PinInput value={pinForm.currentPin} onChange={v=>setPinForm(p=>({...p,currentPin:v}))} />
          </div>
          <div style={{ marginBottom:14 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6 }}>{t('newPin')}</label>
            <PinInput value={pinForm.newPin} onChange={v=>setPinForm(p=>({...p,newPin:v}))} />
          </div>
          <div style={{ marginBottom:18 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6 }}>{t('confirmPin')}</label>
            <PinInput value={pinForm.confirmPin} onChange={v=>setPinForm(p=>({...p,confirmPin:v}))} />
          </div>
          <Btn onClick={changePin} disabled={savingPin} style={{ width:'100%' }}>{savingPin ? t('saving') : t('pinTitle')}</Btn>
        </Box>
      )}

      {activeTab === 'pwd' && (
        <Box style={{ maxWidth:400 }}>
          <Inp label={t('currentPwd')} value={pwdForm.currentPassword} onChange={v=>setPwdForm(p=>({...p,currentPassword:v}))} type="password" placeholder="••••••••" />
          <Inp label={t('newPwd')} value={pwdForm.newPassword} onChange={v=>setPwdForm(p=>({...p,newPassword:v}))} type="password" placeholder="••••••••" />
          <Btn onClick={changePwd} disabled={savingPwd} style={{ width:'100%' }}>{savingPwd ? t('saving') : t('changePwd')}</Btn>
        </Box>
      )}
    </div>
  );
};


// ─── Luhn Check côté client ───────────────────────────────────────
const luhnCheck = (pan) => {
  const digits = pan.replace(/\D/g, '').split('').map(Number).reverse();
  const sum = digits.reduce((acc, d, i) => {
    if (i % 2 === 1) { const x = d*2; return acc + (x>9?x-9:x); }
    return acc + d;
  }, 0);
  return sum % 10 === 0;
};

const detectNetwork = (pan) => {
  const p = pan.replace(/\D/g, '');
  if (/^4/.test(p)) return 'visa';
  if (/^5[1-5]|^2[2-7]/.test(p)) return 'mastercard';
  if (/^3[47]/.test(p)) return 'amex';
  return 'unknown';
};

const NETWORK_ICONS = { visa:'💙', mastercard:'🔴', amex:'🟦', unknown:'💳' };
const NETWORK_COLORS = { visa:'#1a1f71', mastercard:'#eb001b', amex:'#2e77bc', unknown:MUTED };

// Formater le numéro en groupes de 4
const formatPan = (v) => v.replace(/\D/g,'').slice(0,19).replace(/(\d{4})(?=\d)/g,'$1 ');
const formatExpiry = (v) => {
  const d = v.replace(/\D/g,'').slice(0,4);
  return d.length > 2 ? d.slice(0,2)+'/'+d.slice(2) : d;
};

// ─── Chiffrement AES-256-GCM côté browser (SubtleCrypto) ─────────
const encryptPan = async (pan, sessionKey) => {
  const keyBytes = new Uint8Array(sessionKey.match(/../g).map(h => parseInt(h,16)));
  const key = await window.crypto.subtle.importKey(
    'raw', keyBytes, { name:'AES-GCM' }, false, ['encrypt']
  );
  const iv   = window.crypto.getRandomValues(new Uint8Array(12));
  const data = new TextEncoder().encode(pan.replace(/\D/g,''));
  const encrypted = await window.crypto.subtle.encrypt({ name:'AES-GCM', iv }, key, data);
  // Les 16 derniers bytes sont le tag GCM
  const encBytes = new Uint8Array(encrypted);
  const ciphertext = encBytes.slice(0, encBytes.length - 16);
  const tag        = encBytes.slice(encBytes.length - 16);
  return {
    iv:   Array.from(iv).map(b=>b.toString(16).padStart(2,'0')).join(''),
    data: Array.from(ciphertext).map(b=>b.toString(16).padStart(2,'0')).join(''),
    tag:  Array.from(tag).map(b=>b.toString(16).padStart(2,'0')).join(''),
  };
};


// ─── GTP Card Page ────────────────────────────────────────────────
const GtpCardPage = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [cards, setCards] = useState([]);
  const [loading, setLoading] = useState(true);
  const [tab, setTab] = useState('cards');
  const [issueForm, setIssueForm] = useState({ firstName:'', lastName:'', dateOfBirth:'', idType:'national_id', idNumber:'', country:'CM' });
  const [issuing, setIssuing] = useState(false);
  const [newCard, setNewCard] = useState(null);
  const [selectedCard, setSelectedCard] = useState(null);
  const [balance, setBalance] = useState(null);
  const [payForm, setPayForm] = useState({ amount:'', merchantName:'', description:'', pin:'', schema:'1' });
  const [paying, setPaying] = useState(false);
  const [payResult, setPayResult] = useState(null);
  const [topupForm, setTopupForm] = useState({ amount:'', operator:'mtn', mmPhone:'' });
  const [toppingUp, setToppingUp] = useState(false);
  const [unloadForm, setUnloadForm] = useState({ amount:'', operator:'mtn', mmPhone:'', pin:'' });
  const [unloading, setUnloading] = useState(false);
  const [txns, setTxns] = useState([]);

  const load = () => {
    setLoading(true);
    api.get('/gtp/cards').then(r => {
      setCards(r.data.data || []);
      if (r.data.data?.length > 0 && !selectedCard) setSelectedCard(r.data.data[0]);
    }).finally(() => setLoading(false));
  };
  useEffect(() => { load(); }, []);

  const loadBalance = async (card) => {
    try {
      const { data } = await api.get(`/gtp/cards/${card.gtp_card_id}`);
      setBalance(data);
    } catch { toast.error('Impossible de récupérer le solde'); }
  };

  const loadTxns = async (card) => {
    try {
      const { data } = await api.get(`/gtp/cards/${card.gtp_card_id}/transactions`);
      setTxns(data.data || []);
    } catch {}
  };

  useEffect(() => {
    if (selectedCard) { loadBalance(selectedCard); loadTxns(selectedCard); }
  }, [selectedCard]);

  const CEMAC = [
    { v:'CM', l:'🇨🇲 Cameroun' }, { v:'CG', l:'🇨🇬 Congo' }, { v:'GA', l:'🇬🇦 Gabon' },
    { v:'CF', l:'🇨🇫 RCA' }, { v:'TD', l:'🇹🇩 Tchad' }, { v:'GQ', l:'🇬🇶 Guinée Éq.' },
  ];

  // ─── Emission carte ───────────────────────────────────────────
  const issueCard = async () => {
    if (!issueForm.firstName || !issueForm.lastName) return toast.error('Nom et prénom requis');
    setIssuing(true);
    try {
      const { data } = await api.post('/gtp/issue', issueForm);
      setNewCard(data.card);
      toast.success(t('gtpIssued'));
      load();
      setTab('cards');
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setIssuing(false); }
  };

  // ─── Paiement ─────────────────────────────────────────────────
  const pay = async () => {
    if (!selectedCard) return;
    if (!payForm.amount || parseFloat(payForm.amount) <= 0) return toast.error(t('amount'));
    if (!payForm.pin || payForm.pin.length !== 4) return toast.error('PIN requis');
    setPaying(true);
    try {
      const endpoint = payForm.schema === '1'
        ? `/gtp/cards/${selectedCard.gtp_card_id}/payment`
        : '/gtp/payment/token';
      const payload = payForm.schema === '1'
        ? { amount: parseFloat(payForm.amount), merchantName: payForm.merchantName, description: payForm.description, pin: payForm.pin }
        : { tokenId: selectedCard.token_id, amount: parseFloat(payForm.amount), merchantName: payForm.merchantName, description: payForm.description, pin: payForm.pin };
      const { data } = await api.post(endpoint, payload);
      setPayResult(data);
      toast.success('Paiement approuvé ✓');
      loadBalance(selectedCard);
    } catch (err) { toast.error(err.response?.data?.error || t('payFailed')); }
    finally { setPaying(false); }
  };

  // ─── Top-up ───────────────────────────────────────────────────
  const doTopup = async () => {
    if (!selectedCard || !topupForm.amount || parseFloat(topupForm.amount) < 500) return toast.error('Min 500 XAF');
    if (!topupForm.mmPhone) return toast.error('Numéro Mobile Money requis');
    setToppingUp(true);
    try {
      const { data } = await api.post(`/gtp/cards/${selectedCard.gtp_card_id}/topup`, { amount: parseFloat(topupForm.amount), operator: topupForm.operator, mmPhone: topupForm.mmPhone });
      toast.success(`Carte rechargée : +${fmtNum(data.credited)} XAF ✓`);
      setTopupForm({ amount:'', operator:'mtn', mmPhone:'' });
      loadBalance(selectedCard);
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setToppingUp(false); }
  };

  // ─── Unload ───────────────────────────────────────────────────
  const doUnload = async () => {
    if (!selectedCard || !unloadForm.amount || parseFloat(unloadForm.amount) < 500) return toast.error('Min 500 XAF');
    if (!unloadForm.pin || unloadForm.pin.length !== 4) return toast.error('PIN requis');
    setUnloading(true);
    try {
      const { data } = await api.post(`/gtp/cards/${selectedCard.gtp_card_id}/unload`, { ...unloadForm, amount: parseFloat(unloadForm.amount) });
      toast.success(`Transféré : ${fmtNum(data.sent)} XAF ✓`);
      setUnloadForm({ amount:'', operator:'mtn', mmPhone:'', pin:'' });
      loadBalance(selectedCard);
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setUnloading(false); }
  };

  // ─── Toggle carte ─────────────────────────────────────────────
  const toggleFreeze = async () => {
    if (!selectedCard) return;
    const action = selectedCard.status === 'active' ? 'freeze' : 'unfreeze';
    try {
      await api.patch(`/gtp/cards/${selectedCard.gtp_card_id}/${action}`);
      toast.success(action === 'freeze' ? '❄️ Carte gelée' : '✅ Carte activée');
      load();
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
  };

  const inp = { width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', fontSize:14, color:TEXT, fontFamily:FONT, boxSizing:'border-box' };
  const sel = { ...inp };

  return (
    <div>
      <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:20 }}>
        <h1 style={{ margin:0, fontSize:22, fontWeight:700, fontFamily:FONT }}>🌍 {t('gtpCard')}</h1>
        <div style={{ display:'flex', alignItems:'center', gap:8 }}>
          <span style={{ background:`${BLUE}15`, border:`1px solid ${BLUE}30`, color:BLUE, borderRadius:20, padding:'4px 12px', fontSize:11, fontWeight:700, fontFamily:FONT }}>GIMAC • CEMAC • XAF</span>
        </div>
      </div>

      {/* Tabs */}
      <div style={{ display:'flex', gap:2, marginBottom:20, background:BG, borderRadius:10, padding:4, width:'fit-content', border:`1px solid ${BORDER}`, flexWrap:'wrap' }}>
        {[['cards','💳 Mes cartes'],['issue','➕ Nouvelle carte'],['pay','💸 Payer'],['topup','⬆️ Recharger'],['unload','⬇️ Transférer'],['txns','📋 Historique']].map(([v,l]) => (
          <button key={v} onClick={()=>setTab(v)} style={{ padding:'7px 16px', borderRadius:8, border:'none', background:tab===v?CARD:'transparent', fontWeight:tab===v?700:400, color:tab===v?P:MUTED, cursor:'pointer', fontSize:12, fontFamily:FONT }}>{l}</button>
        ))}
      </div>

      {/* ── Mes cartes GTP ── */}
      {tab==='cards' && (
        loading ? <Spin /> : cards.length === 0 ? (
          <Box style={{ textAlign:'center', padding:48 }}>
            <div style={{ fontSize:56, marginBottom:16 }}>🌍</div>
            <div style={{ fontSize:16, fontWeight:700, marginBottom:8, fontFamily:FONT }}>Aucune carte C-Pay</div>
            <div style={{ fontSize:13, color:MUTED, marginBottom:20, fontFamily:FONT }}>Émettez votre carte virtuelle GIMAC gratuite</div>
            <Btn onClick={()=>setTab('issue')} color={P}>➕ {t('gtpIssue')}</Btn>
          </Box>
        ) : (
          <div>
            {/* Sélecteur cartes */}
            {cards.length > 1 && (
              <div style={{ display:'flex', gap:10, marginBottom:16, overflowX:'auto' }}>
                {cards.map(c => (
                  <button key={c.gtp_card_id} onClick={()=>setSelectedCard(c)}
                    style={{ background:selectedCard?.gtp_card_id===c.gtp_card_id?`${BLUE}18`:CARD, border:`2px solid ${selectedCard?.gtp_card_id===c.gtp_card_id?BLUE:BORDER}`, borderRadius:10, padding:'10px 16px', cursor:'pointer', fontFamily:FONT, fontSize:12, whiteSpace:'nowrap' }}>
                    💳 {c.pan_masked}
                  </button>
                ))}
              </div>
            )}
            {selectedCard && (
              <>
                {/* Carte GTP visuelle */}
                {/* Carte GTP ISO ID-1 : ratio 85.6/54 */}
                <div style={{ background:`linear-gradient(135deg, ${BLUE}, #0a3060)`, borderRadius:16, padding:0, marginBottom:16, color:'#fff', position:'relative', overflow:'hidden', boxShadow:'0 8px 32px rgba(10,48,96,0.35)', aspectRatio:'85.6/54', width:'100%', maxWidth:480, display:'flex', flexDirection:'column', justifyContent:'space-between' }}>
                  <div style={{ position:'absolute', top:-30, right:-20, width:180, height:180, borderRadius:'50%', background:'rgba(255,255,255,0.06)', pointerEvents:'none' }} />
                  <div style={{ position:'absolute', bottom:-50, left:-10, width:220, height:220, borderRadius:'50%', background:'rgba(18,182,199,0.12)', pointerEvents:'none' }} />
                  {/* Puce EMV */}
                  <div style={{ position:'absolute', top:'30%', left:24, width:40, height:30, borderRadius:6, background:'linear-gradient(135deg,#d4a843,#f0c85a)', border:'1px solid rgba(255,255,255,0.3)' }} />
                  <div style={{ padding:'18px 22px 0', display:'flex', justifyContent:'space-between', alignItems:'flex-start' }}>
                    <div>
                      <div style={{ fontSize:10, opacity:0.7, letterSpacing:2, fontFamily:FONT, fontWeight:700 }}>C-PAY CARD</div>
                      <div style={{ fontSize:9, opacity:0.6, marginTop:2, fontFamily:FONT }}>GIMAC · CEMAC · {selectedCard.country}</div>
                    </div>
                    <div style={{ textAlign:'right' }}>
                      <div style={{ fontSize:10, background:selectedCard.status==='active'?'rgba(0,200,150,0.3)':'rgba(255,100,100,0.3)', borderRadius:12, padding:'2px 10px', fontWeight:700, fontFamily:FONT }}>
                        {selectedCard.status==='active'?'✓ ACTIVE':'❄️ GELÉE'}
                      </div>
                      <div style={{ fontSize:9, opacity:0.6, marginTop:4, fontFamily:FONT }}>{selectedCard.network}</div>
                    </div>
                  </div>
                  <div style={{ padding:'0 22px' }}>
                    <div style={{ fontSize:16, letterSpacing:4, fontFamily:'monospace', fontWeight:600 }}>{selectedCard.pan_masked}</div>
                  </div>
                  <div style={{ padding:'0 22px 18px', display:'flex', justifyContent:'space-between', alignItems:'flex-end' }}>
                    <div>
                      <div style={{ fontSize:8, opacity:0.6, fontFamily:FONT, letterSpacing:1, textTransform:'uppercase', marginBottom:2 }}>SOLDE DISPONIBLE</div>
                      {balance
                        ? <div style={{ fontSize:20, fontWeight:800, fontFamily:FONT, lineHeight:1 }}>{fmtNum(balance.balance)} <span style={{ fontSize:11, opacity:0.8 }}>XAF</span></div>
                        : <div style={{ fontSize:12, opacity:0.6, fontFamily:FONT }}>Chargement…</div>}
                    </div>
                    <div style={{ textAlign:'right' }}>
                      <div style={{ fontSize:8, opacity:0.6, fontFamily:FONT, letterSpacing:1, textTransform:'uppercase', marginBottom:2 }}>TITULAIRE</div>
                      <div style={{ fontSize:10, fontFamily:FONT, fontWeight:600 }}>{selectedCard.cardholder_name}</div>
                      <div style={{ fontSize:9, fontFamily:'monospace', marginTop:2 }}>VALIDE {String(selectedCard.expiry_month).padStart(2,'0')}/{selectedCard.expiry_year}</div>
                    </div>
                  </div>
                </div>

                {/* Actions rapides */}
                <div style={{ display:'grid', gridTemplateColumns:'repeat(3,1fr)', gap:10, marginBottom:16 }}>
                  {[['💸 Payer','pay',P],['⬆️ Recharger','topup',SUCCESS],['⬇️ Transférer','unload',WARNING]].map(([l,v,c]) => (
                    <Btn key={v} onClick={()=>setTab(v)} color={c} style={{ padding:'10px 8px', fontSize:12 }}>{l}</Btn>
                  ))}
                </div>

                {/* Geler/Activer */}
                <Btn onClick={toggleFreeze} color={selectedCard.status==='active'?WARNING:SUCCESS} outline style={{ width:'100%', marginBottom:16 }}>
                  {selectedCard.status==='active' ? '❄️ Geler la carte' : '✅ Activer la carte'}
                </Btn>

                {/* Stats */}
                <div style={{ display:'grid', gridTemplateColumns:'repeat(3,1fr)', gap:12 }}>
                  {[[lang==='fr'?'Dépenses (30j)':'Spending (30d)', fmtNum(selectedCard.month_spent||0), DANGER],[lang==='fr'?"Rechargements":'Top-ups', fmtNum(selectedCard.month_topup||0), SUCCESS],[lang==='fr'?"Transactions":'Transactions', selectedCard.month_count||0, P]].map(([l,v,c]) => (
                    <Box key={l} style={{ padding:14, marginBottom:0 }}>
                      <div style={{ fontSize:10, color:MUTED, marginBottom:4, fontFamily:FONT }}>{l}</div>
                      <div style={{ fontSize:18, fontWeight:700, color:c, fontFamily:FONT }}>{v}</div>
                    </Box>
                  ))}
                </div>
              </>
            )}
          </div>
        )
      )}

      {/* ── Émettre une carte ── */}
      {tab==='issue' && (
        !newCard ? (
          <Box style={{ maxWidth:480 }}>
            <h3 style={{ margin:'0 0 6px', fontFamily:FONT }}>➕ {t('gtpIssue')}</h3>
            <div style={{ fontSize:12, color:MUTED, marginBottom:16, fontFamily:FONT }}>Carte virtuelle Visa/GIMAC · Réseau CEMAC · Valide 3 ans</div>
            <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:12 }}>
              <div>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Prénom *</label>
                <input value={issueForm.firstName} onChange={e=>setIssueForm(f=>({...f,firstName:e.target.value}))} placeholder="JEAN" style={inp} />
              </div>
              <div>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Nom *</label>
                <input value={issueForm.lastName} onChange={e=>setIssueForm(f=>({...f,lastName:e.target.value}))} placeholder="DUPONT" style={inp} />
              </div>
            </div>
            <div style={{ marginBottom:14 }}>
              <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Date de naissance</label>
              <input type="date" value={issueForm.dateOfBirth} onChange={e=>setIssueForm(f=>({...f,dateOfBirth:e.target.value}))} style={inp} />
            </div>
            <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:12, marginBottom:14 }}>
              <div>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Type pièce d'identité</label>
                <select value={issueForm.idType} onChange={e=>setIssueForm(f=>({...f,idType:e.target.value}))} style={sel}>
                  <option value="national_id">CNI</option>
                  <option value="passport">Passeport</option>
                  <option value="drivers_license">Permis</option>
                </select>
              </div>
              <div>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Numéro pièce</label>
                <input value={issueForm.idNumber} onChange={e=>setIssueForm(f=>({...f,idNumber:e.target.value}))} placeholder="123456789" style={inp} />
              </div>
            </div>
            <div style={{ marginBottom:20 }}>
              <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Pays CEMAC *</label>
              <select value={issueForm.country} onChange={e=>setIssueForm(f=>({...f,country:e.target.value}))} style={sel}>
                {CEMAC.map(c => <option key={c.v} value={c.v}>{c.l}</option>)}
              </select>
            </div>
            <div style={{ background:`${BLUE}08`, border:`1px solid ${BLUE}25`, borderRadius:10, padding:12, marginBottom:16, fontSize:12, color:TEXT, fontFamily:FONT }}>
              🌍 <strong>Réseau GIMAC</strong> — Acceptée dans toute la CEMAC chez tous les commerçants affiliés Visa/GIMAC. Émission instantanée.
            </div>
            <Btn onClick={issueCard} disabled={issuing} color={BLUE} style={{ width:'100%', fontSize:15 }}>
              {issuing ? t('gtpIssuing') : `🌍 ${t('gtpIssue')}`}
            </Btn>
          </Box>
        ) : (
          <Box style={{ maxWidth:480, textAlign:'center' }}>
            <div style={{ fontSize:56, marginBottom:12 }}>🎉</div>
            <div style={{ fontSize:18, fontWeight:700, color:SUCCESS, marginBottom:16, fontFamily:FONT }}>{t('gtpIssued')}</div>
            <div style={{ background:`linear-gradient(135deg,${BLUE},#0a3060)`, borderRadius:16, padding:'24px', color:'#fff', marginBottom:20 }}>
              <div style={{ fontSize:10, opacity:0.7, letterSpacing:2, marginBottom:14, fontFamily:FONT }}>C-PAY CARD · GIMAC · CEMAC</div>
              <div style={{ fontSize:18, letterSpacing:4, fontFamily:'monospace', marginBottom:14 }}>{newCard.cardMasked}</div>
              <div style={{ display:'flex', justifyContent:'space-between', fontSize:12 }}>
                <span style={{ fontFamily:FONT }}>{issueForm.firstName} {issueForm.lastName}</span>
                <span style={{ fontFamily:'monospace' }}>{String(newCard.expiryMonth).padStart(2,'0')}/{newCard.expiryYear}</span>
              </div>
            </div>
            {newCard.cvv2 && (
              <div style={{ background:`${WARNING}15`, border:`2px solid ${WARNING}`, borderRadius:10, padding:16, marginBottom:20 }}>
                <div style={{ fontSize:12, fontWeight:700, color:WARNING, marginBottom:8, fontFamily:FONT }}>⚠️ {t('gtpCvvNotice')}</div>
                <div style={{ fontSize:32, fontFamily:'monospace', color:TEXT, fontWeight:700, letterSpacing:8 }}>{newCard.cvv2}</div>
                <div style={{ fontSize:11, color:MUTED, marginTop:6, fontFamily:FONT }}>Code CVV2 — confidentiel</div>
              </div>
            )}
            <Btn onClick={()=>{ setNewCard(null); setTab('cards'); }} color={P} style={{ width:'100%' }}>Voir ma carte</Btn>
          </Box>
        )
      )}

      {/* ── Paiement ── */}
      {tab==='pay' && (
        <Box style={{ maxWidth:480 }}>
          {!selectedCard ? <div style={{ color:MUTED, fontFamily:FONT }}>Aucune carte sélectionnée</div> : !payResult ? (
            <>
              <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>💸 Payer avec C-Pay Card</h3>
              {/* Schéma */}
              <div style={{ marginBottom:16 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>{t('gtpSchemaLabel')}</label>
                <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:8 }}>
                  {[['1',t('gtpSchema1')],['2',t('gtpSchema2')]].map(([v,l]) => (
                    <button key={v} onClick={()=>setPayForm(f=>({...f,schema:v}))}
                      style={{ padding:'10px 8px', borderRadius:8, border:`2px solid ${payForm.schema===v?BLUE:BORDER}`, background:payForm.schema===v?`${BLUE}12`:CARD, color:payForm.schema===v?BLUE:MUTED, cursor:'pointer', fontSize:11, fontFamily:FONT, fontWeight:payForm.schema===v?700:400, textAlign:'center' }}>
                      {l}
                    </button>
                  ))}
                </div>
                <div style={{ fontSize:11, color:MUTED, marginTop:6, fontFamily:FONT }}>
                  {payForm.schema==='1' ? '→ Débite directement la carte GTP via GIMAC' : '→ Utilise votre token CPlus pour payer via GIMAC'}
                </div>
              </div>
              <div style={{ marginBottom:12 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('amount')} (XAF) *</label>
                <input type="number" value={payForm.amount} onChange={e=>setPayForm(f=>({...f,amount:e.target.value}))} placeholder="5000" style={inp} />
              </div>
              <div style={{ marginBottom:12 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Nom du marchand</label>
                <input value={payForm.merchantName} onChange={e=>setPayForm(f=>({...f,merchantName:e.target.value}))} placeholder="BOUTIQUE CENTRALE" style={inp} />
              </div>
              <div style={{ marginBottom:14 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('description')}</label>
                <input value={payForm.description} onChange={e=>setPayForm(f=>({...f,description:e.target.value}))} placeholder="Achat divers" style={inp} />
              </div>
              <div style={{ marginBottom:20 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>PIN (4 chiffres) *</label>
                <PinInput value={payForm.pin} onChange={v=>setPayForm(f=>({...f,pin:v}))} />
              </div>
              <Btn onClick={pay} disabled={paying} color={P} style={{ width:'100%' }}>{paying ? t('paying') : '💸 Confirmer le paiement GIMAC'}</Btn>
            </>
          ) : (
            <div style={{ textAlign:'center' }}>
              <div style={{ fontSize:56 }}>✅</div>
              <div style={{ fontSize:18, fontWeight:700, color:SUCCESS, marginBottom:8, fontFamily:FONT }}>Paiement approuvé</div>
              <div style={{ fontSize:28, fontWeight:800, color:TEXT, marginBottom:4, fontFamily:FONT }}>{fmtNum(payResult.amount)} XAF</div>
              <div style={{ fontSize:13, color:MUTED, marginBottom:4, fontFamily:FONT }}>Auth: {payResult.authCode} · RRN: {payResult.rrn}</div>
              <div style={{ fontSize:12, color:BLUE, marginBottom:4, fontFamily:FONT }}>{payResult.schema==='TOKENIZED'?'🔐 Token CPlus → GIMAC':'🌍 Débit direct GIMAC'}</div>
              <div style={{ fontSize:11, color:MUTED, marginBottom:20, fontFamily:FONT }}>Réseau: {payResult.network}</div>
              <Btn onClick={()=>setPayResult(null)} color={P}>Nouveau paiement</Btn>
            </div>
          )}
        </Box>
      )}

      {/* ── Top-up ── */}
      {tab==='topup' && (
        <Box style={{ maxWidth:480 }}>
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>⬆️ Recharger via Mobile Money</h3>
          <div style={{ marginBottom:12 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('amount')} * (min 500 XAF)</label>
            <input type="number" value={topupForm.amount} onChange={e=>setTopupForm(f=>({...f,amount:e.target.value}))} placeholder="10000" style={inp} />
          </div>
          <div style={{ marginBottom:12 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Opérateur</label>
            <select value={topupForm.operator} onChange={e=>setTopupForm(f=>({...f,operator:e.target.value}))} style={sel}>
              {[['mtn','MTN Mobile Money'],['orange','Orange Money'],['airtel','Airtel Money'],['vodacom','Vodacom M-Pesa']].map(([v,l]) => <option key={v} value={v}>{l}</option>)}
            </select>
          </div>
          <div style={{ marginBottom:16 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Numéro Mobile Money *</label>
            <input value={topupForm.mmPhone} onChange={e=>setTopupForm(f=>({...f,mmPhone:e.target.value}))} placeholder="+237XXXXXXXXX" style={inp} />
          </div>
          {topupForm.amount && parseFloat(topupForm.amount) >= 500 && (
            <div style={{ background:`${SUCCESS}10`, border:`1px solid ${SUCCESS}30`, borderRadius:8, padding:10, marginBottom:16, fontSize:12, fontFamily:FONT }}>
              💰 Crédité sur votre carte : <strong>{fmtNum(Math.round(parseFloat(topupForm.amount)*0.99))} XAF</strong> (frais 1%)
            </div>
          )}
          <Btn onClick={doTopup} disabled={toppingUp} color={SUCCESS} style={{ width:'100%' }}>{toppingUp ? t('toppingUp') : '⬆️ Recharger la C-Pay Card'}</Btn>
        </Box>
      )}

      {/* ── Unload ── */}
      {tab==='unload' && (
        <Box style={{ maxWidth:480 }}>
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>⬇️ Transférer vers Mobile Money</h3>
          <div style={{ marginBottom:12 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('amount')} * (min 500 XAF)</label>
            <input type="number" value={unloadForm.amount} onChange={e=>setUnloadForm(f=>({...f,amount:e.target.value}))} placeholder="10000" style={inp} />
          </div>
          <div style={{ marginBottom:12 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Opérateur</label>
            <select value={unloadForm.operator} onChange={e=>setUnloadForm(f=>({...f,operator:e.target.value}))} style={sel}>
              {[['mtn','MTN Mobile Money'],['orange','Orange Money'],['airtel','Airtel Money'],['vodacom','Vodacom M-Pesa']].map(([v,l]) => <option key={v} value={v}>{l}</option>)}
            </select>
          </div>
          <div style={{ marginBottom:12 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>Numéro Mobile Money *</label>
            <input value={unloadForm.mmPhone} onChange={e=>setUnloadForm(f=>({...f,mmPhone:e.target.value}))} placeholder="+237XXXXXXXXX" style={inp} />
          </div>
          <div style={{ marginBottom:20 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>PIN *</label>
            <PinInput value={unloadForm.pin} onChange={v=>setUnloadForm(f=>({...f,pin:v}))} />
          </div>
          <Btn onClick={doUnload} disabled={unloading} color={WARNING} style={{ width:'100%' }}>{unloading ? t('unloading') : '⬇️ Transférer'}</Btn>
        </Box>
      )}

      {/* ── Historique GTP ── */}
      {tab==='txns' && (
        <Box>
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>📋 Transactions GIMAC</h3>
          {txns.length === 0 ? <div style={{ color:MUTED, fontSize:13, textAlign:'center', padding:32, fontFamily:FONT }}>Aucune transaction GTP</div>
          : txns.map((txn, i) => (
            <div key={txn.txn_id||i} style={{ display:'flex', alignItems:'center', gap:12, padding:'10px 0', borderBottom:`1px solid ${BORDER}` }}>
              <div style={{ width:40, height:40, borderRadius:12, background:`${sc(txn.type)}18`, display:'flex', alignItems:'center', justifyContent:'center', fontSize:18 }}>
                {txn.type==='payment'?'💸':txn.type==='topup'?'⬆️':'⬇️'}
              </div>
              <div style={{ flex:1 }}>
                <div style={{ fontSize:13, fontWeight:600, color:TEXT, fontFamily:FONT }}>{txn.merchant_name || txn.type}</div>
                <div style={{ fontSize:11, color:MUTED, fontFamily:FONT }}>{txn.auth_code} · {fmtDate(txn.created_at, lang)}</div>
              </div>
              <div style={{ textAlign:'right' }}>
                <div style={{ fontSize:15, fontWeight:700, color:txn.type==='topup'?SUCCESS:DANGER, fontFamily:FONT }}>
                  {txn.type==='topup'?'+':'-'}{fmtNum(txn.amount)} XAF
                </div>
                <Badge label={txn.response_code==='00'?'OK':txn.response_code||txn.status} color={txn.response_code==='00'?SUCCESS:DANGER} />
              </div>
            </div>
          ))}
        </Box>
      )}
    </div>
  );
};

// ─── EnrollForm ───────────────────────────────────────────────────
const EnrollForm = ({ lang, onSuccess, onCancel }) => {
  const t = k => T[lang][k] || k;
  const [pan, setPan]         = useState('');
  const [expiry, setExpiry]   = useState('');
  const [cvv, setCvv]         = useState('');
  const [name, setName]       = useState('');
  const [loading, setLoading] = useState(false);
  const [panError, setPanError] = useState('');

  const network = detectNetwork(pan);
  const panClean = pan.replace(/\D/g,'');
  const panValid = panClean.length >= 13 && luhnCheck(panClean);

  const handlePan = (v) => {
    const formatted = formatPan(v);
    setPan(formatted);
    const clean = formatted.replace(/\D/g,'');
    if (clean.length >= 13) setPanError(luhnCheck(clean) ? '' : t('luhnError'));
    else setPanError('');
  };

  const submit = async () => {
    // Validations côté client
    if (!panValid) return toast.error(t('luhnError'));
    const [expM, expY] = expiry.split('/');
    if (!expM || !expY || expY.length < 2) return toast.error(t('expiry'));
    if (!cvv || cvv.length < 3) return toast.error(t('cvvRequired'));
    setLoading(true);
    try {
      // 1. Obtenir la session key du serveur
      const { data: keyData } = await api.get('/cards/session-key');

      // 2. Chiffrer le PAN avec SubtleCrypto (jamais en clair sur le réseau)
      const encrypted = await encryptPan(panClean, keyData.sessionKey);

      // 3. Envoyer le PAN chiffré + métadonnées non-sensibles
      const { data } = await api.post('/cards/enroll', {
        encryptedPan: { keyId: keyData.keyId, ...encrypted },
        expiryMonth:  parseInt(expM),
        expiryYear:   parseInt('20'+expY.slice(-2)),
        cardholderName: name.trim() || undefined,
        cvvProvided:  true, // boolean uniquement — CVV jamais transmis
      });

      // 4. Zéroïser les variables sensibles
      setPan(''); setCvv(''); setExpiry(''); setName('');

      toast.success(t('enrollSuccess'));
      onSuccess(data.card);
    } catch (err) {
      const code = err.response?.data?.code;
      const msg  = err.response?.data?.error;
      if (code === 'CARD_ALREADY_ENROLLED') toast.error(t('enrollErrorDup'));
      else if (code === 'LUHN_FAILED') toast.error(t('luhnError'));
      else if (code === 'CARD_EXPIRED') toast.error(t('enrollErrorExp'));
      else toast.error(msg || t('error'));
    } finally { setLoading(false); }
  };

  return (
    <div>
      {/* Banner sécurité */}
      <div style={{ display:'flex', alignItems:'center', gap:8, background:`${SUCCESS}10`, border:`1px solid ${SUCCESS}30`, borderRadius:8, padding:'8px 12px', marginBottom:16, fontSize:11, color:SUCCESS }}>
        🔒 {t('secureInput')}
      </div>

      {/* Prévisualisation carte */}
      <div style={{ background:network==='visa'?'linear-gradient(135deg,#1a1f71,#12b6c7)':network==='mastercard'?'linear-gradient(135deg,#eb001b,#f79e1b)':'linear-gradient(135deg,#1d4f92,#12b6c7)', borderRadius:14, padding:'20px 22px', marginBottom:20, color:'#fff', fontFamily:'monospace', boxShadow:'0 6px 24px rgba(0,0,0,0.2)' }}>
        <div style={{ display:'flex', justifyContent:'space-between', marginBottom:16 }}>
          <span style={{ fontSize:12, opacity:0.8, fontFamily:FONT }}>Calculus Plus</span>
          <span style={{ fontSize:18 }}>{NETWORK_ICONS[network]}</span>
        </div>
        <div style={{ fontSize:20, letterSpacing:3, marginBottom:16 }}>
          {pan || '•••• •••• •••• ••••'}
        </div>
        <div style={{ display:'flex', justifyContent:'space-between', fontSize:13 }}>
          <span style={{ fontFamily:FONT }}>{name || 'VOTRE NOM'}</span>
          <span>{expiry || 'MM/AA'}</span>
        </div>
      </div>

      {/* Numéro de carte */}
      <div style={{ marginBottom:14 }}>
        <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('cardNumber')} *</label>
        <div style={{ position:'relative' }}>
          <input
            value={pan} onChange={e=>handlePan(e.target.value)}
            maxLength={23} placeholder="1234 5678 9012 3456"
            inputMode="numeric" autoComplete="cc-number"
            style={{ width:'100%', background:BG, border:`2px solid ${panError?DANGER:panValid&&pan?SUCCESS:BORDER}`, borderRadius:8, padding:'11px 44px 11px 12px', fontSize:16, letterSpacing:2, fontFamily:'monospace', boxSizing:'border-box', color:TEXT }}
          />
          <span style={{ position:'absolute', right:12, top:'50%', transform:'translateY(-50%)', fontSize:18 }}>{NETWORK_ICONS[network]}</span>
        </div>
        {panError && <div style={{ fontSize:11, color:DANGER, marginTop:4, fontFamily:FONT }}>{panError}</div>}
        {panValid && <div style={{ fontSize:11, color:SUCCESS, marginTop:4, fontFamily:FONT }}>✓ Numéro valide</div>}
      </div>

      <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:12, marginBottom:14 }}>
        <div>
          <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('expiry')} *</label>
          <input
            value={expiry} onChange={e=>setExpiry(formatExpiry(e.target.value))}
            maxLength={5} placeholder="MM/AA" inputMode="numeric" autoComplete="cc-exp"
            style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'11px 12px', fontSize:14, fontFamily:'monospace', boxSizing:'border-box', color:TEXT }}
          />
        </div>
        <div>
          <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('cvvLabel')} *</label>
          <input
            value={cvv} onChange={e=>setCvv(e.target.value.replace(/\D/g,'').slice(0,4))}
            maxLength={4} placeholder="•••" type="password" inputMode="numeric" autoComplete="cc-csc"
            style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'11px 12px', fontSize:14, fontFamily:'monospace', boxSizing:'border-box', color:TEXT }}
          />
          <div style={{ fontSize:10, color:MUTED, marginTop:3, fontFamily:FONT }}>{t('cvvHint')}</div>
        </div>
      </div>

      <div style={{ marginBottom:20 }}>
        <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('cardName')}</label>
        <input
          value={name} onChange={e=>setName(e.target.value.toUpperCase())}
          placeholder="JEAN DUPONT" autoComplete="cc-name"
          style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'11px 12px', fontSize:14, fontFamily:'monospace', boxSizing:'border-box', color:TEXT }}
        />
      </div>

      <div style={{ background:`${BLUE}08`, border:`1px solid ${BLUE}20`, borderRadius:8, padding:'10px 14px', marginBottom:16, fontSize:11, color:MUTED, fontFamily:FONT }}>
        🛡️ {lang==='fr'?"Le CVV n'est jamais transmis ni stocké. Le numéro de carte est chiffré AES-256-GCM avant envoi.":"CVV is never transmitted or stored. Card number is AES-256-GCM encrypted before sending."}
      </div>

      <div style={{ display:'flex', gap:10 }}>
        <Btn onClick={onCancel} outline color={MUTED} style={{ flex:1 }}>{lang==='fr'?'Annuler':'Cancel'}</Btn>
        <Btn onClick={submit} disabled={loading||!panValid} color={P} style={{ flex:2 }}>
          {loading ? t('enrolling') : `🔐 ${t('enrollCard')}`}
        </Btn>
      </div>
    </div>
  );
};

// ─── MyCards ──────────────────────────────────────────────────────
// ─── TRANSFERT ────────────────────────────────────────────────────
const Transfer = ({ lang }) => {
  const t = k => T[lang][k] || k;
  // Mode : card2momo | momo2card | card2card | momo2momo
  const [mode, setMode]       = useState('card2momo');
  const [loading, setLoading] = useState(false);
  const [result, setResult]   = useState(null);
  const [myCards, setMyCards] = useState([]);

  // Source
  const [srcCard, setSrcCard]   = useState('');   // cardId si source=carte
  const [srcPhone, setSrcPhone] = useState('');   // numéro si source=momo
  const [srcOp, setSrcOp]       = useState('mtn');
  const [srcCheck, setSrcCheck] = useState(null);
  const [srcTimer, setSrcTimer] = useState(null);

  // Destination
  const [dstCard, setDstCard]   = useState('');   // cardId ou numéro carte
  const [dstPhone, setDstPhone] = useState('');   // numéro si dest=momo
  const [dstOp, setDstOp]       = useState('mtn');
  const [dstCheck, setDstCheck] = useState(null);
  const [dstTimer, setDstTimer] = useState(null);

  const [amount, setAmount]   = useState('');
  const [pin, setPin]         = useState('');

  useEffect(() => {
    api.get('/card').then(r => {
      setMyCards([{ cardId: r.data.cardId, label: r.data.cardMasked, balance: r.data.balance, currency: r.data.currency }]);
      setSrcCard(r.data.cardId);
    }).catch(() => {});
  }, []);

  // Vérification numéro MoMo
  const checkPhone = (val, setCheck, setTimer, timer) => {
    setCheck(null);
    if (timer) clearTimeout(timer);
    const clean = val.replace(/\D/g,'');
    if (clean.length >= 9) {
      setCheck('checking');
      const t = setTimeout(async () => {
        try {
          const BASE = process.env.REACT_APP_API_BASE_URL || '';
          const { data } = await axios.get(`${BASE}/api/v1/momo/validate/${clean}`,
            { headers: { Authorization: `Bearer ${localStorage.getItem('ch_token')}` } }
          );
          setCheck(data.active ? 'valid' : 'invalid');
        } catch { setCheck('invalid'); }
      }, 800);
      setTimer(t);
    }
  };

  const MODES = [
    { v:'card2momo', srcLabel: lang==='fr'?'💳 Ma Carte (source)':'💳 My Card (source)',
                     dstLabel: lang==='fr'?'📱 Numéro MoMo (destinataire)':'📱 MoMo number (recipient)',
                     icon:'💳→📱', label: lang==='fr'?'Carte → MoMo':'Card → MoMo', fee:'1.5%' },
    { v:'momo2card', srcLabel: lang==='fr'?'📱 Numéro MoMo (source)':'📱 MoMo number (source)',
                     dstLabel: lang==='fr'?'💳 Ma Carte (destination)':'💳 My Card (destination)',
                     icon:'📱→💳', label: lang==='fr'?'MoMo → Carte':'MoMo → Card', fee:'1%' },
    { v:'card2card', srcLabel: lang==='fr'?'💳 Ma Carte (source)':'💳 My Card (source)',
                     dstLabel: lang==='fr'?'💳 Numéro carte destinataire':'💳 Recipient card number',
                     icon:'💳→💳', label: lang==='fr'?'Carte → Carte':'Card → Card', fee:'0%' },
    { v:'momo2momo', srcLabel: lang==='fr'?'📱 Mon numéro MoMo (source)':'📱 My MoMo (source)',
                     dstLabel: lang==='fr'?'📱 Numéro MoMo destinataire':'📱 Recipient MoMo number',
                     icon:'📱→📱', label: 'MoMo → MoMo', fee:'Op.' },
  ];

  const currentMode = MODES.find(m=>m.v===mode);
  const srcIsCard   = mode === 'card2momo' || mode === 'card2card';
  const dstIsCard   = mode === 'momo2card' || mode === 'card2card';
  const srcIsMomo   = mode === 'momo2card' || mode === 'momo2momo';
  const dstIsMomo   = mode === 'card2momo' || mode === 'momo2momo';
  const needsPin    = srcIsCard;

  const PhoneField = ({ label, value, onChange, check, op, setOp, name }) => (
    <div style={{ marginBottom:14 }}>
      <Sel label={lang==='fr'?'Opérateur':'Operator'} value={op} onChange={v=>{setOp(v);onChange('');}} options={OPERATORS.map(o=>({v:o.v,l:o.l}))} />
      <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{label} *</label>
      <div style={{ position:'relative' }}>
        <input value={value} onChange={e=>onChange(e.target.value)}
          placeholder={op==='mtn'?'+242 06X XXX XXX':'+242 04X XXX XXX'}
          type="tel" autoComplete="off" name={name} inputMode="numeric"
          style={{ width:'100%', background:BG, border:`2px solid ${check==='valid'?SUCCESS:check==='invalid'?DANGER:BORDER}`, borderRadius:8, padding:'10px 44px 10px 12px', fontSize:14, color:TEXT, fontFamily:FONT, boxSizing:'border-box', outline:'none' }} />
        <span style={{ position:'absolute', right:12, top:'50%', transform:'translateY(-50%)', fontSize:16 }}>
          {check==='checking'&&'⏳'}{check==='valid'&&'✅'}{check==='invalid'&&'❌'}
        </span>
      </div>
      {check==='valid'   && <div style={{ fontSize:11, color:SUCCESS, marginTop:4, fontFamily:FONT }}>✓ Numéro {OPERATORS.find(o=>o.v===op)?.l} actif</div>}
      {check==='invalid' && <div style={{ fontSize:11, color:DANGER,  marginTop:4, fontFamily:FONT }}>✗ Numéro non reconnu</div>}
    </div>
  );

  const submit = async () => {
    if (!amount || parseFloat(amount) < 500) return toast.error('Montant minimum 500 XAF');
    if (needsPin && (!pin || pin.length !== 4)) return toast.error(t('pinInvalid'));
    setLoading(true);
    try {
      const BASE = process.env.REACT_APP_API_BASE_URL || '';
      const headers = { Authorization: `Bearer ${localStorage.getItem('ch_token')}`, 'Content-Type':'application/json' };
      const amt = parseFloat(amount);
      let data;

      if (mode === 'card2momo') {
        const r = await axios.post(`${BASE}/api/v1/momo/payout`,
          { amount: amt, phone: dstPhone.replace(/\D/g,''), pin, cardId: srcCard }, { headers });
        data = r.data;
      } else if (mode === 'momo2card') {
        const r = await axios.post(`${BASE}/api/v1/momo/topup`,
          { amount: amt, phone: srcPhone.replace(/\D/g,''), cardId: dstCard || srcCard }, { headers });
        data = r.data;
      } else if (mode === 'card2card') {
        const r = await api.post('/transfer/card2card', { amount: amt, targetCardNumber: dstCard, pin });
        data = r.data;
      } else {
        const r = await axios.post(`${BASE}/api/v1/momo/requesttopay`,
          { amount: amt, phone: dstPhone.replace(/\D/g,''), description: `MoMo → MoMo ${amt} XAF` }, { headers });
        data = r.data;
      }

      setResult({ ...data, amount: amt, mode });
      toast.success(lang==='fr'?'Transfert initié !':'Transfer initiated!');
    } catch (err) {
      toast.error(err.response?.data?.error || t('error'));
    } finally { setLoading(false); }
  };

  const reset = () => {
    setResult(null); setAmount(''); setPin('');
    setSrcPhone(''); setDstPhone(''); setDstCard('');
    setSrcCheck(null); setDstCheck(null);
  };

  const feeAmt = amount && parseFloat(amount) >= 500 ? {
    'card2momo': Math.round(parseFloat(amount)*0.985),
    'momo2card': Math.round(parseFloat(amount)*0.99),
    'card2card': parseFloat(amount),
    'momo2momo': parseFloat(amount),
  }[mode] : 0;

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>🔄 {lang==='fr'?'Transfert':'Transfer'}</h1>
      {!result ? (
        <Box style={{ maxWidth:480 }}>

          {/* Sélecteur mode */}
          <div style={{ marginBottom:20 }}>
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:8, fontFamily:FONT }}>
              {lang==='fr'?'Type de transfert':'Transfer type'} *
            </label>
            <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:8 }}>
              {MODES.map(m => (
                <button key={m.v} onClick={()=>{setMode(m.v);reset();}}
                  style={{ padding:'12px 8px', borderRadius:10, border:`2px solid ${mode===m.v?P:BORDER}`, background:mode===m.v?`${P}10`:CARD, cursor:'pointer', fontFamily:FONT, textAlign:'center' }}>
                  <div style={{ fontSize:22, marginBottom:4 }}>{m.icon}</div>
                  <div style={{ fontSize:11, fontWeight:mode===m.v?700:400, color:mode===m.v?P:MUTED }}>{m.label}</div>
                  <div style={{ fontSize:10, color:MUTED, marginTop:2 }}>Frais {m.fee}</div>
                </button>
              ))}
            </div>
          </div>

          {/* ─── SOURCE ─── */}
          <div style={{ background:`${P}06`, border:`1px solid ${P}20`, borderRadius:10, padding:'14px 14px 4px', marginBottom:14 }}>
            <div style={{ fontSize:11, fontWeight:700, color:P, marginBottom:10, letterSpacing:1, textTransform:'uppercase', fontFamily:FONT }}>
              {lang==='fr'?'▲ Source (à débiter)':'▲ Source (to debit)'}
            </div>
            {srcIsCard && myCards.length > 0 && (
              <div style={{ marginBottom:12 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>{currentMode.srcLabel}</label>
                {myCards.map(c => (
                  <button key={c.cardId} onClick={()=>setSrcCard(c.cardId)}
                    style={{ display:'flex', alignItems:'center', gap:10, padding:'10px 12px', borderRadius:10, border:`2px solid ${srcCard===c.cardId?P:BORDER}`, background:srcCard===c.cardId?`${P}10`:CARD, cursor:'pointer', width:'100%', marginBottom:6 }}>
                    <span>💳</span>
                    <div style={{ flex:1, textAlign:'left' }}>
                      <div style={{ fontSize:13, fontWeight:600, fontFamily:FONT, color:TEXT }}>{c.label}</div>
                      <div style={{ fontSize:11, color:MUTED, fontFamily:FONT }}>{fmtNum(c.balance)} {c.currency}</div>
                    </div>
                    {srcCard===c.cardId && <span style={{ color:P }}>✓</span>}
                  </button>
                ))}
              </div>
            )}
            {srcIsMomo && (
              <PhoneField label={currentMode.srcLabel} value={srcPhone}
                onChange={v=>{setSrcPhone(v);checkPhone(v,setSrcCheck,setSrcTimer,srcTimer);}}
                check={srcCheck} op={srcOp} setOp={setSrcOp} name="src_phone" />
            )}
          </div>

          {/* ─── DESTINATION ─── */}
          <div style={{ background:`${SUCCESS}06`, border:`1px solid ${SUCCESS}25`, borderRadius:10, padding:'14px 14px 4px', marginBottom:14 }}>
            <div style={{ fontSize:11, fontWeight:700, color:SUCCESS, marginBottom:10, letterSpacing:1, textTransform:'uppercase', fontFamily:FONT }}>
              {lang==='fr'?'▼ Destination (à créditer)':'▼ Destination (to credit)'}
            </div>
            {dstIsCard && mode === 'momo2card' && myCards.length > 0 && (
              <div style={{ marginBottom:12 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>{currentMode.dstLabel}</label>
                {myCards.map(c => (
                  <button key={c.cardId} onClick={()=>setDstCard(c.cardId)}
                    style={{ display:'flex', alignItems:'center', gap:10, padding:'10px 12px', borderRadius:10, border:`2px solid ${dstCard===c.cardId?SUCCESS:BORDER}`, background:dstCard===c.cardId?`${SUCCESS}10`:CARD, cursor:'pointer', width:'100%', marginBottom:6 }}>
                    <span>💳</span>
                    <div style={{ flex:1, textAlign:'left' }}>
                      <div style={{ fontSize:13, fontWeight:600, fontFamily:FONT, color:TEXT }}>{c.label}</div>
                      <div style={{ fontSize:11, color:MUTED, fontFamily:FONT }}>{fmtNum(c.balance)} {c.currency}</div>
                    </div>
                    {dstCard===c.cardId && <span style={{ color:SUCCESS }}>✓</span>}
                  </button>
                ))}
              </div>
            )}
            {mode === 'card2card' && (
              <div style={{ marginBottom:12 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{currentMode.dstLabel} *</label>
                <input value={dstCard} onChange={e=>setDstCard(e.target.value)}
                  placeholder="4111 **** **** XXXX" type="tel" autoComplete="off" inputMode="numeric"
                  style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', fontSize:14, color:TEXT, fontFamily:FONT, boxSizing:'border-box', outline:'none', marginBottom:8 }} />
              </div>
            )}
            {dstIsMomo && (
              <PhoneField label={currentMode.dstLabel} value={dstPhone}
                onChange={v=>{setDstPhone(v);checkPhone(v,setDstCheck,setDstTimer,dstTimer);}}
                check={dstCheck} op={dstOp} setOp={setDstOp} name="dst_phone" />
            )}
          </div>

          {/* Montant + PIN */}
          <Inp label={`${t('amount')} * (min. 500 XAF)`} value={amount} onChange={setAmount} type="number" placeholder="5000" />
          {needsPin && (
            <div style={{ marginBottom:14 }}>
              <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('pin')} *</label>
              <PinInput value={pin} onChange={setPin} />
            </div>
          )}

          {/* Résumé */}
          {feeAmt > 0 && (
            <div style={{ background:`${P}08`, border:`1px solid ${P}20`, borderRadius:8, padding:12, marginBottom:16, fontSize:12, color:TEXT, fontFamily:FONT }}>
              💰 {lang==='fr'?'Montant reçu':'Amount received'} : <strong>{fmtNum(feeAmt)} XAF</strong>
              {' · '}Frais : <strong>{fmtNum(parseFloat(amount)-feeAmt)} XAF</strong> ({currentMode.fee})
            </div>
          )}

          <Btn onClick={submit} disabled={loading} style={{ width:'100%' }}>
            {loading ? (lang==='fr'?'Transfert en cours…':'Transferring…') : (lang==='fr'?'Confirmer le transfert':'Confirm transfer')}
          </Btn>
        </Box>
      ) : (
        <Box style={{ maxWidth:480, textAlign:'center' }}>
          <div style={{ fontSize:56, marginBottom:12 }}>✅</div>
          <div style={{ fontSize:20, fontWeight:700, color:SUCCESS, marginBottom:8, fontFamily:FONT }}>
            {lang==='fr'?'Transfert initié !':'Transfer initiated!'}
          </div>
          <div style={{ fontSize:32, fontWeight:800, color:TEXT, marginBottom:4, fontFamily:FONT }}>
            {fmtNum(result.amount)} XAF
          </div>
          {result.referenceId && (
            <div style={{ fontSize:11, color:MUTED, fontFamily:'monospace', marginBottom:8 }}>
              Réf: {result.referenceId}
            </div>
          )}
          {result.newBalance !== undefined && (
            <div style={{ fontSize:13, color:P, fontWeight:700, marginBottom:16, fontFamily:FONT }}>
              {lang==='fr'?'Nouveau solde':'New balance'} : {fmtNum(result.newBalance)} XAF
            </div>
          )}
          {result.status === 'PENDING' && (
            <div style={{ fontSize:12, color:WARNING, marginBottom:16, fontFamily:FONT }}>
              ⏳ {lang==='fr'?'En attente de confirmation MoMo':'Waiting for MoMo confirmation'}
            </div>
          )}
          <Btn onClick={reset} color={P}>{lang==='fr'?'Nouveau transfert':'New transfer'}</Btn>
        </Box>
      )}
    </div>
  );
};


// ─── CARDS UNIFIED — Mes Cartes (Enrollment + GTP) ────────────────
const CardsUnified = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [tab, setTab] = useState('enrolled'); // enrolled | gtp

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>💳 {lang==='fr'?'Mes Cartes':'My Cards'}</h1>

      {/* Onglets */}
      <div style={{ display:'flex', gap:0, marginBottom:24, background:BG, borderRadius:12, padding:4 }}>
        <button onClick={()=>setTab('enrolled')}
          style={{ flex:1, padding:'10px', borderRadius:10, border:'none', background:tab==='enrolled'?CARD:'transparent', fontWeight:tab==='enrolled'?700:400, color:tab==='enrolled'?P:MUTED, cursor:'pointer', fontSize:13, fontFamily:FONT, boxShadow:tab==='enrolled'?'0 2px 8px rgba(0,0,0,0.08)':'none' }}>
          🔐 {lang==='fr'?'Cartes enregistrées':'Enrolled cards'}
        </button>
        <button onClick={()=>setTab('gtp')}
          style={{ flex:1, padding:'10px', borderRadius:10, border:'none', background:tab==='gtp'?CARD:'transparent', fontWeight:tab==='gtp'?700:400, color:tab==='gtp'?P:MUTED, cursor:'pointer', fontSize:13, fontFamily:FONT, boxShadow:tab==='gtp'?'0 2px 8px rgba(0,0,0,0.08)':'none' }}>
          🌍 {lang==='fr'?'Carte GTP/GIMAC':'GTP/GIMAC Card'}
        </button>
      </div>

      {tab === 'enrolled' && <MyCards lang={lang} />}
      {tab === 'gtp'      && <GtpCardPage lang={lang} />}
    </div>
  );
};


// ─── PAGE CARTE — Cartes disponibles + Historique ─────────────────
const CardsPage = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [card, setCard]     = useState(null);
  const [txns, setTxns]     = useState([]);
  const [loading, setLoading] = useState(true);
  const [tab, setTab]       = useState('carte'); // carte|history

  useEffect(() => {
    Promise.all([
      api.get('/card'),
      api.get('/transactions?limit=20&page=1'),
    ]).then(([cRes, tRes]) => {
      setCard(cRes.data);
      setTxns(tRes.data.data || []);
    }).catch(() => toast.error(t('error')))
    .finally(() => setLoading(false));
  }, []);

  if (loading) return <Spin />;

  const isFrozen = card?.status === 'frozen';

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>💳 {lang==='fr'?'Ma Carte':'My Card'}</h1>

      {/* Tabs */}
      <div style={{ display:'flex', gap:8, marginBottom:20, background:BG, borderRadius:12, padding:4 }}>
        {[['carte', lang==='fr'?'💳 Carte':'💳 Card'], ['history', lang==='fr'?'📋 Historique':'📋 History']].map(([v,l]) => (
          <button key={v} onClick={()=>setTab(v)}
            style={{ flex:1, padding:'9px', borderRadius:10, border:'none', background:tab===v?CARD:'transparent', fontWeight:tab===v?700:400, color:tab===v?P:MUTED, cursor:'pointer', fontSize:13, fontFamily:FONT, boxShadow:tab===v?'0 2px 8px rgba(0,0,0,0.08)':'none' }}>{l}</button>
        ))}
      </div>

      {tab === 'carte' && card && (
        <div>
          {/* Carte ISO ID-1 */}
          <div style={{ background:isFrozen?`linear-gradient(135deg,${MUTED},#8a9ab0)`:`linear-gradient(135deg,${BLUE},${P})`, borderRadius:16, padding:0, marginBottom:20, color:'#fff', position:'relative', overflow:'hidden', boxShadow:'0 8px 32px rgba(29,79,146,0.25)', aspectRatio:'85.6/54', width:'100%', maxWidth:480, display:'flex', flexDirection:'column', justifyContent:'space-between' }}>
            <div style={{ position:'absolute', top:-40, right:-40, width:180, height:180, borderRadius:'50%', background:'rgba(255,255,255,0.07)', pointerEvents:'none' }} />
            <div style={{ position:'absolute', bottom:-50, left:-30, width:220, height:220, borderRadius:'50%', background:'rgba(255,255,255,0.05)', pointerEvents:'none' }} />
            <div style={{ position:'absolute', top:'30%', left:24, width:40, height:30, borderRadius:6, background:'linear-gradient(135deg,#d4a843,#f0c85a)', border:'1px solid rgba(255,255,255,0.3)' }} />
            <div style={{ padding:'18px 22px 0', display:'flex', justifyContent:'space-between', alignItems:'flex-start' }}>
              <div>
                <div style={{ fontSize:10, opacity:0.75, letterSpacing:2, textTransform:'uppercase', fontFamily:FONT, fontWeight:700 }}>Calculus Plus</div>
                <div style={{ fontSize:10, opacity:0.7, marginTop:2, fontFamily:FONT }}>{card.network?.toUpperCase()||'VISA'}</div>
              </div>
              <div style={{ background:'rgba(255,255,255,0.15)', borderRadius:6, padding:'3px 10px', fontSize:10, fontWeight:700, fontFamily:FONT }}>{isFrozen?t('cardFrozen'):t('cardActive')}</div>
            </div>
            <div style={{ padding:'0 22px' }}>
              <div style={{ fontSize:17, letterSpacing:4, fontFamily:'monospace', fontWeight:600 }}>{card.cardMasked}</div>
            </div>
            <div style={{ padding:'0 22px 18px', display:'flex', justifyContent:'space-between', alignItems:'flex-end' }}>
              <div>
                <div style={{ fontSize:8, opacity:0.65, fontFamily:FONT, letterSpacing:1, textTransform:'uppercase', marginBottom:2 }}>{t('cardBalance')}</div>
                <div style={{ fontSize:22, fontWeight:800, fontFamily:FONT, lineHeight:1 }}>{fmtNum(card.balance)} <span style={{ fontSize:12, opacity:0.85 }}>{card.currency}</span></div>
              </div>
              <div style={{ textAlign:'right' }}>
                <div style={{ fontSize:8, opacity:0.65, fontFamily:FONT, letterSpacing:1, textTransform:'uppercase', marginBottom:2 }}>TITULAIRE</div>
                <div style={{ fontSize:10, fontFamily:FONT, fontWeight:600 }}>{card.cardholder?.firstName} {card.cardholder?.lastName}</div>
                <div style={{ fontSize:9, opacity:0.8, fontFamily:'monospace', marginTop:2 }}>VALIDE {String(card.expiryMonth).padStart(2,'0')}/{card.expiryYear}</div>
              </div>
            </div>
          </div>

          {/* Infos carte */}
          <Box style={{ marginBottom:16 }}>
            <div style={{ fontSize:14, fontWeight:700, marginBottom:12, fontFamily:FONT }}>Informations</div>
            {[
              ['Numéro masqué', card.cardMasked],
              ['Réseau', card.network?.toUpperCase()],
              ['Statut', isFrozen ? '❄️ Gelée' : '✅ Active'],
              ['Limite journalière', `${fmtNum(card.dailyLimit)} XAF`],
              ['Limite mensuelle', `${fmtNum(card.monthlyLimit)} XAF`],
              ['Expiration', `${String(card.expiryMonth).padStart(2,'0')}/${card.expiryYear}`],
            ].map(([k,v]) => (
              <div key={k} style={{ display:'flex', justifyContent:'space-between', padding:'8px 0', borderBottom:`1px solid ${BORDER}`, fontSize:13, fontFamily:FONT }}>
                <span style={{ color:MUTED }}>{k}</span>
                <span style={{ fontWeight:600, color:TEXT }}>{v}</span>
              </div>
            ))}
          </Box>

          {/* Actions rapides */}
          <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:10 }}>
            <Link to="/topup"   style={{ display:'flex', alignItems:'center', justifyContent:'center', gap:6, background:SUCCESS, color:'#fff', borderRadius:10, padding:'12px', textDecoration:'none', fontSize:13, fontWeight:700, fontFamily:FONT }}>⬆️ {t('topup')}</Link>
            <Link to="/unload"  style={{ display:'flex', alignItems:'center', justifyContent:'center', gap:6, background:WARNING, color:'#fff', borderRadius:10, padding:'12px', textDecoration:'none', fontSize:13, fontWeight:700, fontFamily:FONT }}>⬇️ {t('unload')}</Link>
            <Link to="/payment" style={{ display:'flex', alignItems:'center', justifyContent:'center', gap:6, background:P, color:'#fff', borderRadius:10, padding:'12px', textDecoration:'none', fontSize:13, fontWeight:700, fontFamily:FONT }}>💸 {t('payment')}</Link>
            <Link to="/mes-cartes" style={{ display:'flex', alignItems:'center', justifyContent:'center', gap:6, background:BG, color:P, borderRadius:10, padding:'12px', textDecoration:'none', fontSize:13, fontWeight:700, fontFamily:FONT, border:`2px solid ${P}` }}>🔐 {lang==='fr'?'Tokeniser':'Tokenize'}</Link>
          </div>
        </div>
      )}

      {tab === 'history' && (
        <Box>
          <div style={{ fontSize:14, fontWeight:700, marginBottom:12, fontFamily:FONT }}>
            {lang==='fr'?'Historique transactionnel':'Transaction history'}
          </div>
          {txns.length === 0
            ? <div style={{ color:MUTED, textAlign:'center', padding:'24px 0', fontSize:13 }}>{t('noTxn')}</div>
            : txns.map(txn => <TxnRow key={txn.txn_id} txn={txn} t={t} lang={lang} />)
          }
          <Link to="/transactions" style={{ display:'block', textAlign:'center', color:P, marginTop:16, fontSize:13, fontWeight:600, textDecoration:'none' }}>
            {lang==='fr'?'Voir tout →':'View all →'}
          </Link>
        </Box>
      )}
    </div>
  );
};


const MyCards = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [cards, setCards]     = useState([]);
  const [loading, setLoading] = useState(true);
  const [showForm, setShowForm] = useState(false);

  const load = () => {
    setLoading(true);
    api.get('/cards').then(r=>setCards(r.data.data||[])).finally(()=>setLoading(false));
  };
  useEffect(()=>{ load(); },[]);

  const setDefault = async (enrollmentId) => {
    try { await api.patch(`/cards/${enrollmentId}/default`); toast.success(t('setDefault')+' ✓'); load(); }
    catch { toast.error(t('error')); }
  };

  const remove = async (enrollmentId) => {
    if (!window.confirm(t('confirmRemove'))) return;
    try { await api.delete(`/cards/${enrollmentId}`); toast.success('Carte supprimée'); load(); }
    catch (err) { toast.error(err.response?.data?.error || t('error')); }
  };

  return (
    <div>
      <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:20 }}>
        <h1 style={{ margin:0, fontSize:22, fontWeight:700 }}>💳 {t('myCards')}</h1>
        {!showForm && <Btn onClick={()=>setShowForm(true)} color={P}>+ {t('enrollCard')}</Btn>}
      </div>

      {/* Formulaire enrollment */}
      {showForm && (
        <Box style={{ maxWidth:480, marginBottom:20 }}>
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>🔐 {t('enrollCard')}</h3>
          <EnrollForm lang={lang} onSuccess={(card)=>{ setShowForm(false); load(); }} onCancel={()=>setShowForm(false)} />
        </Box>
      )}

      {/* Liste des cartes */}
      {loading ? <Spin /> : cards.length === 0 && !showForm ? (
        <Box style={{ textAlign:'center', padding:48 }}>
          <div style={{ fontSize:56, marginBottom:16 }}>💳</div>
          <div style={{ fontSize:16, fontWeight:600, color:TEXT, marginBottom:8, fontFamily:FONT }}>{t('noCards')}</div>
          <div style={{ fontSize:13, color:MUTED, marginBottom:20, fontFamily:FONT }}>{t('addFirstCard')}</div>
          <Btn onClick={()=>setShowForm(true)} color={P}>+ {t('enrollCard')}</Btn>
        </Box>
      ) : (
        <div style={{ display:'grid', gap:14 }}>
          {cards.map(card => (
            <div key={card.enrollmentId} style={{ background:card.network==='visa'?'linear-gradient(135deg,#1a1f71,#1d4f92)':card.network==='mastercard'?'linear-gradient(135deg,#eb001b,#f79e1b)':'linear-gradient(135deg,#1d4f92,#12b6c7)', borderRadius:16, padding:'22px 24px', color:'#fff', position:'relative', boxShadow:card.isDefault?`0 0 0 3px ${P}, 0 6px 20px rgba(0,0,0,0.2)`:'0 4px 16px rgba(0,0,0,0.15)' }}>
              {card.isDefault && (
                <div style={{ position:'absolute', top:14, right:14, background:'rgba(255,255,255,0.25)', borderRadius:20, padding:'3px 10px', fontSize:11, fontWeight:700, fontFamily:FONT }}>✓ {t('defaultCard')}</div>
              )}
              <div style={{ display:'flex', justifyContent:'space-between', marginBottom:14 }}>
                <span style={{ fontSize:11, opacity:0.8, fontFamily:FONT }}>Calculus Plus</span>
                <span style={{ fontSize:22 }}>{NETWORK_ICONS[card.network]}</span>
              </div>
              <div style={{ fontSize:20, letterSpacing:3, fontFamily:'monospace', marginBottom:14 }}>{card.cardMasked}</div>
              <div style={{ display:'flex', justifyContent:'space-between', alignItems:'flex-end' }}>
                <div>
                  <div style={{ fontSize:10, opacity:0.7, fontFamily:FONT }}>{lang==='fr'?'TITULAIRE':'CARDHOLDER'}</div>
                  <div style={{ fontSize:13, fontFamily:FONT }}>{card.cardholderName || '—'}</div>
                </div>
                <div style={{ textAlign:'right' }}>
                  <div style={{ fontSize:10, opacity:0.7, fontFamily:FONT }}>{lang==='fr'?'EXPIRATION':'EXPIRY'}</div>
                  <div style={{ fontSize:13, fontFamily:'monospace' }}>{String(card.expiryMonth).padStart(2,'0')}/{card.expiryYear}</div>
                </div>
              </div>
              {/* Actions */}
              <div style={{ display:'flex', gap:8, marginTop:16, paddingTop:14, borderTop:'1px solid rgba(255,255,255,0.2)' }}>
                {!card.isDefault && (
                  <button onClick={()=>setDefault(card.enrollmentId)} style={{ background:'rgba(255,255,255,0.2)', border:'none', color:'#fff', borderRadius:8, padding:'7px 14px', fontSize:12, fontWeight:600, cursor:'pointer', fontFamily:FONT }}>⭐ {t('setDefault')}</button>
                )}
                <button onClick={()=>remove(card.enrollmentId)} style={{ background:'rgba(255,50,50,0.25)', border:'none', color:'#fff', borderRadius:8, padding:'7px 14px', fontSize:12, fontWeight:600, cursor:'pointer', fontFamily:FONT, marginLeft:'auto' }}>🗑️ {t('removeCard')}</button>
              </div>
              {card.usageCount > 0 && (
                <div style={{ fontSize:10, opacity:0.6, marginTop:8, fontFamily:FONT }}>{lang==='fr'?`Utilisée ${card.usageCount} fois`:`Used ${card.usageCount} times`}</div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
};

// ─── PCI Security Banner ──────────────────────────────────────────
const PciSecurityBadge = () => (
  <div style={{ display:'flex', alignItems:'center', gap:6, background:'#1d4f9210', border:'1px solid #1d4f9230', borderRadius:8, padding:'6px 12px', marginBottom:12, fontSize:11, color:'#1d4f92', fontFamily:FONT }}>
    <span>🔒</span>
    <span><strong>PCI-DSS v4.0</strong> — Connexion sécurisée TLS 1.3 · Données chiffrées · Session 30 min</span>
  </div>
);

const PciSecurityEvents = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [events, setEvents] = useState([]);
  const [loading, setLoading] = useState(true);
  useEffect(() => {
    api.get('/security/events').then(r => setEvents(r.data.events||[])).finally(() => setLoading(false));
  }, []);
  const eventLabels = { AUTH_SUCCESS:'Connexion réussie', AUTH_FAILURE:'Échec connexion', AUTH_LOGOUT:'Déconnexion', PIN_CHANGE:'Modification PIN', PASSWORD_CHANGE:'Modification MDP', CARD_FREEZE:'Carte gelée', CARD_UNFREEZE:'Carte activée', PAYMENT_SUCCESS:'Paiement effectué', PAYMENT_FAILED:'Paiement refusé', TOPUP_SUCCESS:'Rechargement', UNLOAD_SUCCESS:'Transfert sortant', PROFILE_UPDATE:'Profil modifié', SESSION_EXPIRED:'Session expirée' };
  return (
    <div>
      <h3 style={{ margin:'0 0 14px', fontFamily:FONT, fontSize:15 }}>🔐 Activité récente du compte</h3>
      {loading ? <Spin /> : events.length === 0 ? <div style={{ color:MUTED, fontSize:13 }}>Aucun événement</div> : events.map((e, i) => (
        <div key={i} style={{ display:'flex', alignItems:'center', gap:10, padding:'8px 0', borderBottom:`1px solid ${BORDER}` }}>
          <span style={{ fontSize:16 }}>{e.success ? '✅' : '⚠️'}</span>
          <div style={{ flex:1 }}>
            <div style={{ fontSize:13, fontWeight:600, color:e.success?TEXT:DANGER }}>{eventLabels[e.event_type]||e.event_type}</div>
            <div style={{ fontSize:11, color:MUTED }}>{e.ip_address} · {new Date(e.created_at).toLocaleString(lang==='fr'?'fr-FR':'en-US')}</div>
          </div>
        </div>
      ))}
    </div>
  );
};


// ─── APP ──────────────────────────────────────────────────────────
export default function App() {
  const { lang, toggle } = useLang();
  return (
    <BrowserRouter>
      <Toaster position="top-right" toastOptions={{ style:{ fontFamily:FONT, fontSize:13 } }} />
      <Routes>
        <Route path="/login"    element={<Login    lang={lang} toggleLang={toggle} />} />
        <Route path="/register" element={<RegisterCardholder lang={lang} toggleLang={toggle} />} />
        <Route path="/*" element={
          <Guard>
            <Layout lang={lang} toggleLang={toggle}>
              <Routes>
                <Route path=""             element={<Dashboard   lang={lang} />} />
                <Route path="payment"      element={<Payment     lang={lang} />} />
                <Route path="topup"        element={<TopUp       lang={lang} />} />
                <Route path="unload"       element={<Unload      lang={lang} />} />
                <Route path="transactions" element={<Transactions lang={lang} />} />
                <Route path="gtp-card"     element={<GtpCardPage lang={lang} />} />
                <Route path="cards"        element={<MyCards     lang={lang} />} />
                <Route path="mes-cartes"   element={<CardsUnified lang={lang} />} />
                <Route path="ma-carte"     element={<CardsPage   lang={lang} />} />
                <Route path="transfer"     element={<Transfer    lang={lang} />} />
                <Route path="profile"      element={<Profile     lang={lang} />} />
              </Routes>
            </Layout>
          </Guard>
        } />
      </Routes>
    </BrowserRouter>
  );
}
