const useLang = () => {
  const [lang, setLang] = useState(localStorage.getItem('ch_lang') || 'fr');
  const toggle = () => { const n = lang === 'fr' ? 'en' : 'fr'; localStorage.setItem('ch_lang', n); setLang(n); };
  return { lang, toggle };
};

// ─── Styles ───────────────────────────────────────────────────────
const P = '#12b6c7', BG = '#f0f4f8', CARD = '#fff', BORDER = '#dce3ed', TEXT = '#1e2d3d', MUTED = '#5a6677';
const FONT = "'Century Gothic','CenturyGothic','AppleGothic','Gill Sans MT',Tahoma,Arial,sans-serif";
const DANGER = '#ff3b30', SUCCESS = '#00c896', WARNING = '#ff9500', BLUE = '#1d4f92';
const sc = s => ({ active:SUCCESS, frozen:WARNING, cancelled:DANGER, completed:SUCCESS, failed:DANGER, pending:WARNING, payment:DANGER, topup:SUCCESS, unload:WARNING, fee:MUTED }[s] || MUTED);

// ─── Composants ───────────────────────────────────────────────────
const Box = ({ children, style }) => <div style={{ background:CARD, border:`1px solid ${BORDER}`, borderRadius:14, padding:20, marginBottom:14, fontFamily:FONT, ...style }}>{children}</div>;
const Badge = ({ label, color=MUTED }) => <span style={{ display:'inline-block', padding:'2px 10px', borderRadius:20, fontSize:11, fontWeight:700, background:`${color}22`, color }}>{label}</span>;
const Spin  = () => <div style={{ textAlign:'center', padding:40, color:MUTED }}>⏳</div>;
const Btn   = ({ children, onClick, color=P, outline, small, disabled, style:s }) => (
  <button onClick={onClick} disabled={disabled} style={{ background:outline?'transparent':color, color:outline?color:'#fff', border:`2px solid ${color}`, borderRadius:10, padding:small?'6px 14px':'11px 20px', fontSize:small?12:14, fontWeight:700, cursor:disabled?'not-allowed':'pointer', opacity:disabled?0.55:1, fontFamily:FONT, ...s }}>{children}</button>
);
const Inp   = ({ label, value, onChange, type='text', placeholder, maxLength, pattern }) => (
  <div style={{ marginBottom:14 }}>
    {label && <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{label}</label>}
    <input type={type} value={value||''} onChange={e=>onChange(e.target.value)} placeholder={placeholder} maxLength={maxLength} pattern={pattern}
      style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', color:TEXT, fontSize:14, boxSizing:'border-box', fontFamily:FONT, outline:'none' }} />
  </div>
);
const Sel   = ({ label, value, onChange, options }) => (
  <div style={{ marginBottom:14 }}>
    {label && <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{label}</label>}
    <select value={value} onChange={e=>onChange(e.target.value)} style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', color:TEXT, fontSize:14, boxSizing:'border-box', fontFamily:FONT }}>
      {options.map(o => <option key={o.v} value={o.v}>{o.l}</option>)}
    </select>
  </div>
);
const Modal = ({ title, onClose, children }) => (
  <div style={{ position:'fixed', inset:0, background:'rgba(0,0,0,0.45)', display:'flex', alignItems:'center', justifyContent:'center', zIndex:1000 }}>
    <Box style={{ width:440, maxHeight:'90vh', overflowY:'auto', margin:0 }}>
      <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:18 }}>
        <span style={{ fontSize:17, fontWeight:700, fontFamily:FONT }}>{title}</span>
        <button onClick={onClose} style={{ background:'none', border:'none', fontSize:22, cursor:'pointer', color:MUTED }}>✕</button>
      </div>
      {children}
    </Box>
  </div>
);
const PinInput = ({ value, onChange, placeholder }) => (
  <input type="password" inputMode="numeric" maxLength={4} value={value} onChange={e=>onChange(e.target.value.replace(/\D/g,'').slice(0,4))} placeholder={placeholder||'••••'}
    style={{ width:'100%', background:BG, border:`2px solid ${BORDER}`, borderRadius:8, padding:'12px', fontSize:22, letterSpacing:8, textAlign:'center', color:TEXT, fontFamily:'monospace', boxSizing:'border-box' }} />
);
const fmtDate = (d, lang) => d ? new Date(d).toLocaleString(lang==='fr'?'fr-FR':'en-US') : '—';
const fmtNum  = n => parseFloat(n||0).toLocaleString('fr-FR');

const OPERATORS = [
  { v:'mtn', l:'MTN Mobile Money' }, { v:'orange', l:'Orange Money' },
  { v:'airtel', l:'Airtel Money' }, { v:'vodacom', l:'Vodacom M-Pesa' },
];

// ─── LAYOUT ───────────────────────────────────────────────────────
const Layout = ({ children, lang, toggleLang }) => {
  const { user } = useAuth();
  const navigate = useNavigate();
  const { pathname } = window.location;
  const nav = [
    { path:'/', icon:'💳', key:'dashboard' },
    { path:'/payment', icon:'💸', key:'payment' },
    { path:'/topup', icon:'⬆️', key:'topup' },
    { path:'/unload', icon:'⬇️', key:'unload' },
    { path:'/transactions', icon:'📋', key:'transactions' },
    { path:'/gtp-card', icon:'🌍', key:'gtpCard' },
    { path:'/cards', icon:'💳', key:'myCards' },
    { path:'/profile', icon:'👤', key:'profile' },
  ];
  const t = k => T[lang][k] || k;
  return (
    <div style={{ display:'flex', minHeight:'100vh', background:BG, fontFamily:FONT }}>
      {/* Sidebar */}
      <aside style={{ width:220, background:CARD, borderRight:`1px solid ${BORDER}`, display:'flex', flexDirection:'column', position:'fixed', top:0, bottom:0, left:0, zIndex:100 }}>
        <div style={{ padding:'16px 16px 12px', borderBottom:`1px solid ${BORDER}` }}>
          <img src="/logo-calculus.svg" alt="Calculus Plus" style={{ width:'100%', maxWidth:175, height:'auto', objectFit:'contain' }} />
          <div style={{ fontSize:10, color:MUTED, marginTop:4, fontFamily:FONT }}>Espace Cardholder</div>
        </div>
        <nav style={{ flex:1, padding:'10px 0', overflowY:'auto' }}>
          {nav.map(n => (
            <Link key={n.path} to={n.path} style={{ display:'flex', alignItems:'center', gap:10, padding:'11px 18px', color:pathname===n.path?P:MUTED, textDecoration:'none', fontSize:13, fontWeight:pathname===n.path?700:400, background:pathname===n.path?`${P}12`:'transparent', borderLeft:`3px solid ${pathname===n.path?P:'transparent'}` }}>
              <span>{n.icon}</span><span>{t(n.key)}</span>
            </Link>
          ))}
        </nav>
        <div style={{ padding:'12px 16px', borderTop:`1px solid ${BORDER}` }}>
          <button onClick={toggleLang} style={{ background:'none', border:`1px solid ${BORDER}`, color:TEXT, padding:'6px 10px', borderRadius:6, cursor:'pointer', fontSize:12, marginBottom:8, width:'100%', fontFamily:FONT }}>🌐 {t('language')}</button>
          <button onClick={() => { localStorage.removeItem('ch_token'); navigate('/login'); }} style={{ background:'none', border:`1px solid ${BORDER}`, color:MUTED, padding:'6px 10px', borderRadius:6, cursor:'pointer', fontSize:12, width:'100%', fontFamily:FONT }}>{t('logout')}</button>
        </div>
      </aside>
      <main style={{ marginLeft:220, flex:1, padding:28 }}>{children}</main>
      {activeTab === 'security' && (
        <Box style={{ maxWidth:560 }}>
          <PciSecurityBadge />
          <div style={{ background:`${BLUE}08`, border:`1px solid ${BLUE}25`, borderRadius:10, padding:14, marginBottom:16 }}>
            <div style={{ fontSize:13, fontWeight:700, color:BLUE, marginBottom:10, fontFamily:FONT }}>✅ Protections PCI-DSS v4.0 actives</div>
            {[
              ['REQ 2', 'Configuration sécurisée — Headers HTTP stricts, TLS 1.3 uniquement'],
              ['REQ 3', 'Protection données carte — PAN masqué, CVV jamais stocké en clair'],
              ['REQ 4', 'Chiffrement transit — HTTPS/TLS 1.3, HSTS activé'],
              ['REQ 6', 'Développement sécurisé — Validation inputs, protection XSS/injection'],
              ['REQ 7', 'Contrôle d\'accès — Authentification requise pour toutes les opérations'],
              ['REQ 8', 'Gestion sessions — Expiration 30 min, verrouillage après 5 tentatives'],
              ['REQ 10', 'Audit trail — Toutes les actions horodatées et tracées 12 mois'],
              ['REQ 11', 'Détection anomalies — Rate limiting, surveillance en temps réel'],
            ].map(([req, desc]) => (
              <div key={req} style={{ display:'flex', gap:10, padding:'6px 0', borderBottom:`1px solid ${BORDER}`, fontSize:12, fontFamily:FONT }}>
                <span style={{ background:`${BLUE}18`, color:BLUE, borderRadius:6, padding:'2px 8px', fontSize:10, fontWeight:700, flexShrink:0, alignSelf:'center' }}>{req}</span>
                <span style={{ color:TEXT }}>{desc}</span>
              </div>
            ))}
          </div>
          <PciSecurityEvents lang={lang} />
        </Box>
      )}
    </div>
  );
};

// ─── LOGIN ────────────────────────────────────────────────────────
const Login = ({ lang, toggleLang }) => {
  const t = k => T[lang][k] || k;
  const [creds, setCreds] = useState({ emailOrPhone:'', password:'' });
  const [loading, setLoading] = useState(false);
  const navigate = useNavigate();
  const { isAuth } = useAuth();
  useEffect(() => { if (isAuth) navigate('/'); }, [isAuth, navigate]);

  const submit = async () => {
    setLoading(true);
    try {
      const { data } = await api.post('/auth/login', creds);
      localStorage.setItem('ch_token', data.access_token);
      navigate('/');
    } catch { toast.error(t('loginError')); }
    finally { setLoading(false); }
  };

  return (
    <div style={{ minHeight:'100vh', background:BG, display:'flex', alignItems:'center', justifyContent:'center', fontFamily:FONT }}>
      <div style={{ width:400 }}>
        <div style={{ textAlign:'right', marginBottom:12 }}>
          <button onClick={toggleLang} style={{ background:'none', border:`1px solid ${BORDER}`, color:TEXT, padding:'5px 12px', borderRadius:20, cursor:'pointer', fontSize:12, fontFamily:FONT }}>🌐 {t('language')}</button>
        </div>
        <div style={{ textAlign:'center', marginBottom:24 }}>
          <img src="/logo-calculus.svg" alt="Calculus Plus" style={{ width:210, height:'auto', display:'block', margin:'0 auto 10px', objectFit:'contain' }} />
          <div style={{ color:MUTED, fontSize:13 }}>Espace Porteur de Carte</div>
        </div>
        <PciSecurityBadge />
        <Box>
          <Inp label={t('emailOrPhone')} value={creds.emailOrPhone} onChange={v=>setCreds(c=>({...c,emailOrPhone:v}))} placeholder="email@example.com" />
          <Inp label={t('password')} value={creds.password} onChange={v=>setCreds(c=>({...c,password:v}))} type="password" placeholder="••••••••" />
          <div style={{ fontSize:11, color:MUTED, marginBottom:12, fontFamily:FONT }}>
            🔒 {lang==='fr'?'Votre session sera verrouillée après 5 tentatives échouées':'Your account will be locked after 5 failed attempts'}
          </div>
          <Btn onClick={submit} disabled={loading} style={{ width:'100%', marginTop:4 }}>{loading?t('loggingIn'):t('login')}</Btn>
        </Box>
      </div>
    </div>
  );
};

// ─── DASHBOARD / MA CARTE ─────────────────────────────────────────
const Dashboard = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [dash, setDash]   = useState(null);
  const [loading, setLoading] = useState(true);
  const [freezing, setFreezing] = useState(false);

  const load = useCallback(() => {
    setLoading(true);
    api.get('/dashboard').then(r=>setDash(r.data)).catch(()=>toast.error(t('error'))).finally(()=>setLoading(false));
  }, []);
  useEffect(()=>{ load(); }, [load]);

  const toggleCard = async () => {
    const action = dash.card.status === 'active' ? 'freeze' : 'unfreeze';
    const confirm = window.confirm(t(action === 'freeze' ? 'freezeConfirm' : 'unfreezeConfirm'));
    if (!confirm) return;
    setFreezing(true);
    try {
      await api.patch('/card/status', { action });
      toast.success(action === 'freeze' ? '❄️ Carte gelée' : '✅ Carte activée');
      load();
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setFreezing(false); }
  };

  if (loading) return <Spin />;
  if (!dash) return <div style={{ color:MUTED, padding:40, textAlign:'center' }}>{t('error')}</div>;

  const { card, stats, recentTransactions } = dash;
  const isFrozen = card.status === 'frozen';

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>{t('dashboard')}</h1>

      {/* Carte virtuelle */}
      <div style={{ background:isFrozen ? `linear-gradient(135deg, ${MUTED}, #8a9ab0)` : `linear-gradient(135deg, ${BLUE}, ${P})`, borderRadius:20, padding:'28px 28px 24px', marginBottom:20, color:'#fff', position:'relative', overflow:'hidden', boxShadow:'0 8px 32px rgba(29,79,146,0.25)' }}>
        <div style={{ position:'absolute', top:-30, right:-30, width:160, height:160, borderRadius:'50%', background:'rgba(255,255,255,0.07)' }} />
        <div style={{ position:'absolute', bottom:-40, left:-20, width:200, height:200, borderRadius:'50%', background:'rgba(255,255,255,0.05)' }} />
        <div style={{ display:'flex', justifyContent:'space-between', alignItems:'flex-start', marginBottom:20 }}>
          <div>
            <div style={{ fontSize:11, opacity:0.75, letterSpacing:1, textTransform:'uppercase', fontFamily:FONT }}>Calculus Plus</div>
            <div style={{ fontSize:13, opacity:0.9, marginTop:4, fontFamily:FONT }}>{card.network?.toUpperCase() || 'VISA'}</div>
          </div>
          <div style={{ background:'rgba(255,255,255,0.15)', borderRadius:8, padding:'4px 12px', fontSize:12, fontWeight:700, fontFamily:FONT }}>{isFrozen ? t('cardFrozen') : t('cardActive')}</div>
        </div>
        <div style={{ fontSize:22, letterSpacing:4, fontFamily:'monospace', marginBottom:20 }}>{card.card_masked || '4242 **** **** 1234'}</div>
        <div style={{ display:'flex', justifyContent:'space-between', alignItems:'flex-end' }}>
          <div>
            <div style={{ fontSize:11, opacity:0.7, fontFamily:FONT }}>{t('cardBalance')}</div>
            <div style={{ fontSize:30, fontWeight:800, fontFamily:FONT }}>{fmtNum(card.balance)} <span style={{ fontSize:16, opacity:0.85 }}>{card.currency}</span></div>
          </div>
          <div style={{ textAlign:'right' }}>
            <div style={{ fontSize:11, opacity:0.7, fontFamily:FONT }}>{card.cardholder_name}</div>
            <div style={{ fontSize:13, opacity:0.9, fontFamily:FONT }}>{String(card.expiry_month).padStart(2,'0')}/{card.expiry_year}</div>
          </div>
        </div>
      </div>

      {/* Toggle carte */}
      <div style={{ display:'flex', gap:10, marginBottom:20 }}>
        <Btn onClick={toggleCard} disabled={freezing} color={isFrozen ? SUCCESS : WARNING} style={{ flex:1 }}>
          {isFrozen ? `✅ ${t('unfreeze')}` : `❄️ ${t('freeze')}`}
        </Btn>
        <Link to="/payment" style={{ flex:1, display:'block', background:P, color:'#fff', borderRadius:10, padding:'11px', textAlign:'center', textDecoration:'none', fontSize:14, fontWeight:700, fontFamily:FONT, border:`2px solid ${P}` }}>💸 {t('payment')}</Link>
        <Link to="/topup"   style={{ flex:1, display:'block', background:SUCCESS, color:'#fff', borderRadius:10, padding:'11px', textAlign:'center', textDecoration:'none', fontSize:14, fontWeight:700, fontFamily:FONT, border:`2px solid ${SUCCESS}` }}>⬆️ {t('topup')}</Link>
      </div>

      {/* Stats du mois */}
      <div style={{ display:'grid', gridTemplateColumns:'repeat(3,1fr)', gap:12, marginBottom:20 }}>
        {[[t('monthSpent'), fmtNum(stats.monthSpent), DANGER],[t('monthTopup'), fmtNum(stats.monthTopup), SUCCESS],[t('monthCount'), stats.monthCount, P]].map(([l,v,c]) => (
          <Box key={l} style={{ padding:16, marginBottom:0 }}>
            <div style={{ fontSize:11, color:MUTED, marginBottom:4 }}>{l}</div>
            <div style={{ fontSize:20, fontWeight:700, color:c }}>{v}</div>
          </Box>
        ))}
      </div>

      {/* Transactions récentes */}
      <Box>
        <div style={{ display:'flex', justifyContent:'space-between', alignItems:'center', marginBottom:14 }}>
          <span style={{ fontSize:15, fontWeight:700 }}>{t('recentTxn')}</span>
          <Link to="/transactions" style={{ color:P, fontSize:12, textDecoration:'none', fontWeight:600 }}>Tout voir →</Link>
        </div>
        {recentTransactions.length === 0
          ? <div style={{ color:MUTED, fontSize:13, textAlign:'center', padding:'16px 0' }}>{t('noTxn')}</div>
          : recentTransactions.map(txn => <TxnRow key={txn.txn_id} txn={txn} t={t} lang={lang} />)}
      </Box>
    </div>
  );
};

// ─── PAIEMENT MERCHANT ────────────────────────────────────────────
const Payment = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [form, setForm]     = useState({ merchantId:'', amount:'', description:'', pin:'' });
  const [useToken, setUseToken] = useState(false);
  const [cards, setCards]     = useState([]);
  const [selectedToken, setToken] = useState('');
  useEffect(() => {
    api.get('/cards').then(r => {
      const active = r.data.data || [];
      setCards(active);
      if (active.length > 0) {
        setUseToken(true);
        const def = active.find(c => c.isDefault) || active[0];
        setToken(def.tokenId);
      }
    }).catch(() => {});
  }, []);
  const [loading, setLoading] = useState(false);
  const [result, setResult]   = useState(null);
  const f = k => v => setForm(p=>({...p,[k]:v}));

  const submit = async () => {
    if (!form.amount || parseFloat(form.amount) <= 0) return toast.error(t('amount'));
    if (!form.pin || form.pin.length !== 4) return toast.error(t('pinInvalid'));
    setLoading(true);
    try {
      const endpoint = useToken && selectedToken ? '/payment/tokenized' : '/payment';
      const payload  = useToken && selectedToken
        ? { tokenId: selectedToken, merchantId: form.merchantId||undefined, amount: parseFloat(form.amount), description: form.description||undefined, pin: form.pin }
        : { merchantId: form.merchantId||undefined, amount: parseFloat(form.amount), description: form.description||undefined, pin: form.pin };
      const { data } = await api.post(endpoint, payload);
      setResult(data);
      toast.success(t('paySuccess'));
    } catch (err) { toast.error(err.response?.data?.error || t('payFailed')); }
    finally { setLoading(false); }
  };

  const reset = () => { setResult(null); setForm({ merchantId:'', amount:'', description:'', pin:'' }); };

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>💸 {t('payment')}</h1>
      {!result ? (
        <Box style={{ maxWidth:480 }}>
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>{t('payMerchant')}</h3>
          <Inp label={t('merchantId')} value={form.merchantId} onChange={f('merchantId')} placeholder="ID du marchand" />
          <Inp label={`${t('amount')} *`} value={form.amount} onChange={f('amount')} type="number" placeholder="5000" />
          <Inp label={t('description')} value={form.description} onChange={f('description')} placeholder="Ex: Achat en magasin" />
          <div style={{ marginBottom:14 }}>
            {/* Sélecteur de carte enrollée */}
            {cards.length > 0 && (
              <div style={{ marginBottom:16 }}>
                <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:6, fontFamily:FONT }}>
                  {lang==='fr'?'Payer avec':'Pay with'}
                </label>
                <div style={{ display:'flex', gap:8, marginBottom:10 }}>
                  <button onClick={()=>setUseToken(true)}  style={{ flex:1, padding:'9px', borderRadius:8, border:`2px solid ${useToken?P:BORDER}`, background:useToken?`${P}12`:CARD, color:useToken?P:MUTED, cursor:'pointer', fontSize:12, fontWeight:useToken?700:400, fontFamily:FONT }}>💳 Carte enregistrée</button>
                  <button onClick={()=>setUseToken(false)} style={{ flex:1, padding:'9px', borderRadius:8, border:`2px solid ${!useToken?P:BORDER}`, background:!useToken?`${P}12`:CARD, color:!useToken?P:MUTED, cursor:'pointer', fontSize:12, fontWeight:!useToken?700:400, fontFamily:FONT }}>💸 Carte virtuelle</button>
                </div>
                {useToken && (
                  <select value={selectedToken} onChange={e=>setToken(e.target.value)}
                    style={{ width:'100%', background:BG, border:`1px solid ${BORDER}`, borderRadius:8, padding:'10px 12px', fontSize:13, color:TEXT, fontFamily:FONT }}>
                    {cards.map(c => <option key={c.tokenId} value={c.tokenId}>{NETWORK_ICONS[c.network]||'💳'} {c.cardMasked} {c.isDefault?'★':''}</option>)}
                  </select>
                )}
              </div>
            )}
            <label style={{ display:'block', fontSize:12, color:MUTED, marginBottom:4, fontFamily:FONT }}>{t('pin')} *</label>
            <PinInput value={form.pin} onChange={v=>setForm(p=>({...p,pin:v}))} />
          </div>
          <div style={{ background:`${WARNING}12`, border:`1px solid ${WARNING}40`, borderRadius:8, padding:12, marginBottom:16, fontSize:12, color:TEXT }}>
            ⚠️ {lang==='fr' ? 'Frais de transaction : 0.5% du montant' : 'Transaction fee: 0.5% of amount'}
          </div>
          <Btn onClick={submit} disabled={loading} style={{ width:'100%' }}>{loading ? t('paying') : t('confirmPay')}</Btn>
        </Box>
      ) : (
        <Box style={{ maxWidth:480, textAlign:'center' }}>
          <div style={{ fontSize:56, marginBottom:12 }}>✅</div>
          <div style={{ fontSize:20, fontWeight:700, color:SUCCESS, marginBottom:8, fontFamily:FONT }}>{t('paySuccess')}</div>
          <div style={{ fontSize:32, fontWeight:800, color:TEXT, marginBottom:4, fontFamily:FONT }}>{fmtNum(result.txn?.amount)} {result.txn?.currency}</div>
          {result.txn?.merchant_name && <div style={{ fontSize:13, color:MUTED, marginBottom:4 }}>→ {result.txn.merchant_name}</div>}
          {result.authCode && <div style={{ fontSize:12, color:MUTED, fontFamily:'monospace', marginBottom:4 }}>Auth: {result.authCode}</div>}
          <div style={{ fontSize:14, color:P, fontWeight:700, marginBottom:20 }}>{t('newBalance')} : {fmtNum(result.newBalance)} XAF</div>
          <Btn onClick={reset} color={P}>{t('payment')} +</Btn>
        </Box>
      )}
    </div>
  );
};

// ─── TOP-UP ───────────────────────────────────────────────────────
const TopUp = ({ lang }) => {
  const t = k => T[lang][k] || k;
  const [form, setForm]   = useState({ amount:'', operator:'mtn', phone:'' });
  const [loading, setLoading] = useState(false);
  const [result, setResult]   = useState(null);
  const f = k => v => setForm(p=>({...p,[k]:v}));

  const submit = async () => {
    if (!form.amount || parseFloat(form.amount) < 500) return toast.error('Montant minimum 500');
    if (!form.phone) return toast.error(t('mmPhone'));
    setLoading(true);
    try {
      const { data } = await api.post('/topup', { amount: parseFloat(form.amount), operator: form.operator, phone: form.phone });
      setResult(data);
      toast.success(t('topupSuccess'));
    } catch (err) { toast.error(err.response?.data?.error || t('error')); }
    finally { setLoading(false); }
  };

  const reset = () => { setResult(null); setForm({ amount:'', operator:'mtn', phone:'' }); };

  return (
    <div>
      <h1 style={{ margin:'0 0 20px', fontSize:22, fontWeight:700 }}>⬆️ {t('topup')}</h1>
      {!result ? (
        <Box style={{ maxWidth:480 }}>
          <h3 style={{ margin:'0 0 16px', fontFamily:FONT }}>{t('topupTitle')}</h3>
          <Inp label={`${t('amount')} * (min. 500 XAF)`} value={form.amount} onChange={f('amount')} type="number" placeholder="10000" />
          <Sel label={t('operator')} value={form.operator} onChange={f('operator')} options={OPERATORS} />
          <Inp label={`${t('mmPhone')} *`} value={form.phone} onChange={f('phone')} placeholder="+237XXXXXXXXX" />
          {form.amount && parseFloat(form.amount) >= 500 && (
            <div style={{ background:`${SUCCESS}10`, border:`1px solid ${SUCCESS}40`, borderRadius:8, padding:12, marginBottom:16, fontSize:12, color:TEXT }}>
              💰 {lang==='fr' ? 'Vous recevrez' : 'You will receive'} : <strong>{fmtNum(Math.round(parseFloat(form.amount) * 0.99))} XAF</strong>
              {' '}({t('fee')} : {fmtNum(Math.round(parseFloat(form.amount) * 0.01))} XAF, 1%)
            </div>
          )}
          <Btn onClick={submit} disabled={loading} color={SUCCESS} style={{ width:'100%' }}>{loading ? t('toppingUp') : t('topupBtn')}</Btn>
        </Box>
      ) : (
        <Box style={{ maxWidth:480, textAlign:'center' }}>
          <div style={{ fontSize:56, marginBottom:12 }}>💳</div>
          <div style={{ fontSize:20, fontWeight:700, color:SUCCESS, marginBottom:8 }}>{t('topupSuccess')}</div>
          <div style={{ fontSize:32, fontWeight:800, color:TEXT, marginBottom:4 }}>+{fmtNum(result.credited)} XAF</div>
          <div style={{ fontSize:12, color:MUTED, marginBottom:4 }}>Réf: {result.mmReference}</div>
          <div style={{ fontSize:14, color:P, fontWeight:700, marginBottom:20 }}>{t('newBalance')} : {fmtNum(result.newBalance)} XAF</div>
          <Btn onClick={reset} color={SUCCESS}>{t('topup')} +</Btn>
        </Box>
      )}
    </div>
  );
};

