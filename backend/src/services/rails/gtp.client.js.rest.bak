// backend/src/services/rails/gtp.client.js
// ================================================================
// CPlus 2.6 — GTP (Global Transaction Processing) HTTP Client
// Région : CEMAC (XAF) — Cameroun, Congo, Gabon, RCA, Tchad, Guinée Éq.
// Réseau : GIMAC (Groupement Interbancaire Monétique d'Afrique Centrale)
//
// Authentification : HMAC-SHA256 + Basic Auth + mTLS optionnel
// Format messages : ISO 8583 encapsulé JSON (GTP REST API v2)
// ================================================================

'use strict';

const crypto  = require('crypto');
const https   = require('https');
const http    = require('http');
const fs      = require('fs');
const { v4: uuidv4 } = require('uuid');

// ─── Config ──────────────────────────────────────────────────────
const getConfig = () => ({
  baseUrl:       process.env.GTP_API_BASE_URL || 'https://sandbox.gtpapi.net/api/v2',
  apiKey:        process.env.GTP_API_KEY,
  apiSecret:     process.env.GTP_API_SECRET,
  institutionId: process.env.GTP_INSTITUTION_ID,    // ID de l'institution CPlus chez GTP
  binPrefix:     process.env.GTP_BIN_PREFIX,         // 6 premiers chiffres du BIN dédié
  currency:      process.env.GTP_CURRENCY || '950',  // 950 = XAF ISO 4217 numérique
  countryCode:   process.env.GTP_COUNTRY_CODE || '120', // 120 = Cameroun ISO 3166-1 numérique
  terminalId:    process.env.GTP_TERMINAL_ID || 'CPLUS001',
  certPath:      process.env.GTP_CERT_PATH,          // mTLS client cert (optionnel)
  keyPath:       process.env.GTP_KEY_PATH,
  caPath:        process.env.GTP_CA_PATH,
  timeout:       parseInt(process.env.GTP_TIMEOUT_MS || '30000'),
  sandbox:       process.env.GTP_SANDBOX !== 'false',
});

// ─── Signature HMAC-SHA256 ───────────────────────────────────────
// GTP utilise : HMAC-SHA256(timestamp + nonce + body, api_secret)
const buildSignature = (body, apiSecret) => {
  const timestamp = Math.floor(Date.now() / 1000).toString();
  const nonce     = crypto.randomBytes(16).toString('hex');
  const payload   = `${timestamp}${nonce}${typeof body === 'string' ? body : JSON.stringify(body || '')}`;
  const signature = crypto.createHmac('sha256', apiSecret).update(payload).digest('hex');
  return { timestamp, nonce, signature };
};

// ─── Stan / RRN ──────────────────────────────────────────────────
const stan = () => String(Math.floor(Math.random() * 999999)).padStart(6, '0');
const rrn  = () => {
  const now = new Date();
  const yy  = String(now.getFullYear()).slice(-2);
  const ddd = String(Math.floor((now - new Date(now.getFullYear(), 0, 0)) / 86400000)).padStart(3, '0');
  const hhmm= `${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}`;
  return `${yy}${ddd}${hhmm}${stan()}`.slice(0, 12);
};
const localDateTime = () => {
  const now = new Date();
  return `${now.getFullYear()}${String(now.getMonth()+1).padStart(2,'0')}${String(now.getDate()).padStart(2,'0')}` +
         `${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}${String(now.getSeconds()).padStart(2,'0')}`;
};

// ─── Client HTTP ─────────────────────────────────────────────────
const request = async ({ method = 'POST', path, body = null }) => {
  const cfg = getConfig();
  if (!cfg.apiKey || !cfg.apiSecret) throw new Error('GTP_API_KEY et GTP_API_SECRET requis');

  const bodyStr = body ? JSON.stringify(body) : '';
  const { timestamp, nonce, signature } = buildSignature(bodyStr, cfg.apiSecret);

  const headers = {
    'Content-Type':     'application/json',
    'Accept':           'application/json',
    'X-Api-Key':        cfg.apiKey,
    'X-Timestamp':      timestamp,
    'X-Nonce':          nonce,
    'X-Signature':      signature,
    'X-Institution-Id': cfg.institutionId,
    'X-Request-Id':     uuidv4(),
    'Authorization':    'Basic ' + Buffer.from(`${cfg.apiKey}:${cfg.apiSecret}`).toString('base64'),
  };

  const url  = new URL(path, cfg.baseUrl);
  const isHttps = url.protocol === 'https:';

  // mTLS si certificats configurés
  const agentOpts = { keepAlive: true };
  if (isHttps && cfg.certPath && fs.existsSync(cfg.certPath)) {
    agentOpts.cert = fs.readFileSync(cfg.certPath);
    agentOpts.key  = fs.readFileSync(cfg.keyPath);
    if (cfg.caPath && fs.existsSync(cfg.caPath)) agentOpts.ca = fs.readFileSync(cfg.caPath);
  }
  if (cfg.sandbox) agentOpts.rejectUnauthorized = false; // Sandbox uniquement

  const transport = isHttps ? https : http;
  const agent = new transport.Agent(agentOpts);

  return new Promise((resolve, reject) => {
    const opts = {
      hostname: url.hostname,
      port:     url.port || (isHttps ? 443 : 80),
      path:     url.pathname + url.search,
      method,
      headers,
      agent,
      timeout: cfg.timeout,
    };

    const req = transport.request(opts, (res) => {
      let data = '';
      res.on('data', chunk => data += chunk);
      res.on('end', () => {
        try {
          const parsed = JSON.parse(data);
          if (res.statusCode >= 400) {
            const err = new Error(parsed.message || parsed.error || `GTP error ${res.statusCode}`);
            err.statusCode  = res.statusCode;
            err.gtpCode     = parsed.responseCode || parsed.code;
            err.gtpResponse = parsed;
            return reject(err);
          }
          resolve({ status: res.statusCode, data: parsed });
        } catch {
          const err = new Error(`GTP réponse non-JSON: ${data.slice(0, 200)}`);
          err.statusCode = res.statusCode;
          reject(err);
        }
      });
    });

    req.on('error', reject);
    req.on('timeout', () => { req.destroy(); reject(new Error('GTP timeout')); });
    if (bodyStr) req.write(bodyStr);
    req.end();
  });
};

module.exports = { request, getConfig, stan, rrn, localDateTime };
