// ─────────────────────────────────────────────────────────────────
//  Settlement temps réel — CR #3
//  Après un encaissement confirmé (authorized), reverse au marchand
//  le montant net (montant - commission) sur son wallet Mobile Money.
//  Débit compte central CPay → crédit wallet marchand.
//  Idempotent via transactions.settlement_status.
// ─────────────────────────────────────────────────────────────────
const { query } = require('../config/database');
const logger = require('../config/logger');

// Verse via le rail du bon opérateur
async function payout({ operator, amount, phone, description, externalId }) {
  if (operator === 'mtn') {
    const mtn = require('./rails/mtn-momo.client');
    const r = await mtn.transfer({ amount, phone, description, externalId });
    return { ref: r.referenceId || externalId, raw: r };
  }
  if (operator === 'airtel') {
    const airtel = require('./mobilemoney/providers/airtel.provider');
    const cfg = {
      baseUrl:      process.env.AIRTEL_CG_BASE_URL,
      clientId:     process.env.AIRTEL_CG_DISB_CLIENT_ID,
      clientSecret: process.env.AIRTEL_CG_DISB_CLIENT_SECRET,
      env:          process.env.AIRTEL_CG_ENV,
    };
    const r = await airtel.sendPayout({ txnId: externalId, amount, currency: 'XAF', phone, config: cfg });
    if (!r.success) throw new Error(r.errorMessage || 'Airtel payout failed');
    return { ref: r.transactionId || externalId, raw: r };
  }
  throw new Error('Opérateur de settlement non supporté: ' + operator);
}

// Choix du wallet marchand + routage opérateur
function routeSettlement(merchant, collectOperator) {
  // Priorité : même opérateur que l'encaissement
  if (collectOperator === 'mtn' && merchant.wallet_mtn)
    return { operator: 'mtn', wallet: merchant.wallet_mtn, crossOperator: false };
  if (collectOperator === 'airtel' && merchant.wallet_airtel)
    return { operator: 'airtel', wallet: merchant.wallet_airtel, crossOperator: false };
  // Secours cross-operator : le marchand n'a que l'autre wallet
  if (merchant.wallet_mtn)
    return { operator: 'mtn', wallet: merchant.wallet_mtn, crossOperator: true };
  if (merchant.wallet_airtel)
    return { operator: 'airtel', wallet: merchant.wallet_airtel, crossOperator: true };
  return null; // aucun wallet configuré
}

async function settleTransaction(txnId) {
  // 1. Charger + verrou d'idempotence
  const r = await query(
    `SELECT t.transaction_id, t.amount, t.detected_operator, t.settlement_status,
            t.merchant_id, m.wallet_mtn, m.wallet_airtel, m.commission_rate, m.business_name
     FROM transactions t JOIN merchants m ON t.merchant_id = m.merchant_id
     WHERE t.transaction_id = $1`, [txnId]);
  if (!r.rows.length) { logger.warn('Settlement: txn introuvable', { txnId }); return; }
  const t = r.rows[0];

  // Idempotence : 'regle' bloque definitivement ; 'en_cours' evite le double-envoi ;
  // 'echec' et 'non_regle' peuvent etre (re)tentes.
  if (t.settlement_status === 'regle' || t.settlement_status === 'en_cours') {
    logger.info('Settlement déjà traité', { txnId, statut: t.settlement_status });
    return;
  }

  // 2. Routage
  const route = routeSettlement(t, t.detected_operator);
  if (!route) {
    await query(`UPDATE transactions SET settlement_status='echec',
                 response_message='Aucun wallet marchand configuré' WHERE transaction_id=$1`, [txnId]);
    logger.warn('Settlement: aucun wallet marchand', { txnId, merchant: t.business_name });
    return;
  }

  // 3. Calcul du net
  const rate = parseFloat(t.commission_rate ?? 0.02);
  const gross = parseFloat(t.amount);
  const net = Math.round(gross * (1 - rate));
  const externalId = 'STL-' + txnId.slice(0, 8) + '-' + Date.now().toString(36);

  // 4. Marquer en_cours (verrou)
  await query(`UPDATE transactions SET settlement_status='en_cours' WHERE transaction_id=$1`, [txnId]);

  // 5. Verser
  try {
    const res = await payout({
      operator: route.operator, amount: net, phone: route.wallet,
      description: 'Reglement CPay ' + (t.business_name || ''), externalId,
    });
    await query(
      `UPDATE transactions SET settlement_status='regle', settled_at=NOW(), settlement_ref=$1
       WHERE transaction_id=$2`, [String(res.ref).slice(0, 80), txnId]);
    logger.info('Settlement OK', { txnId, net, operator: route.operator, cross: route.crossOperator });
    return { ok: true, net, ref: res.ref };
  } catch (e) {
    await query(
      `UPDATE transactions SET settlement_status='echec', settlement_ref=$1
       WHERE transaction_id=$2`, [('ERR: ' + e.message).slice(0, 80), txnId]);
    logger.error('Settlement échec', { txnId, err: e.message });
    return { ok: false, error: e.message };
  }
}

module.exports = { settleTransaction, routeSettlement };
