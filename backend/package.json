    "migrate": "node src/config/migrate.js",
    "check:prod": "node scripts/check-production-env.js",
    "check:pilot": "node scripts/check-pilot-readiness.js",
    "create:first-admin": "node scripts/create-first-admin.js",
    "check:financial": "node scripts/check-financial-integrity.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "smpp": "^0.5.0",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
