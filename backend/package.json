{
  "name": "cplus-2-6-backend",
  "version": "2.7.0",
  "description": "C-Pay - Payment Orchestration Hub (production OVH)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
