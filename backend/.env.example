# ================================================================
# C-Pay — backend/.env.example (lot 7, audit 2026-11-02 infra P2-13)
# Copier en backend/.env (jamais versionne : .gitignore) puis remplacer CHAQUE valeur « change_me… ».
# Les valeurs commencant par change_me / changeme / REQUIRED / your_ sont detectees comme manquantes par
# src/config/env.js : en production l'API refuse de demarrer tant qu'il en reste une parmi les obligatoires.
# Generer un secret : openssl rand -hex 32   (CONFIG_ENCRYPTION_KEY : exactement 64 caracteres hexadecimaux)
# Controle complet avant mise en production : cd backend && npm run check:prod
# ================================================================

# ─── Obligatoires en production (src/config/env.js : requiredInProduction) ───
NODE_ENV=production
PORT=3000

# PostgreSQL (OVH Cloud DB : hote/port du manager, utilisateur dedie ; TLS verifie — DB_SSL=true + CA)
DB_HOST=change_me.database.cloud.ovh.net
DB_PORT=20184
DB_NAME=cplus_db
DB_USER=cplus_user
DB_PASSWORD=change_me
DB_SSL=true
# DB_SSL_CA_FILE=/etc/cplus/ovh-ca.pem      # export « certificat CA » du manager OVH (sinon magasin systeme)
# DB_SSL_SERVERNAME=                        # si DB_HOST est une IP / un alias
# DB_APPLICATION_NAME=cpay-api

# Jetons et cles (openssl rand -hex 32 ; JWT_SECRET >= 32 caracteres)
JWT_SECRET=change_me_______________________________________________
INTERNAL_TOKEN=change_me                    # routes /internal/* (settlement-cron) — bloquees publiquement par nginx
METRICS_TOKEN=change_me                     # /metrics (Prometheus) ; fail-closed si absent
CONFIG_ENCRYPTION_KEY=change_me             # AES-256-GCM des api_configs (64 hex)
WEBHOOK_PATH_SECRET=change_me               # segment secret des URLs de callback /api/v1/webhooks/<secret>/<provider>

# URLs publiques et CORS
API_BASE_URL=https://api.c-pay.global
PAY_LINK_BASE_URL=https://pay.c-pay.global
ALLOWED_ORIGINS=https://admin.c-pay.global,https://merchant.c-pay.global,https://app.c-pay.global,https://card.c-pay.global,https://partners.c-pay.global,https://c-pay.global
# APP_URL_MERCHANT=https://merchant.c-pay.global
# APP_URL_CARDHOLDER=https://card.c-pay.global
# APP_URL_PARTNERS=https://partners.c-pay.global

# Supervision et TLS (lus par docker/docker-compose.yml et monitoring/)
GRAFANA_PASSWORD=change_me
CERTBOT_EMAIL=ops@c-pay.global

# ─── Pilote Congo-Brazzaville : Mobile Money ───────────────────────────────
# MTN MoMo (docs/GO-LIVE-CG.md) — MTN n'envoie aucun en-tete personnalise : le jeton du callback va dans l'URL
MTN_ENV=production                          # sandbox | production
MTN_CG_COLL_API_USER=change_me
MTN_CG_COLL_API_KEY=change_me
MTN_CG_COLL_SUB_KEY_PRIMARY=change_me
MTN_CG_DISB_API_USER=change_me
MTN_CG_DISB_API_KEY=change_me
MTN_CG_DISB_SUB_KEY_PRIMARY=change_me
MTN_WEBHOOK_TOKEN=change_me                 # obligatoire en production (POST/PUT /webhooks/mtn repond 503 sans lui)
MTN_CG_CALLBACK_URL=https://api.c-pay.global/api/v1/webhooks/mtn?token=change_me
# MTN_CG_TIMEOUT_MS=15000
# Airtel Money
AIRTEL_CG_ENV=production
AIRTEL_CG_BASE_URL=https://openapi.airtel.africa
AIRTEL_CG_COLL_CLIENT_ID=change_me
AIRTEL_CG_COLL_CLIENT_SECRET=change_me
AIRTEL_CG_DISB_CLIENT_ID=change_me
AIRTEL_CG_DISB_CLIENT_SECRET=change_me
AIRTEL_CG_WEBHOOK_SECRET=change_me

# ─── Registre des capacites pays (docs/WAVE-6-LOT2.md) ───────────────────────
CAPABILITY_ENFORCE=enforce                  # enforce | report | off
CAPABILITY_PILOT_CG=true                    # ouverture restreinte (statut pilot) du Congo-Brazzaville
# CAPABILITY_LEGACY_ALLOW=true
# CAPABILITY_REGISTRATION_GUARD=on

# ─── Caisse marchande (docs/CAISSE-API.md) ────────────────────────────────────
# CASH_WITHDRAW_DAILY_L0=100000
# CASH_WITHDRAW_DAILY_L1=500000
# CASH_WITHDRAW_DAILY_L2=2000000
# CASH_UNKNOWN_GRACE_MINUTES=10
# CASH_UNKNOWN_ALERT_HOURS=2
# IDEMPOTENCY_TTL_HOURS=24
# ACCOUNT_DELETION_RETRACT_DAYS=30
RECONCILE_ENABLED=true
# RECONCILE_INTERVAL_SECONDS=300

# ─── Notifications (recommande : alertes d'exploitation et e-mails marchands) ─
SMTP_HOST=change_me
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASS=change_me
SMTP_FROM="C-Pay <no-reply@c-pay.global>"
ADMIN_ALERT_EMAIL=ops@c-pay.global
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# SMPP_HOST= / SMPP_PORT= / SMPP_SYSTEM_ID= / SMPP_PASSWORD= / SMPP_SOURCE_ADDR=

# ─── Journalisation, session, antifraude ──────────────────────────────────────
LOG_LEVEL=info
# JWT_ISSUER=c-pay.global
# JWT_AUDIENCE=c-pay-api
# JWT_REFRESH_TTL_DAYS=30
# JWT_REFRESH_TTL_DAYS_ADMIN=7
# COOKIE_SECURE=true
# FRAUD_DEGRADED_MODE=block                 # comportement si le moteur antifraude est indisponible
# FRAUD_DEGRADED_MAX_AMOUNT=50000
# PILOT_CONTROL_MODE=enforce

# ─── Passerelles carte et autres operateurs (hors perimetre du pilote : laisser vide) ─
# MIGS_MERCHANT_ID= / MIGS_ACCESS_CODE= / MIGS_SECURE_HASH=
# MPGS_MERCHANT_ID= / MPGS_API_PASSWORD=
# CS_MERCHANT_ID= / CS_API_KEY_ID= / CS_SECRET_KEY=
# VISA_BASE_URL= / VISA_USER_ID= / VISA_PASSWORD=
# MASTERCARD_DEVELOPERS_CONSUMER_KEY= / MASTERCARD_DEVELOPERS_PRIVATE_KEY_PATH=
# PAYMENTHUB_BASE_URL= / PAYMENTHUB_WEBHOOK_TOKEN=
# INTERSWITCH_AUTH_BASE_URL= / INTERSWITCH_WALLET_BASE_URL=
# WAVE_WEBHOOK_SECRET= / AFRICELL_WEBHOOK_TOKEN= / ORANGE_SN_API_KEY= / MTN_CM_API_KEY=
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=                         # assistant de la vitrine (facultatif)
